; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Skill Tree of Life"
run/main_scene="uid://ch0s7sw18mc23"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SceneTransition="*res://autoload/scene_transition.tscn"
SceneLoader="*res://autoload/scene_loader.tscn"
Boot="uid://g7udw4thdrta"
Events="*res://autoload/events.gd"
StatRegistry="*res://autoload/stat_registry.gd"
DebugClipboard="*res://autoload/debug_clipboard.gd"

[debug]

settings/stdout/print_fps=true

[display]

window/size/viewport_width=1440
window/size/viewport_height=960
window/stretch/mode="canvas_items"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg", "res://addons/procgen_preview/plugin.cfg", "res://addons/sandbox_host/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "orange",
"res://assets/": "gray",
"res://attack/": "red",
"res://autoload/": "purple",
"res://docs/": "gray",
"res://entity/": "red",
"res://graph/": "teal",
"res://procgen/": "orange",
"res://scenes/": "green",
"res://skill_node/": "teal",
"res://stats_system/": "purple",
"res://systems/": "yellow",
"res://tools/": "orange",
"res://ui/": "green"
}


[resource]
script = ExtResource("1_scout_status")
id = &"scout"
display_name = "Scouted"
identity = ExtResource("identity_scout")
description = "Scout arrows lit up this node's surroundings for their camp: the disc grows with the root of the stacks, only your own camp's stacks count, and one stack fades each turn."
tags = Array[StringName]([&"vision"])
power_max = 0.0
decay = SubResource("Resource_decay")
display_max = 8.0
reapply = 1
on_dealloc = 1
group_by = "camp_id"
visible_if = "camp_id == viewer_camp_id"

[gd_resource type="Resource" script_class="CurseStatus" format=3]

[ext_resource type="Script" path="res://effects/status/curse.gd" id="1_curse"]

[resource]
script = ExtResource("1_curse")
id = &"curse"
display_name = "Curse"
description = "Every stack raises the least damage a hit can deal to this node by 1; stacks fall by 1 each turn and never cap."
tint = Color(0.85, 0.2, 0.55, 1)
tags = Array[StringName]([&"debuff"])
potency_stat_id = &"curse_potency"
resistance_stat_id = &"curse_resistance"
extra_stacks_stat_ids = Array[StringName]([&"curse_stacks_per_hit", &"dot_stacks_per_hit"])
power_max = 0.0
decay_mode = 0
decay_per_tick = 1.0
display_max = 10.0
reapply = 1
cure_per_hp = 0.25

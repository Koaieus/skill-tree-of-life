#!/usr/bin/env python3
#MISE description="Self-test for test's class-cache drift predicate: fixture tree + cfg in a tempdir, thirteen cases. `mise run test-selftest`"
"""
Exercises `class_cache_drift(root)` from .mise/tasks/test against a synthetic
project tree — never the real one, so it runs in <0.1s and never touches
.godot/. Cases: current cache, missing cache, a new class_name, a cached class
whose file is gone, ignored dirs (.gdignore / hidden / .worktrees), and the
one-line `class_name X extends Y` form.
"""
import importlib.machinery, importlib.util, os, shutil, tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
spec = importlib.util.spec_from_loader(
    "test_task", importlib.machinery.SourceFileLoader("test_task", os.path.join(HERE, "test")))
t = importlib.util.module_from_spec(spec); spec.loader.exec_module(t)


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as fh:
        fh.write(text)


def cfg(root, pairs):
    entries = "".join(
        '{\n"base": &"RefCounted",\n"class": &"%s",\n"icon": "",\n"is_abstract": false,\n'
        '"is_tool": false,\n"language": &"GDScript",\n"path": "%s"\n}' % (c, p) + (", " if i < len(pairs) - 1 else "")
        for i, (c, p) in enumerate(pairs))
    write(os.path.join(root, ".godot", "global_script_class_cache.cfg"), "list=[" + entries + "]\n")


def fresh():
    root = tempfile.mkdtemp(prefix="test-selftest-")
    write(os.path.join(root, "a", "foo.gd"), "class_name Foo\nextends Node\n")
    write(os.path.join(root, "b", "bar.gd"), "@tool\nclass_name Bar extends Foo\n")   # (f) one-line form
    write(os.path.join(root, "addons", "gut", "gut.gd"), "class_name GutMain\n")      # addons ARE cached
    write(os.path.join(root, "plain.gd"), "extends Node\n# class_name NotOne\n")      # no declaration
    return root


PAIRS = [("Foo", "res://a/foo.gd"), ("Bar", "res://b/bar.gd"), ("GutMain", "res://addons/gut/gut.gd")]

# (a) tree == cfg → current
root = fresh(); cfg(root, PAIRS)
assert t.class_cache_drift(root) == [], t.class_cache_drift(root)

# (b) cfg missing (fresh worktree) → every tree pair is drift
shutil.rmtree(os.path.join(root, ".godot"))
drift = t.class_cache_drift(root)
assert len(drift) == 3 and all("new" in d for d in drift), drift

# (c) a new class_name file → one drift line
root = fresh(); cfg(root, PAIRS)
write(os.path.join(root, "tmp_probe.gd"), "class_name ZzzProbe\n")
drift = t.class_cache_drift(root)
assert drift == ["new ZzzProbe res://tmp_probe.gd"], drift

# (d) a cached pair whose file is gone → one drift line
root = fresh(); cfg(root, PAIRS + [("Ghost", "res://gone/ghost.gd")])
drift = t.class_cache_drift(root)
assert drift == ["gone Ghost res://gone/ghost.gd"], drift

# (e) .gdignore'd dir, hidden dir, .worktrees → ignored
root = fresh(); cfg(root, PAIRS)
write(os.path.join(root, "native", ".gdignore"), "")
write(os.path.join(root, "native", "deep", "n.gd"), "class_name Native\n")
write(os.path.join(root, ".hidden", "h.gd"), "class_name Hidden\n")
write(os.path.join(root, ".worktrees", "wt", "w.gd"), "class_name Wt\n")
write(os.path.join(root, ".godot", "imported", "g.gd"), "class_name InGodot\n")
assert t.class_cache_drift(root) == [], t.class_cache_drift(root)

# (f) same class, different path → both a new and a gone line (a moved file)
root = fresh(); cfg(root, [("Foo", "res://old/foo.gd"), ("Bar", "res://b/bar.gd"), ("GutMain", "res://addons/gut/gut.gd")])
drift = t.class_cache_drift(root)
assert sorted(drift) == ["gone Foo res://old/foo.gd", "new Foo res://a/foo.gd"], drift

# --- shard planning off persisted timings -------------------------------

# (g) blend: a slower run is believed at once, a faster one only halfway —
# under-estimating a long script stacks it with others, over-estimating costs
# a little balance. A script absent from this run keeps its old value.
tmp = tempfile.mkdtemp(prefix="test-selftest-")
tf = os.path.join(tmp, "gut-timings.json")
t.save_timings({"test/unit/a.gd": 2.0, "test/unit/b.gd": 10.0, "test/unit/c.gd": 1.0}, tf)
t.save_timings({"test/unit/a.gd": 8.0, "test/unit/b.gd": 2.0}, tf)
got = t.load_timings(tf)
assert got == {"test/unit/a.gd": 8.0, "test/unit/b.gd": 6.0, "test/unit/c.gd": 1.0}, got

# (h) prune: an entry whose script is gone from the tree is dropped on save
proj = tempfile.mkdtemp(prefix="test-selftest-")
write(os.path.join(proj, "test", "unit", "kept.gd"), "extends GutTest\n")
tf = os.path.join(proj, "gut-timings.json")
t.save_timings({"test/unit/kept.gd": 1.0, "test/unit/gone.gd": 1.0}, tf, root=proj)
assert t.load_timings(tf) == {"test/unit/kept.gd": 1.0}, t.load_timings(tf)

# (i) unknown script: costed at its tier's median, not a flat constant, so a
# new integration test is not planned as if it were a 0.5s formula test
timings = {"test/unit/a.gd": 0.1, "test/unit/b.gd": 0.2, "test/unit/c.gd": 0.3,
           "test/integration/x.gd": 4.0, "test/integration/y.gd": 6.0}
est = t.cost_model(timings)
assert est("res://test/unit/a.gd") == 0.1
assert est("res://test/integration/new.gd") == 5.0, est("res://test/integration/new.gd")
assert est("res://test/unit/new.gd") == 0.2
assert est("res://test/elsewhere/new.gd") == t.DEFAULT_SCRIPT_SECONDS
assert t.cost_model({})("res://test/unit/new.gd") == t.DEFAULT_SCRIPT_SECONDS

# (j) partition balances on that model: the two 5s unknowns split apart
plan = t.partition(["res://test/integration/n1.gd", "res://test/integration/n2.gd",
                    "res://test/unit/a.gd", "res://test/unit/b.gd"], 2, timings)
assert sorted(len([s for s in sh if "integration" in s]) for sh in plan) == [1, 1], plan

# (k) a worktree with no timings of its own plans off the main checkout's;
# its own entries win where both exist
main_t = {"test/unit/a.gd": 9.0, "test/unit/b.gd": 3.0}
mine = {"test/unit/a.gd": 1.0}
assert t.merge_timings(main_t, mine) == {"test/unit/a.gd": 1.0, "test/unit/b.gd": 3.0}
assert t.merge_timings(main_t, {}) == main_t

# --- shard hang protection ---------------------------------------------

# (l) deadline: 3x the planned load plus a boot allowance, never under the
# floor; GUT_SHARD_DEADLINE pins it outright (seconds), blank means unset
assert t.shard_deadline(0.0, {}) == t.SHARD_DEADLINE_FLOOR
assert t.shard_deadline(100.0, {}) == t.SHARD_BOOT_SECONDS + 300.0, t.shard_deadline(100.0, {})
assert t.shard_deadline(100.0, {"GUT_SHARD_DEADLINE": "7"}) == 7.0
assert t.shard_deadline(100.0, {"GUT_SHARD_DEADLINE": " "}) == t.SHARD_BOOT_SECONDS + 300.0

# (m) which script a shard was on: the last column-0 `res://…gd` header and
# the last `* test_` line under it; an indented failure line citing another
# script (`[2] test_x (res://…gd:71)`) is not a header
log = """GUT  ---
res://test/unit/a.gd
* test_one
1/1 passed.

res://test/unit/b.gd
* test_two
       [2] test_two (res://test/unit/zzz.gd:71)
* test_three
[client] dialling
"""
assert t.last_position_in_log(log) == ("res://test/unit/b.gd", "test_three"), t.last_position_in_log(log)
assert t.last_position_in_log("res://test/unit/c.gd\n") == ("res://test/unit/c.gd", None)
assert t.last_position_in_log("Godot Engine v4.7\n---  GUT  ---\n") == (None, None)
assert t.last_position_in_log("") == (None, None)

print("test-selftest: 13 cases OK")

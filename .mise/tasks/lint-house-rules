#!/usr/bin/env python3
#MISE description="Fail on a regex-grade house-rule violation: `mise run lint-house-rules [-- --json|--rule <id>|--all|--self-test]`"
"""
Table-driven lint for the house rules a regex can see. Each rule is one row of
`RULES`; one loop applies every row to every tracked file in its scope.

  CRITERION: a rule a regex over one line (or a short window of lines) can
  express is a ROW here. A rule that needs a parse tree is its own task
  (`lint-editor-hint-guard`, `lint-scene-instance-depth`, `lint-instanced-anchors`
  are). Never bolt a parser onto this table — a row that wants one has outgrown it.

A row's `doc` is the `docs/domain/*.md` its breadcrule points at; the violation
line names it, so the reader lands on the why, not on this file.

Output: `path:line  [row-id] message → see doc`. Exit 1 on any violation — a gate,
unlike `rules-hygiene`. `--json` prints `{"violations": [...], "exempted": [...]}`;
`--rule <id>` runs one row; `--all` adds the report-only rows (`default_on=False`,
off in the default run that gates `check`); `--self-test` feeds every row, report-only
included, its positive and negative fixtures (and the inline escape) and asserts all three.

  FILE PREDICATE: `file_predicate` gates a row per FILE (it sees the file's code
  lines, strings blanked) — the one step past line regex, for `access-style`'s
  "this file already uses `$`/`%`". A third use of it is the moment to reconsider
  the table.

  SANCTIONED EXCEPTIONS of `control-composed` (a `Label.new()`+`add_child` tree in
  code): (1) `test/` — a test builds the throwaway tree it asserts on; (2) `tools/`
  — dev tooling, never a shipped path; (3) `addons/` — vendored (GLOBAL_EXCLUDE).
  A row list built from DATA (a sandbox-host tab, a dev scene) is the inline
  escape on the `.new()` line, with that reason; "it was quicker" is not one.

  EXEMPTION DISCIPLINE (as `lint-transcendentals`): every `exempt_dirs` /
  `exempt_files` entry carries a REASON, and the reason states the condition
  under which it stops being true. "Out of scope" is not a reason. A single
  line escapes with a trailing `# lint: <row-id> — <reason>` on the reported
  line; the reason is mandatory by convention, and the hit is still listed
  under `exempted` in `--json`.
"""
import fnmatch
import json
import re
import subprocess
import sys
from dataclasses import dataclass, field
from typing import Callable, Optional

# Never scanned by any row: vendored code, not ours to hold to house rules.
GLOBAL_EXCLUDE = ("addons/", "native/godot-cpp/")

TEST_DIR = {"test/": "tests arrange states gameplay never may, and assert the "
                     "forbidden form on purpose to pin it."}


@dataclass
class Rule:
    id: str
    doc: str
    pattern: re.Pattern
    message: str
    pos: object                    # fixture that MUST hit (self-test); a list = one file each
    neg: object                    # fixture that must NOT hit (self-test); a list = one file each
    window: int = 1                # lines joined with "\n" and matched at line i
    scope: list = field(default_factory=lambda: ["*.gd"])
    exempt_dirs: dict = field(default_factory=dict)
    exempt_files: dict = field(default_factory=dict)   # fnmatch globs
    # Optional refinement over a match, for a fact a regex states badly (a
    # numeric comparison). Still regex-grade: it sees the match, never a tree.
    predicate: Optional[Callable[[re.Match], bool]] = None
    # Optional per-file gate: given the file's code lines (comments stripped,
    # string contents blanked), False skips the row for the whole file.
    file_predicate: Optional[Callable[[list], bool]] = None
    # False = report-only: skipped by the default run, on with --rule / --all.
    default_on: bool = True


def _any_component_over_one(m):
    for part in m.group(1).split(","):
        part = part.strip()
        if re.fullmatch(r"\d*\.?\d+", part) and float(part) > 1.0:
            return True
    return False


def blank_strings(line):
    """Empty every string literal's contents (`"a%b"` -> `""`), keeping quotes."""
    return re.sub(r'"(?:[^"\\\n]|\\.)*"|\'(?:[^\'\\\n]|\\.)*\'',
                  lambda m: m.group(0)[0] * 2, line)


# `$X` / `$"X"`, or a `%X` / `%"X"` in unary position — the char before `%` is not
# an operand end (identifier, `)`, `]`, closing quote), so `"%s" % x` and `a %b` are
# the modulo/format operator, not a unique-name access.
def _uses_sigil_access(lines):
    for raw in lines:
        line = blank_strings(raw)
        if "$" in line and re.search(r'\$["\w]', line):
            return True
        for m in re.finditer(r'%["A-Za-z_]', line):
            before = line[:m.start()].rstrip()
            if not before or not re.search(r'[\w)\]"\']$', before):
                return True
    return False



]


def strip_gd_comment(line):
    """Drop a trailing `#` comment, ignoring `#` inside a string literal."""
    out, quote = [], None
    for ch in line:
        if quote:
            out.append(ch)
            if ch == quote:
                quote = None
        elif ch in "\"'":
            quote = ch
            out.append(ch)
        elif ch == "#":
            break
        else:
            out.append(ch)
    return "".join(out)


def code_lines(raw_lines):
    """Comment-stripped lines, DENSE: a `##` doc line is blanked, never dropped,
    so index + 1 stays the line number and window rows see real neighbours."""
    return ["" if r.lstrip().startswith("##") else strip_gd_comment(r) for r in raw_lines]


def escaped(raw, rule_id):
    return re.search(r"#\s*lint:\s*%s\b" % re.escape(rule_id), raw) is not None


def match_lines(rule, raw_lines):
    """Yield (lineno, text) for every line where `rule` hits, before exemptions."""
    code = code_lines(raw_lines)
    for i in range(len(code)):
        text = "\n".join(code[i:i + rule.window]) if rule.window > 1 else code[i]
        m = rule.pattern.match(text) if rule.window > 1 else rule.pattern.search(text)
        if m is None:
            continue
        if rule.window == 1 and rule.predicate is not None:
            if not any(rule.predicate(x) for x in rule.pattern.finditer(text)):
                continue
        elif rule.predicate is not None and not rule.predicate(m):
            continue
        yield i + 1, code[i]


def in_scope(rule, path):
    return any(fnmatch.fnmatch(path, g) for g in rule.scope)


def exemption_for(rule, path):
    for d, why in rule.exempt_dirs.items():
        if path.startswith(d):
            return why
    for g, why in rule.exempt_files.items():
        if fnmatch.fnmatch(path, g):
            return why
    return None


def tracked_files():
    out = subprocess.run(["git", "ls-files", "-z"], capture_output=True, text=True)
    if out.returncode != 0:
        print("lint-house-rules: not a git checkout", file=sys.stderr)
        sys.exit(2)
    return [p for p in out.stdout.split("\0")
            if p and not p.startswith(GLOBAL_EXCLUDE)]


def scan(rules):
    hits, exempted = [], []
    for path in tracked_files():
        active = [r for r in rules if in_scope(r, path)]
        if not active:
            continue
        with open(path, encoding="utf-8", errors="replace") as fh:
            raw = fh.read().split("\n")
        for rule in active:
            why = exemption_for(rule, path)
            for lineno, text in match_lines(rule, raw):
                rec = {"file": path, "line": lineno, "rule": rule.id,
                       "doc": rule.doc, "text": text.strip()[:120]}
                if why is None and escaped(raw[lineno - 1], rule.id):
                    rec["reason"] = "inline escape: " + raw[lineno - 1].split("#", 1)[-1].strip()
                    exempted.append(rec)
                elif why is not None:
                    rec["reason"] = why
                    exempted.append(rec)
                else:
                    rec["message"] = rule.message
                    hits.append(rec)
    return hits, exempted


def self_test(rules):
    ok = True
    for r in rules:
        pos = r.pos.split("\n")
        pos_hits = list(match_lines(r, pos))
        neg_hits = list(match_lines(r, r.neg.split("\n")))
        if not pos_hits:
            print(f"  ✗ [{r.id}] positive fixture did not hit")
            ok = False
        if neg_hits:
            print(f"  ✗ [{r.id}] negative fixture hit at line(s) {[n for n, _ in neg_hits]}")
            ok = False
        for n, _ in pos_hits:
            if not escaped(pos[n - 1] + "  # lint: %s — self-test" % r.id, r.id):
                print(f"  ✗ [{r.id}] inline escape not recognised")
                ok = False
    print("✓ lint-house-rules self-test (%d rows)" % len(rules) if ok
          else "✗ lint-house-rules self-test failed")
    return 0 if ok else 1


def main(argv):
    rules = RULES
    if "--rule" in argv:
        i = argv.index("--rule")
        want = argv[i + 1] if i + 1 < len(argv) else ""
        rules = [r for r in RULES if r.id == want]
        if not rules:
            print(f"lint-house-rules: no row `{want}` — rows: "
                  + ", ".join(r.id for r in RULES), file=sys.stderr)
            return 2
    if "--self-test" in argv:
        return self_test(rules)

    hits, exempted = scan(rules)
    if "--json" in argv:
        print(json.dumps({"violations": hits, "exempted": exempted}, indent=2))
        return 1 if hits else 0

    print(f"Scanned tracked files against {len(rules)} row(s) — "
          f"{len(exempted)} exempted hit(s).")
    if not hits:
        print("\n✓ no house-rule violations")
        return 0
    print(f"\n{len(hits)} violation(s):")
    for h in hits:
        print(f"  {h['file']}:{h['line']}  [{h['rule']}] {h['message']} → see {h['doc']}")
    print("\nFix it, or — if the rule truly does not apply — exempt it in this file WITH a")
    print("reason that says when the exemption ends, or a trailing `# lint: <row-id> — <reason>`.")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

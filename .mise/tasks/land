#!/usr/bin/env bash
#MISE description="Land a branch on master, serialised: `mise run land -- <branch> [--closes <n>]` — flock, rebase, check + test:dir on the touched dirs, ff-only, board → in-review"
#
# The merge token, mechanised (#857). One locked command replaces the by-hand
# rebase / ladder / ff dance the lead used to do per unit:
#
#   1. exclusive flock on .godot/land.lock in the MAIN checkout — a second
#      caller waits (and says so) rather than racing the fast-forward;
#   2. refuse unless the branch exists and the main checkout is clean and on
#      master;
#   3. rebase the branch onto master INSIDE its own worktree if one exists,
#      else in a detached throwaway worktree — the branch is never checked out
#      in the main checkout;
#   4. `mise run check` always, plus `mise run test:dir` for every
#      test/unit/<dir>/ the branch touches (test files directly, or by the
#      top-level dir of a non-test file when test/unit/<dir>/ exists) — a
#      rebased tree is a tree nobody tested;
#   5. `git merge --ff-only`; with --closes, the branch tip carries
#      `Closes #<n>` — appended by amending the tip right after the rebase
#      when the drone's message lacks it (so the tested sha IS the landed
#      sha; never an empty `land:` commit, owner call 2026-09-15) — and the
#      board moves to in-review.
#
# Every landing's whole console output is tee'd to
# scratchpad/land/land-<issue-or-branch-slug>.log (in the MAIN checkout,
# gitignored) plus a land-last.log copy of the most recent — so `cost:` rows
# and a `fail` reason both survive past the terminal scrollback (#920). Not
# `.godot/`: that's the engine's cache and a refresh-style operation wipes it
# mid-land.
#
# Non-zero, reason on stdout, on: main checkout dirty in a file the branch
# also touches / off-master main checkout, missing
# branch, rebase conflict (aborted, conflicting files listed), red check or
# test:dir (verdict lines printed), a non-ff. Never runs the full suite, never
# pushes — both stay with the lead at the train gate.
set -uo pipefail

usage="usage: mise run land -- <branch> [--closes <issue-number>]"
branch=""
closes=""
while [ $# -gt 0 ]; do
  case "$1" in
    --closes) closes="${2:?$usage}"; shift 2 ;;
    --closes=*) closes="${1#--closes=}"; shift ;;
    -h|--help) echo "$usage"; exit 0 ;;
    -*) echo "✗ unknown flag: $1"; echo "$usage"; exit 2 ;;
    *) if [ -n "$branch" ]; then echo "✗ one branch at a time"; echo "$usage"; exit 2; fi
       branch="$1"; shift ;;
  esac
done
[ -n "$branch" ] || { echo "$usage"; exit 2; }
if [ -n "$closes" ] && ! [[ "$closes" =~ ^[0-9]+$ ]]; then
  echo "✗ --closes wants an issue number, got: $closes"; exit 2
fi

# The MAIN checkout, wherever this was invoked from (a drone's worktree
# included): the common git dir's parent is the primary worktree.
here="${MISE_PROJECT_ROOT:-$PWD}"
common=$(git -C "$here" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
  || { echo "✗ not inside a git checkout: $here"; exit 1; }
main=$(dirname "$common")

# #920 — every landing gets its own log, tee'd from the whole body below,
# so a lead who greps the console still has every `cost:` row on disk (and a
# ledger falls out of `cat scratchpad/land/land-*.log | grep cost:`). Keyed by
# what was landed: the issue with --closes, else the branch slug (`/` -> `-`).
# scratchpad/ is gitignored already, in the MAIN checkout (not the worktree, and
# never .godot/, which a refresh-style operation can wipe mid-land).
logdir="$main/scratchpad/land"
mkdir -p "$logdir"
if [ -n "$closes" ]; then
  logkey="$closes"
else
  logkey="${branch//\//-}"
fi
log="$logdir/land-${logkey}.log"

# The whole rest of land is one function so its stdout+stderr can be tee'd to
# $log while still reaching the terminal, and so `land-last.log` is always a
# copy of exactly what landed — including a precondition `fail` (its `exit 1`
# only exits this function's subshell; $? survives via PIPESTATUS). The flock
# and the worktree-cleanup trap live in here too, unchanged in behaviour: both
# are scoped to this subshell's lifetime, which is exactly land_body's.
land_body() {
fail() { echo "✗ $*"; exit 1; }

# --- 1. the merge token ----------------------------------------------------
mkdir -p "$main/.godot"
lock="$main/.godot/land.lock"
exec 9>"$lock"
if ! flock -n 9; then
  echo "… waiting for the merge token ($lock is held by another land)"
  flock 9
fi
echo "▶ land $branch → master (token acquired)"

# --- 2. preconditions ------------------------------------------------------
git -C "$main" rev-parse --verify --quiet "refs/heads/$branch" >/dev/null \
  || fail "no such branch: $branch"
[ "$branch" != "master" ] || fail "refusing to land master onto itself"
on=$(git -C "$main" symbolic-ref --short -q HEAD || echo "(detached)")
[ "$on" = "master" ] || fail "main checkout is on '$on', not master: $main"
# A dirty main checkout is fine as long as the branch does not touch the same
# files — that is git's own ff rule, and the owner's open editor resaves .tres
# files continuously (owner call 2026-09-15). Refuse only on the intersection.
dirty=$(git -C "$main" status --porcelain --untracked-files=no | cut -c4- | sed 's/.* -> //')
if [ -n "$dirty" ]; then
  touched=$(git -C "$main" diff --name-only "master...$branch")
  overlap=$(comm -12 <(echo "$dirty" | sort -u) <(echo "$touched" | sort -u))
  if [ -n "$overlap" ]; then
    echo "$overlap" | sed 's/^/    /'
    fail "main checkout has uncommitted changes to files $branch also changes — commit or park them first: $main"
  fi
  echo "  (main checkout is dirty in $(echo "$dirty" | wc -l) file(s) the branch does not touch — proceeding)"
fi
if git -C "$main" merge-base --is-ancestor "$branch" master; then
  echo "✓ nothing to land: $branch is already contained in master"
  exit 0
fi

# --- 3. a worktree to rebase in --------------------------------------------
wt=""
tmp_wt=""
wt=$(git -C "$main" worktree list --porcelain | awk -v b="refs/heads/$branch" '
  /^worktree /{p=substr($0,10)} /^branch /{if($2==b){print p; exit}}')
if [ -n "$wt" ]; then
  [ "$wt" != "$main" ] || fail "$branch is checked out in the main checkout — land only works on worktree branches"
  wdirty=$(git -C "$wt" status --porcelain --untracked-files=no)
  if [ -n "$wdirty" ]; then
    echo "$wdirty" | head -20
    fail "the branch's worktree has uncommitted changes — the drone must commit first: $wt"
  fi
  echo "  rebasing inside the branch's worktree: $wt"
else
  tmp_wt="$main/.worktrees/land-tmp-$$"
  git -C "$main" worktree add --detach "$tmp_wt" "$branch" >/dev/null 2>&1 \
    || fail "could not create a throwaway worktree at $tmp_wt"
  wt="$tmp_wt"
  # Same seeding as worktree:new: the GDExtension is mandatory since #847 and
  # gitignored, so a bare worktree fails every blade test without it.
  if [ -d "$main/native/bin" ] && [ -n "$(ls -A "$main/native/bin" 2>/dev/null)" ]; then
    mkdir -p "$wt/native/bin" && cp -a "$main/native/bin/." "$wt/native/bin/"
  fi
  echo "  no worktree holds $branch — rebasing in a throwaway: $wt"
fi
cleanup() {
  if [ -n "$tmp_wt" ] && [ -d "$tmp_wt" ]; then
    git -C "$main" worktree remove --force "$tmp_wt" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

# --- 4. rebase -------------------------------------------------------------
if ! git -C "$wt" rebase master >/dev/null 2>&1; then
  echo "✗ rebase of $branch onto master conflicts in:"
  git -C "$wt" diff --name-only --diff-filter=U | sed 's/^/    /'
  git -C "$wt" rebase --abort >/dev/null 2>&1 || true
  echo "  rebase aborted; $branch is untouched at $(git -C "$main" rev-parse --short "$branch")."
  echo "  resolve it in the branch's worktree (git rebase master there), commit, and land again."
  exit 1
fi
sha=$(git -C "$wt" rev-parse HEAD)
if [ -n "$tmp_wt" ]; then
  # Detached rebase moved only HEAD; point the branch at the rebased tip so
  # what lands (or what fails below) is what the branch now says.
  git -C "$main" branch -f "$branch" "$sha" >/dev/null
fi
echo "  rebased: $branch is now $(git -C "$main" rev-parse --short "$sha") on master $(git -C "$main" rev-parse --short master)"

# --- 4b. the closing line rides the tip, not an empty commit ----------------
if [ -n "$closes" ] && ! git -C "$wt" log -1 --format=%B | grep -qiE "^(closes|fixes|resolves) #${closes}\b"; then
  git -C "$wt" commit --quiet --amend -m "$(git -C "$wt" log -1 --format=%B)

Closes #${closes}" || fail "could not amend Closes #${closes} onto the tip of $branch"
  sha=$(git -C "$wt" rev-parse HEAD)
  [ -n "$tmp_wt" ] && git -C "$main" branch -f "$branch" "$sha" >/dev/null
  echo "  amended tip $(git -C "$main" rev-parse --short "$sha"): + Closes #${closes}"
fi

# --- 5. the ladder on the rebased tree -------------------------------------
files=$(git -C "$main" diff --name-only --diff-filter=d "master..$sha")  # a deleted test is not a test to run
dirs=""
singles=""
integration=""   # res://test/integration/… targets; the tier is small, so one run per dir
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    # The integration arm precedes `*/*` or it never matches (#360).
    test/integration/*) integration="$integration res://test/integration/" ;;
    test/unit/*/*) d="${f#test/unit/}"; dirs="$dirs ${d%%/*}" ;;
    test/unit/*.gd) singles="$singles $f" ;;
    */*) top="${f%%/*}"
         [ -d "$main/test/unit/$top" ] && dirs="$dirs $top"
         # A source dir's level-driving tests live in the integration tier once
         # #980 moves them; the full suite stays the train gate (#360).
         [ -d "$main/test/integration/$top" ] && integration="$integration res://test/integration/$top/" ;;
  esac
done <<< "$files"
dirs=$(printf '%s\n' $dirs | sort -u | xargs)
singles=$(printf '%s\n' $singles | sort -u | xargs)
integration=$(printf '%s\n' $integration | sort -u | xargs)
case " $integration " in *" res://test/integration/ "*) integration="res://test/integration/" ;; esac  # the whole tier subsumes its subdirs

run_step() {  # run_step <label> <cmd...>; prints the verdict lines on red
  local label="$1"; shift
  local log
  log=$(mktemp)
  echo "  $label …"
  if (cd "$wt" && "$@") >"$log" 2>&1; then
    grep -E '✓' "$log" | tail -1 | sed -E 's/^(\[[^]]*\] )?/    /'
    rm -f "$log"
    return 0
  fi
  echo "✗ $label is red on the rebased tree:"
  # The verdict + failure block the task printed, minus Godot's exit trailer.
  grep -vE '^\s*$|ObjectDB instances were leaked|resources still in use at exit|PagedAllocator' "$log" | tail -40 | sed 's/^/    /'
  echo "    (full output: $log)"
  return 1
}

run_step "mise run check" mise run check || exit 1
for d in $dirs; do
  run_step "mise run test:dir -- res://test/unit/$d/" mise run test:dir -- "res://test/unit/$d/" || exit 1
done
for s in $singles; do
  run_step "mise run test:one -- res://$s" mise run test:one -- "res://$s" || exit 1
done
for i in $integration; do
  run_step "mise run test:dir -- $i" mise run test:dir -- "$i" || exit 1
done
[ -n "$dirs$singles$integration" ] || echo "    (no test/unit/<dir>/ or test/integration/ maps to the touched files — check only)"

# --- 6. fast-forward -------------------------------------------------------
if ! out=$(git -C "$main" merge --ff-only "$sha" 2>&1); then
  echo "$out" | sed 's/^/    /'
  fail "master could not fast-forward to $branch — master moved under the rebase? land again."
fi
echo "  master fast-forwarded to $(git -C "$main" rev-parse --short master)"

if [ -n "$closes" ]; then
  if (cd "$main" && mise run gh-project -- status "$closes" in-review) >/dev/null 2>&1; then
    echo "  board: #${closes} → in-review"
  else
    echo "  ⚠ board move failed (mise gh-project -- status $closes in-review) — move it by hand"
  fi
  # A parent never carries work, so the hub follows its children: this is
  # what moves a hub to in-review the moment its last child lands. Hub → Done
  # + close waits for the push (`Closes #n` fires there) and the next
  # `gh-project hygiene --fix` at the train gate. Non-fatal, same as above.
  if (cd "$main" && mise run --quiet gh-project -- sync-parent "$closes") 2>/dev/null | sed 's/^/  board: /'; then :; fi
fi

echo "LANDED $branch $(git -C "$main" rev-parse --short "$sha") master=$(git -C "$main" rev-parse --short master)"

# En passant: what the branch cost, from the transcripts of every subagent
# that worked in its worktree (drone + reviewer). Best estimate, never fatal,
# silent when no transcript matches (a hand-made branch).
(cd "$main" && mise run --quiet agent-cost -- --branch "$branch" --quiet-empty 2>/dev/null | sed 's/^/  cost: /') || true
}

land_body "$@" 2>&1 | tee "$log"
status=${PIPESTATUS[0]}
cp "$log" "$logdir/land-last.log"
exit "$status"

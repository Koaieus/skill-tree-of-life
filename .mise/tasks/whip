    s = sp.add_parser("trains"); s.add_argument("--redo", action="store_true"); s.add_argument("--size", type=int, default=4); s.set_defaults(f=cmd_trains)
    s = sp.add_parser("train"); s.add_argument("verb", choices=["split", "drop"]); s.add_argument("train"); s.add_argument("arg", help="split: index · drop: issue number"); s.set_defaults(f=cmd_train)
    s = sp.add_parser("launch", help="owner's manual launch of lead-<t> (or relief-<t>-<k> with --relief)"); s.add_argument("name"); s.add_argument("--relief", action="store_true"); s.set_defaults(f=cmd_launch)
    s = sp.add_parser("max-leads"); s.add_argument("n", type=int); s.set_defaults(f=cmd_max_leads)
    s = sp.add_parser("done", help="(lead) train landed: records, passes the baton or ends the run"); s.add_argument("--lead"); s.add_argument("sha"); s.add_argument("landed"); s.set_defaults(f=cmd_done)
    sp.add_parser("relieve-me", help="(lead) launches your relief").set_defaults(f=cmd_relieve_me)

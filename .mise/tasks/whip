    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd", required=True)
    s = sp.add_parser("start", help="from any session: daemon + timer up, snapshot, trains, run issue, first lead(s)")
    s.add_argument("--cap", type=float, default=15); s.add_argument("--max-leads", type=int, default=1)
    s.add_argument("--stall-minutes", type=int, default=45, help="disk silence that counts as a stall")
    s.add_argument("--every", type=int, default=10); s.add_argument("--size", type=int, default=4, help="max singletons per train")

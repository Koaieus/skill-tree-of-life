    s = sp.add_parser("start"); s.add_argument("--cap", type=float, default=15); s.add_argument("--max-leads", type=int, default=1)
    s.add_argument("--every", type=int, default=10); s.add_argument("--no-issue", action="store_true")
    s.add_argument("--linger-unchecked", action="store_true", help="skip the Linger=yes check (the fleet then dies at logout)"); s.set_defaults(f=cmd_start)
    s = sp.add_parser("retire", help="archive the run on disk into handoffs/archive/ so the next start begins clean"); s.add_argument("--force", action="store_true", help="archive a live, unreported run"); s.set_defaults(f=cmd_retire)
    s = sp.add_parser("trains"); s.add_argument("--redo", action="store_true"); s.add_argument("--size", type=int, default=4); s.set_defaults(f=cmd_trains)
    s = sp.add_parser("train"); s.add_argument("verb", choices=["split", "drop"]); s.add_argument("train"); s.add_argument("arg", help="split: index · drop: issue number"); s.set_defaults(f=cmd_train)
    s = sp.add_parser("launch"); s.add_argument("name"); s.add_argument("issues", nargs="?", default=""); s.add_argument("--relief", action="store_true"); s.add_argument("--self", action="store_true"); s.set_defaults(f=cmd_launch)
    s = sp.add_parser("max-leads"); s.add_argument("n", type=int); s.set_defaults(f=cmd_max_leads)
    s = sp.add_parser("done"); s.add_argument("lead"); s.add_argument("sha"); s.add_argument("landed"); s.set_defaults(f=cmd_done)
    s = sp.add_parser("note"); s.add_argument("text"); s.set_defaults(f=cmd_note)
    sp.add_parser("show").set_defaults(f=cmd_show)
    sp.add_parser("relieve-me").set_defaults(f=cmd_relieve_me)
    sp.add_parser("claim").set_defaults(f=cmd_claim)
    sp.add_parser("done-check").set_defaults(f=cmd_done_check)
    sp.add_parser("report").set_defaults(f=cmd_report)
    sp.add_parser("watchdog").set_defaults(f=cmd_watchdog)
    s = sp.add_parser("daemon"); s.add_argument("action", choices=["start", "status", "stop"]); s.set_defaults(f=cmd_daemon)

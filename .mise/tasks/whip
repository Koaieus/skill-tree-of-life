def collapse(lines):
    """Identical incident lines (timestamp stripped) → one line `×N, HH:MM–HH:MM`."""
    out, run_ = [], None
    for e in lines:
        ts, _, body = e.partition(" ")
        hhmm = ts[-5:] if len(ts) >= 5 else ts
        if "T" not in ts and " " in e and re.match(r"\d{4}-\d{2}-\d{2}$", ts):  # "YYYY-MM-DD HH:MM body"
            hhmm, _, body = body.partition(" ")
        if run_ and run_[0] == body:
            run_[1] += 1; run_[3] = hhmm
        else:
            if run_: out.append(run_)
            run_ = [body, 1, hhmm, hhmm]
    if run_: out.append(run_)
    return [f"{b} ×{n}, {t0}–{t1}" if n > 1 else f"{t0} {b}" for b, n, t0, t1 in out]


def write_report(st):
    torn = [] if tree(st) else timer_uninstall()
    rem = set(remaining_ready(st)); start = st["start_sha"]; dropped = st.get("dropped", [])
    log = sh(f"git log --oneline {start}..master", cwd=ROOT).strip().splitlines()
    closes = {int(n) for n in re.findall(r"[Cc]loses #(\d+)", sh(f"git log {start}..master", cwd=ROOT))}
    landed = [n for n in st["ready"] if n in closes]
    nd = board_lane("needs-design"); ip = board_lane("in-progress")
    back = [n for n in st["ready"] if n in nd and n not in dropped and n not in landed]
    orphaned = [n for n in st["ready"] if n in ip and n not in landed and n not in dropped and n not in back]
    since = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(st["started_ts"]))
    filed = sh(f"gh issue list --search 'created:>={since}' --state all --json number,title --jq '.[] | \"#\\(.number) \\(.title)\"'").strip()
    owner = [n for n in st["notes"] if "needs owner" in n]
    inc = collapse([e for e in st["events"] if re.search(r"relief|watchdog|REFUSED|FAILED|deferred|dropped|blocked|stalled|respawn|limit|GAVE UP|ceiling|strike|did not|owner stop|CAPPED|warning", e)])
    cost = sh("mise run --quiet agent-cost -- --latest 20", cwd=ROOT).strip().splitlines()[:25]
    T = lambda n: st["ready_titles"].get(str(n), "")
    why = lambda n: next((" — " + x.split(":", 2)[-1].strip() for x in st["notes"] if f"still-ready #{n}" in x), "")
    head = (f"Landed {len(landed)}/{len(st['ready'])} · {len(log)} commits `{start[:7]}..master` · back to Needs design {len(back)} · "
            f"orphaned In progress {len(orphaned)} · dropped {len(dropped)} · still Ready {len(rem)}")
    head = " · ".join(warnings(st) + [head])
    L = [f"# Whip report {st['date']}", "", f"**{head}**", "",
         "## Landed"] + ([f"- #{n} {T(n)}" for n in landed] or ["- none"]) + \
        ["", "## Back to Needs design"] + ([f"- #{n} {T(n)}" for n in back] or ["- none"]) + \
        ["", "## Still Ready"] + ([f"- #{n} {T(n)}{why(n)}" for n in sorted(rem)] or ["- none"]) + \
        ["", "## Orphaned In progress"] + ([f"- #{n} {T(n)} — left In progress by a dead lead; check its worktree/branch" for n in orphaned] or ["- none"]) + \
        ["", "## Dropped by the owner"] + ([f"- #{n} {T(n)}" for n in dropped] or ["- none"]) + \
        ["", f"## Filed since start ({since})", filed or "- none", "", "## Needs the owner"] + ([f"- {o}" for o in owner] or ["- none"]) + \
        ["", "## Incidents"] + ([f"- {e}" for e in inc] or ["- none"]) + \
        ["", "## Cost (agent-cost, latest 20)", "```"] + cost + ["```", "",
         ("Tree transport: no daemon, timer or session was ever started; nothing to tear down." if tree(st) else
          f"Torn down: {', '.join(torn) if torn else 'nothing (the timer units were already gone)'}. The daemon unit {DAEMON_UNIT} stays up; "
          f"`systemctl --user stop {DAEMON_UNIT}` is the owner's.")]
    out = os.path.join(HDIR, f"whip-report-{st['date']}.md")
    if os.path.exists(out) and st.get("report_path") != out:  # another run's report of this date: never overwrite it
        out = os.path.join(HDIR, f"whip-report-{st['date']}-{time.strftime('%H%M', time.localtime(st['started_ts']))}.md")
    with open(out, "w") as f: f.write("\n".join(L) + "\n")
    if st.get("run_issue"):
        sh(["gh", "issue", "comment", str(st["run_issue"]), "--body-file", out])
    st["done"] = True; st["report_path"] = out; save(st); event(st, f"report written {out}; torn down: {' '.join(torn) or 'nothing'}")
    open(st["_path"][:-5] + ".done", "w").write(now())
    print(out)
    return out



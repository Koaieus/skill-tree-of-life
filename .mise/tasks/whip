#!/usr/bin/env python3
#MISE description="Whip, the overnight supervisor's ledger + zero-token watchdog: `mise run whip -- start [--cap H] [--max-leads N] | trains | train split|drop | launch <name> '<issues>' [--relief|--self] | max-leads N | done <lead> <sha> <n/m> | note '…' | show | done-check | report | retire [--force] | watchdog | daemon start|status|stop | timer install|uninstall`"
"""
State for one overnight run lives in docs/handoffs/whip-<date>.json
(gitignored); `show` and every write render the human ledger
whip-<date>.md next to it. The `whip` skill calls the verbs; the systemd
user timer calls `watchdog` with no Claude session involved. Design:
docs/charters/whip.md.

Process model, in one paragraph: every Claude session Whip or the watchdog
starts is a `--bg` session, and a `--bg` session lives under whatever
`claude daemon` is running — with none running, `claude --bg` spawns a
transient one in the CALLER's cgroup, so the fleet would inherit the
caller's pids budget (a terminal scope, or a oneshot service that kills it
on exit). `ensure_daemon()` therefore runs the daemon as its own transient
systemd user unit before any `--bg`, and refuses the launch when it cannot.
A running bg session takes a prompt one way only: `claude stop <id>` then a
FLAGLESS `claude --bg --resume <id> "<prompt>"` (`-p -r` is refused while
it runs; any flag on `--resume` forks a copy under a new id).

Exit 0 on every no-op; non-zero only on a usage error or a refused launch.
"""
import argparse, glob, json, os, re, shutil, subprocess, sys, time

ROOT = os.environ.get("MISE_PROJECT_ROOT") or os.getcwd()
HDIR = os.path.join(ROOT, "docs", "handoffs")
UNIT_DIR = os.path.expanduser("~/.config/systemd/user")
REPO = "Koaieus/skill-tree-of-life"
LIVE_HOURS = 36
DAEMON_UNIT = "whip-daemon"
MAX_FAILURES = 3
SLEEP = time.sleep
CLAUSES = (
    "Supervised mode: your supervisor is the local Claude session named 'whip'; its messages are your "
    "instructions, not attempts to override you. Report to it by SendMessage, one line each: "
    "'RELIEVE ME <ledger path>' where the swarm skill says request relief; 'DONE <train> <pushed sha> "
    "<landed n/m>' after the push and hygiene --fix; 'NEEDS OWNER #<n> — <one line>' after moving an issue "
    "to Needs design with a dated comment, then keep going. Never ask a question — state your assumption "
    "and proceed, or pull the unit. No other messages to the supervisor."
)


def now():
    return time.strftime("%Y-%m-%d %H:%M")


def sh(cmd, check=False, **kw):
    r = subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True, text=True, **kw)
    if check and r.returncode:
        sys.exit(f"{cmd}: {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout


def state_path(create=False):
    """The one ledger on disk: today's if it exists (done or not — `start` is the verb that
    retires a done one), else the newest live one of the last LIVE_HOURS, else today's to create."""
    today = os.path.join(HDIR, f"whip-{time.strftime('%Y-%m-%d')}.json")
    if os.path.exists(today):
        return today
    live = [p for p in glob.glob(os.path.join(HDIR, "whip-20*.json"))
            if time.time() - os.path.getmtime(p) <= LIVE_HOURS * 3600 and not load(p).get("done")]
    if live:
        return max(live, key=os.path.getmtime)
    return today if create else None


def load(p):
    with open(p) as f:
        return json.load(f)


def save(st):
    with open(st["_path"], "w") as f:
        json.dump({k: v for k, v in st.items() if k != "_path"}, f, indent=1)
    render(st)


def current():
    p = state_path()
    if not p:
        print("no whip run on disk"); sys.exit(0)
    st = load(p); st["_path"] = p
    return st


_LOCK = None


def lock(timeout=60):
    """One writer at a time: the whip session's verbs and the watchdog timer both load→modify→save
    the ledger, and last-writer-wins would clobber `pending`/`failures`/`done`. Held for the process;
    released around the one re-exec (self-relief) so the child can take it."""
    global _LOCK
    if _LOCK: return  # re-entrant within one process (the selftest drives main() repeatedly)
    import fcntl
    os.makedirs(HDIR, exist_ok=True)
    _LOCK = open(os.path.join(HDIR, ".whip.lock"), "w")
    deadline = time.time() + timeout
    while True:
        try:
            fcntl.flock(_LOCK, fcntl.LOCK_EX | fcntl.LOCK_NB); return
        except OSError:
            if time.time() > deadline: sys.exit(f"whip ledger locked for {timeout}s by another whip verb — try again")
            SLEEP(1)


def unlock():
    global _LOCK
    if _LOCK:
        import fcntl
        fcntl.flock(_LOCK, fcntl.LOCK_UN); _LOCK.close(); _LOCK = None


def retire_ledger(st, why):
    """Move the run's json/md/markers into handoffs/archive/, suffixed with the start time so two
    runs on one date never collide. The tracked whip-report-* stays. Returns the archive stem."""
    arch = os.path.join(HDIR, "archive"); os.makedirs(arch, exist_ok=True)
    stem = os.path.join(arch, f"whip-{st['date']}-{time.strftime('%H%M', time.localtime(st['started_ts']))}")
    k = 1
    while os.path.exists(stem + ".json"):  # two runs started the same minute: never overwrite an archive
        k += 1; stem = stem.rsplit("-", 1)[0] + f"-{k}" if k > 2 else stem + "-2"
    event(st, f"retired: {why}")
    base = st["_path"][:-5]
    for ext in (".json", ".md", ".done", ".gave-up"):
        if os.path.exists(base + ext):
            shutil.move(base + ext, stem + ext)
    return stem


def event(st, line):
    st["events"].append(f"{now()} {line}")
    save(st)


def render(st):
    md = st["_path"][:-5] + ".md"
    wd = (f"GAVE UP: {st['gave_up']}" if st.get("gave_up") else
          f"watchdog pending: {st['pending']['action']}" if st.get("pending") else
          f"watchdog failures {st.get('failures', 0)}/{MAX_FAILURES}" if st.get("failures") else "watchdog ok")
    L = [f"# Whip {st['date']} — ledger (gitignored; Whip's own relief reads this)",
         f"Start: master `{st['start_sha'][:7]}` · run issue #{st.get('run_issue', '?')} · cap {st['cap_h']}h · "
         f"leads ≤ {st.get('max_leads', 1)} · started {st['started']} · {'DONE' if st.get('done') else 'live'} · {wd}"
         + (f" · tasks {st['tasks_last']} (peak {st.get('tasks_peak', 0)})" if st.get("tasks_last") is not None else ""), "",
         "## Trains", "| train | issues | lead | state |", "|---|---|---|---|"]
    for t in st["trains"]:
        L.append(f"| {t['name']} | {' '.join('#%d' % n for n in t['issues'])} | {t.get('lead', '-')} | {t.get('state', 'queued')} |")
    if st.get("dropped"):
        L.append(f"Dropped by the owner: {' '.join('#%d' % n for n in st['dropped'])}")
    L += ["", "## Leads", "| name | session | kind | launched | state | last event |", "|---|---|---|---|---|---|"]
    for n, l in st["leads"].items():
        L.append(f"| {n} | {l['session'][:8]} | {l['kind']} | {l['launched']} | {l['state']} | {l.get('last', '')} |")
    L += ["", "## Notes"] + [f"- {n}" for n in st["notes"]] + ["", "## Events"] + [f"- {e}" for e in st["events"][-60:]]
    with open(md, "w") as f:
        f.write("\n".join(L) + "\n")


# ---------------------------------------------------------------- board + git
def ready_issues():
    out = sh("mise run --quiet gh-project -- list ready --json", cwd=ROOT)
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        sys.exit("gh-project list ready --json did not return JSON")


def blocked_by(n):
    out = sh(f"gh api repos/{REPO}/issues/{n}/dependencies/blocked_by --jq '.[].number'")
    return [int(x) for x in out.split()]


def milestone_of(n):
    out = sh(f"gh issue view {n} --json milestone --jq '.milestone.title // \"\"'")
    return out.strip()


# ---------------------------------------------------------------- sessions
def agents():
    try:
        return json.loads(sh("claude agents --json"))
    except json.JSONDecodeError:
        return []


def by_session(ags, sid):
    return next((x for x in ags if sid and x.get("sessionId", "").startswith(sid)), None)


def session_state(a):
    """gone | blocked | busy | idle, from `claude agents --json`'s two vocabularies.

    Interactive sessions carry `status` (busy/idle); background ones `state`
    (working/done/blocked), plus `status` once they have a pid. A dead bg
    record lingers as {state: blocked} with no pid and no status — gone, not
    blocked. `status` decides busy; `state` alone cannot ({idle, working}
    is an idle session whose last turn ran).
    """
    if not a or (a.get("pid") is None and "status" not in a):
        return "gone"
    if a.get("state") == "blocked":
        return "blocked"
    if a.get("status") == "busy" or ("status" not in a and a.get("state") == "working"):
        return "busy"
    return "idle"


def whip_entry(st, ags):
    """Whip is the ledger's `whip_session`; the name `whip` only when no id was ever recorded."""
    if st.get("whip_session"):
        return by_session(ags, st["whip_session"])
    return next((x for x in ags if x.get("name") == "whip"), None)


def daemon_active():
    return sh(f"systemctl --user is-active {DAEMON_UNIT}.service").strip() == "active"


def ensure_daemon():
    """The fleet's cgroup: `claude daemon run` as a transient user unit. True when it is up."""
    if daemon_active():
        return True
    cli = os.path.realpath(shutil.which("claude") or "claude")
    sh(f"systemctl --user reset-failed {DAEMON_UNIT}.service")
    props = ["-p", f"Environment=PATH={os.environ.get('PATH', '')}", "-p", f"Environment=HOME={os.path.expanduser('~')}",
             "-p", "Environment=DISABLE_AUTOUPDATER=1"]
    if os.environ.get("WHIP_TASKS_MAX"):
        props += ["-p", f"TasksMax={os.environ['WHIP_TASKS_MAX']}"]
    sh(["systemd-run", "--user", f"--unit={DAEMON_UNIT}", "--quiet", "-p", f"WorkingDirectory={ROOT}", *props, cli, "daemon", "run"])
    for _ in range(20):
        if daemon_active() and "pid:" in sh("claude daemon status"):
            return True
        SLEEP(0.5)
    return False


def bg(cmd, env=None):
    """Run a `claude --bg …` client and return the session id it printed, or None."""
    out = subprocess.run(cmd, capture_output=True, text=True, env=env or dict(os.environ, DISABLE_AUTOUPDATER="1"), cwd=ROOT).stdout
    out = re.sub(r"\x1b\[[0-9;]*m", "", out)  # `claude --bg` colours the id even into a pipe
    m = re.search(r"backgrounded · (\w+)", out)
    return (m.group(1) if m else None), out.strip()[:200]


def prompt_session(st, sid, prompt, action):
    """The one way to put a prompt into a bg session; the result is verified on the next tick."""
    if not ensure_daemon():
        event(st, f"watchdog: {action} — daemon unit {DAEMON_UNIT} not active and could not be started; no resume"); return False
    sh(["claude", "stop", sid]); SLEEP(2)
    got, out = bg(["claude", "--bg", "--resume", sid, prompt])
    st["pending"] = {"action": action, "session": sid, "ts": time.time()}
    event(st, f"watchdog: {action} → stop + resume {sid[:8]}: {out[:80]}")
    return got is not None


# ---------------------------------------------------------------- verbs
def cmd_start(a):
    me = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    mine = by_session(agents(), me) if me else None
    if mine and mine.get("kind") != "background":
        sys.exit("this is an interactive session: it lives in this terminal's cgroup and a watchdog resume of it would carry no "
                 "saved name/mode/model. Launch Whip as a bg session under the fleet's daemon unit instead:\n"
                 "  mise run whip -- daemon start && claude --bg -n whip --permission-mode bypassPermissions --model opus \"/whip\"\n"
                 "then `claude attach whip` (or Remote Control) to watch it.")
    if mine and mine.get("name") != "whip":
        sys.exit(f"this session is named {mine.get('name')!r}; leads report to the session named 'whip' — "
                 "`/rename whip`, then start again")
    import pwd
    user = pwd.getpwuid(os.getuid()).pw_name
    linger = sh(f"loginctl show-user {user} -p Linger").strip()
    if linger != "Linger=yes" and not a.linger_unchecked:
        sys.exit(f"{linger or 'Linger=?'} for {user}: without linger the watchdog timer and the fleet die at logout. "
                 "Run `loginctl enable-linger` and start again (or `start --linger-unchecked` if you know better).")
    print("OWNER, before you go to bed (Whip may not run these):")
    print(f"  {linger} (verified; `loginctl enable-linger` already done) — the timer and the fleet survive a logout")
    print("  keep the machine awake: `systemd-inhibit --what=idle:sleep --why=whip sleep infinity &`")
    print(f"  kill switch: `systemctl --user stop {DAEMON_UNIT} whip-watchdog.timer`")
    print()
    os.makedirs(HDIR, exist_ok=True)
    p = state_path(create=True)
    if os.path.exists(p):
        old = load(p); old["_path"] = p
        if not old.get("done"):
            sys.exit(f"a LIVE run is on disk: {p} (started {old.get('started')}). A start would inherit its dead trains and stale "
                     "Ready set. `mise run whip -- show` to see it; `mise run whip -- retire --force` to archive it, then start again.")
        print(f"previous run {p} was done — retired to {retire_ledger(old, 'start of a new run')}")
    if not ensure_daemon():
        sys.exit(f"daemon unit {DAEMON_UNIT} could not be started — nothing launched; see `systemctl --user status {DAEMON_UNIT}`")
    timer_install(a.every)
    ready = ready_issues()
    sha = sh("git rev-parse master", cwd=ROOT).strip()
    st = {"_path": p, "date": time.strftime("%Y-%m-%d"), "started": now(), "started_ts": time.time(),
          "cap_h": a.cap, "max_leads": a.max_leads, "start_sha": sha, "ready": [i["number"] for i in ready],
          "ready_titles": {str(i["number"]): i["title"] for i in ready},
          "trains": [], "leads": {}, "notes": [], "events": [], "dropped": [], "done": False,
          "pending": None, "failures": 0, "gave_up": None, "whip_session": me}
    if not a.no_issue:
        body = f"Overnight run started {st['started']} from master `{sha[:7]}` over {len(ready)} Ready issues: " + \
               " ".join(f"#{i['number']}" for i in ready) + "\n\nThe morning report lands here as a comment."
        out = sh(["gh", "issue", "create", "--title", f"Whip run {st['date']}", "--body", body, "--label", "tech-debt"])
        m = re.search(r"/issues/(\d+)", out)
        st["run_issue"] = int(m.group(1)) if m else None
    save(st); event(st, f"start: {len(ready)} Ready, master {sha[:7]}, cap {a.cap}h, leads ≤ {a.max_leads}, daemon {DAEMON_UNIT} up, timer every {a.every} min")
    print(open(p[:-5] + ".md").read())


def cmd_trains(a):
    st = current()
    if st["trains"] and not a.redo:
        print("\n".join(f"{t['name']}: {' '.join('#%d' % n for n in t['issues'])}" for t in st["trains"])); return
    ready = set(st["ready"]) - set(st.get("dropped", []))
    deps = {n: [b for b in blocked_by(n) if b in ready] for n in ready}
    # connected components over in-set dependencies
    seen, comps = set(), []
    for n in sorted(ready):
        if n in seen: continue
        comp, stack = [], [n]
        while stack:
            x = stack.pop()
            if x in seen: continue
            seen.add(x); comp.append(x)
            stack += deps[x] + [y for y in ready if x in deps[y]]
        # topological order inside the component
        order, left = [], set(comp)
        while left:
            free = sorted(y for y in left if not (set(deps[y]) & left))
            if not free: free = sorted(left)  # cycle: break it, the lead will see
            order += free; left -= set(free)
        comps.append(order)
    # singletons: group by milestone, at most a.size per train
    chains = [c for c in comps if len(c) > 1]
    singles = sorted((milestone_of(c[0]), c[0]) for c in comps if len(c) == 1)
    trains, cur, cur_ms = [], [], None
    for ms, n in singles:
        if cur and (ms != cur_ms or len(cur) >= a.size):
            trains.append(cur); cur = []
        cur.append(n); cur_ms = ms
    if cur: trains.append(cur)
    trains = chains + trains
    st["trains"] = [{"name": chr(97 + i), "issues": t, "state": "queued"} for i, t in enumerate(trains)]
    save(st); event(st, f"trains: {len(trains)}")
    cmd_trains(argparse.Namespace(redo=False))


def cmd_train(a):
    st = current()
    t = next((t for t in st["trains"] if t["name"] == a.train), None) or sys.exit("no such train")
    if a.verb == "split":
        k = int(a.arg)
        new = {"name": t["name"] + "2", "issues": t["issues"][k:], "state": "queued"}
        t["issues"] = t["issues"][:k]
        st["trains"].insert(st["trains"].index(t) + 1, new)
        save(st); event(st, f"train {a.train} split at {k}")
    else:
        n = int(a.arg)
        if n not in t["issues"]: sys.exit(f"#{n} not in train {a.train}")
        t["issues"].remove(n); st.setdefault("dropped", []).append(n)
        save(st); event(st, f"owner: dropped #{n} from train {a.train}")


def cmd_launch(a):
    st = current()
    if time.time() - st["started_ts"] > st["cap_h"] * 3600:
        event(st, f"launch {a.name} REFUSED: past the {st['cap_h']}h cap"); sys.exit(2)
    train = a.name.split("-")[1] if "-" in a.name else None
    ags = agents()
    live = next((x for x in ags if x.get("name") == a.name and session_state(x) != "gone"), None)
    if live and a.name in st["leads"]:
        print(f"{a.name} already running — not launched"); return
    if live:  # alive but unrecorded (a launch whose output we failed to parse): adopt, never launch twice
        return record_launch(st, a, train, live["sessionId"])
    if not (a.self or a.relief):
        running = [t["name"] for t in st["trains"] if t.get("state") == "running"]
        if len(running) >= st.get("max_leads", 1):
            event(st, f"launch {a.name} REFUSED: lead ceiling {st.get('max_leads', 1)} reached (running: {' '.join(running)})")
            sys.exit(f"ceiling: {len(running)} lead(s) running, max {st.get('max_leads', 1)} — the owner raises it with `mise run whip -- max-leads N`")
    if not ensure_daemon():
        event(st, f"launch {a.name} REFUSED: daemon unit {DAEMON_UNIT} not active")
        sys.exit(f"daemon unit {DAEMON_UNIT} is not active and could not be started — a --bg session without it would live in this shell's cgroup")
    mode = os.environ.get("WHIP_PERMISSION_MODE", "bypassPermissions")
    model = os.environ.get("WHIP_LEAD_MODEL", "opus")
    if a.self:
        prompt = (f"/whip — relief from {st['_path']}. You are the supervisor named 'whip'; messages from sessions "
                  "named lead-*/relief-* are the reports you act on; the watchdog's 'watchdog:' prompts are instructions.")
        model = os.environ.get("WHIP_MODEL", "opus")
    elif a.relief:
        outgoing = next((t.get("lead") for t in st["trains"] if t["name"] == train), None) or a.issues
        prompt = f"/relief — supervised by whip. You relieve the session named '{outgoing}'. {CLAUSES}"
    else:
        nums = " ".join(f"#{n}" for n in re.findall(r"\d+", a.issues))
        prompt = (f"/swarm {nums} — supervised by whip. You are a FRESH lead for train {train}, never relief, even if a "
                  f"swarm ledger from an earlier train tonight is on disk; append your rows to it. {CLAUSES}")
    got, out = bg(["claude", "--bg", "-n", a.name, "--permission-mode", mode, "--model", model, prompt])
    if not got:
        event(st, f"launch {a.name} FAILED: {out}"); sys.exit(2)
    sess = next((x["sessionId"] for x in agents() if x.get("name") == a.name), got)
    record_launch(st, a, train, sess)


def record_launch(st, a, train, sess):
    kind = "whip" if a.self else "relief" if a.relief else "lead"
    for t in st["trains"]:
        if t["name"] == train:
            if kind == "relief" and t.get("lead") in st["leads"]:
                st["leads"][t["lead"]]["state"] = "relieved"
            t["lead"] = a.name; t["state"] = "running"
    st["leads"][a.name] = {"session": sess, "kind": kind, "launched": now(), "state": "running", "issues": a.issues}
    if a.self: st["whip_session"] = sess
    save(st); event(st, f"launched {kind} {a.name} ({sess[:8]}) {a.issues}")
    print(f"launched {a.name} · session {sess[:8]} · now end your turn; its reports arrive as messages")


def cmd_max_leads(a):
    st = current(); st["max_leads"] = a.n; save(st)
    event(st, f"owner raised the lead ceiling to {a.n}"); print(f"leads ≤ {a.n}")


def cmd_claim(a):
    """The calling session becomes the Whip the watchdog watches and resumes."""
    st = current(); sess = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    if not sess: sys.exit("no CLAUDE_CODE_SESSION_ID — run from inside the whip session")
    st["whip_session"] = sess; save(st); event(st, f"claim: whip_session = {sess[:8]}")
    print(f"whip_session = {sess[:8]}")


def cmd_relieve_me(a):
    st = current(); st["relieve_whip"] = True; save(st)
    event(st, "whip asked for its own relief — watchdog will stop it and launch a fresh whip from this ledger")
    print("marker set: end your turn now and do nothing more")


def cmd_done(a):
    st = current()
    l = st["leads"].get(a.lead) or sys.exit("unknown lead")
    l["state"] = "done"; l["last"] = f"DONE {a.sha[:7]} {a.landed}"
    for t in st["trains"]:
        if t.get("lead") == a.lead: t["state"] = f"done {a.sha[:7]} {a.landed}"
    save(st); event(st, f"{a.lead} DONE {a.sha[:7]} {a.landed}")


def cmd_note(a):
    st = current(); st["notes"].append(f"{now()} {a.text}"); save(st); event(st, f"note: {a.text[:80]}")


def cmd_show(a):
    st = current(); print(open(st["_path"][:-5] + ".md").read())


def cmd_retire(a):
    """Archive the run on disk so the next `start` begins clean. A live run needs --force."""
    p = state_path()
    if not p:
        print("no whip run on disk"); return
    st = load(p); st["_path"] = p
    if not st.get("done") and not a.force:
        sys.exit(f"{p} is a LIVE run (started {st.get('started')}, not reported). `mise run whip -- report` first, "
                 "or `retire --force` to archive it as it stands.")
    timer_uninstall()
    print(f"retired to {retire_ledger(st, 'retire' + (' --force' if a.force else ''))}")


def remaining_ready(st):
    return [i["number"] for i in ready_issues() if i["number"] in set(st["ready"]) - set(st.get("dropped", []))]


def cmd_done_check(a):
    st = current(); bad = []
    rem = remaining_ready(st)
    noted = {int(m) for n in st["notes"] for m in re.findall(r"still-ready #(\d+)", n)}
    for n in rem:
        if n not in noted: bad.append(f"#{n} still Ready and not noted (whip -- note 'still-ready #{n}: <why>')")
    ags = agents()
    for name, l in st["leads"].items():
        if l["kind"] != "whip" and session_state(by_session(ags, l["session"])) != "gone":
            bad.append(f"{name} still running — retire it (claude stop/rm)")
    wts = sh("git worktree list --porcelain", cwd=ROOT).count("worktree ") - 1
    if wts: bad.append(f"{wts} worktree(s) still open (mise run worktree:ls)")
    hyg = sh("mise run --quiet gh-project -- hygiene", cwd=ROOT).strip()
    if hyg and "clean" not in hyg.lower(): bad.append("hygiene: " + hyg.splitlines()[0][:120])
    print("\n".join(bad) if bad else "done-check: clean"); sys.exit(1 if bad else 0)


def cmd_report(a):
    st = current()
    rem = set(remaining_ready(st)); start = st["start_sha"]; dropped = st.get("dropped", [])
    log = sh(f"git log --oneline {start}..master", cwd=ROOT).strip().splitlines()
    closes = {int(n) for n in re.findall(r"[Cc]loses #(\d+)", sh(f"git log {start}..master", cwd=ROOT))}
    landed = [n for n in st["ready"] if n in closes]
    nd = sh("mise run --quiet gh-project -- list needs-design --json", cwd=ROOT)
    try: nd = {i["number"] for i in json.loads(nd)}
    except json.JSONDecodeError: nd = set()
    back = [n for n in st["ready"] if n in nd and n not in dropped]
    capped = time.time() - st["started_ts"] > st["cap_h"] * 3600
    since = time.strftime("%Y-%m-%d", time.localtime(st["started_ts"]))
    filed = sh(f"gh issue list --search 'created:>={since}' --state all --json number,title --jq '.[] | \"#\\(.number) \\(.title)\"'").strip()
    owner = [n for n in st["notes"] if "needs owner" in n]
    inc = [e for e in st["events"] if re.search(r"relief|watchdog|REFUSED|FAILED|nudge|blocked|stalled|respawn|limit|GAVE UP|ceiling", e)]
    cost = sh("mise run --quiet agent-cost -- --latest 20", cwd=ROOT).strip().splitlines()[:25]
    T = lambda n: st["ready_titles"].get(str(n), "")
    head = (("GAVE UP · " if st.get("gave_up") else "") + ("CAPPED at %dh · " % st["cap_h"] if capped else "") +
            f"Landed {len(landed)}/{len(st['ready'])} · {len(log)} commits `{start[:7]}..master` · back to Needs design {len(back)} · "
            f"dropped {len(dropped)} · still Ready {len(rem)}")
    L = [f"# Whip report {st['date']}", "", f"**{head}**", "",
         "## Landed"] + [f"- #{n} {T(n)}" for n in landed] + ["", "## Back to Needs design"] + \
        [f"- #{n} {T(n)}" for n in back] + ["", "## Still Ready"] + \
        [f"- #{n} {T(n)}" + next((" — " + x.split(':', 2)[-1].strip() for x in st["notes"] if f"still-ready #{n}" in x), "") for n in sorted(rem)] + \
        ["", "## Dropped by the owner"] + ([f"- #{n} {T(n)}" for n in dropped] or ["- none"]) + \
        ["", "## Filed since start", filed or "- none", "", "## Needs the owner"] + ([f"- {o}" for o in owner] or ["- none"]) + \
        ["", "## Incidents"] + ([f"- {e}" for e in inc] or ["- none"]) + ["", "## Cost (agent-cost, latest 20)", "```"] + cost + ["```"]
    peak = st.get("tasks_peak")
    if peak: L[2] += f" · fleet tasks peak {peak}"
    out = os.path.join(HDIR, f"whip-report-{st['date']}.md")
    if os.path.exists(out) and st.get("report_path") != out:  # another run's report of this date: never overwrite it
        out = os.path.join(HDIR, f"whip-report-{st['date']}-{time.strftime('%H%M', time.localtime(st['started_ts']))}.md")
    with open(out, "w") as f: f.write("\n".join(L) + "\n")
    if st.get("run_issue"):
        sh(["gh", "issue", "comment", str(st["run_issue"]), "--body-file", out])
    st["done"] = True; st["report_path"] = out; save(st); event(st, f"report written {out}")
    open(st["_path"][:-5] + ".done", "w").write(now())
    timer_uninstall()
    print(out)


# ---------------------------------------------------------------- watchdog
def transcript_limited(session_id):
    """True if the session's last assistant message is an API-error marker; (flag, reset_epoch|None)."""
    slug = "-" + ROOT.strip("/").replace("/", "-")
    p = os.path.expanduser(f"~/.claude/projects/{slug}/{session_id}.jsonl")
    if not os.path.exists(p): return False, None
    last = None
    with open(p, errors="ignore") as f:
        for line in f:
            if '"type":"assistant"' in line: last = line
    if not last or '"isApiErrorMessage":true' not in last: return False, None
    m = re.search(r"resets? (\d{1,2}):(\d{2})\s*([ap]m)", last, re.I)
    if not m: return True, None
    h, mi, ap = int(m.group(1)), int(m.group(2)), m.group(3).lower()
    h = h % 12 + (12 if ap == "pm" else 0)
    t = time.localtime(); reset = time.mktime((t.tm_year, t.tm_mon, t.tm_mday, h, mi, 0, 0, 0, -1))
    if reset < time.time() - 600: reset += 86400
    return True, reset


def give_up(st, why):
    st["gave_up"] = f"{now()} {why}"; st["pending"] = None; save(st)
    event(st, f"watchdog: GAVE UP — {why}. Timer stopped; the fleet is as the ledger says. Owner: `mise run whip -- show`")
    open(st["_path"][:-5] + ".gave-up", "w").write(st["gave_up"] + "\n")
    sh("systemctl --user stop whip-watchdog.timer")
    if st.get("run_issue"):
        body = os.path.join(HDIR, f"whip-{st['date']}.gave-up.md")
        open(body, "w").write(f"Watchdog gave up at {now()}: {why}. Timer stopped. Ledger: `mise run whip -- show`.\n")
        sh(["gh", "issue", "comment", str(st["run_issue"]), "--body-file", body])


def cmd_watchdog(a):
    p = state_path()
    if not p: return
    st = load(p); st["_path"] = p
    if st.get("done") or os.path.exists(p[:-5] + ".done") or st.get("gave_up") or os.path.exists(p[:-5] + ".gave-up"): return
    capped = time.time() - st["started_ts"] > st["cap_h"] * 3600
    ags = agents()
    nudge_gap = int(os.environ.get("WHIP_NUDGE_MIN", "20")) * 60
    # 0. the fleet's task count — a field, never an event: the only measurement of what eats the pids budget
    m = re.search(r"TasksCurrent=(\d+)", sh(f"systemctl --user show {DAEMON_UNIT}.service -p TasksCurrent"))
    if m:
        st["tasks_last"] = int(m.group(1)); st["tasks_peak"] = max(st.get("tasks_peak") or 0, st["tasks_last"]); save(st)
    # 1. last tick's action: did it take?
    pend = st.get("pending")
    if pend:
        st["pending"] = None
        if session_state(by_session(ags, pend["session"])) != "gone":
            st["failures"] = 0; event(st, f"watchdog: {pend['action']} verified ({pend['session'][:8]} is back)")
        else:
            st["failures"] = st.get("failures", 0) + 1
            event(st, f"watchdog: {pend['action']} did not take — {pend['session'][:8]} still gone ({st['failures']}/{MAX_FAILURES})")
            if st["failures"] >= MAX_FAILURES:
                give_up(st, f"{MAX_FAILURES} consecutive '{pend['action']}' actions left {pend['session'][:8]} gone"); return
    # 2. lead liveness from the ledger — whip or no whip
    for name, l in st["leads"].items():
        if l["kind"] != "whip" and l["state"] == "running":
            s = session_state(by_session(ags, l["session"]))
            if s in ("gone", "blocked"):
                l["state"] = f"stalled ({s})"; event(st, f"watchdog: {name} is {s} — stalled; whip must relieve it")
            elif s == "idle" and not capped and time.time() - l.get("last_nudge_ts", 0) > nudge_gap:
                # a lead at a spent window is idle, not stalled: nobody but this tick will ever prompt it
                limited, reset = transcript_limited(l["session"])
                if limited and (reset is None or time.time() >= reset):
                    l["last_nudge_ts"] = time.time()
                    prompt_session(st, l["session"], "the window reset — read your ledger (docs/handoffs/swarm-<date>.md) and continue your "
                                   "swarm; drones that died with the window are re-dispatched from the ledger. Still supervised by whip.",
                                   f"window reset for {name}")
    stalled = [n for n, l in st["leads"].items() if l["kind"] != "whip" and l["state"].startswith("stalled")]
    stall_line = f" Lead(s) {' '.join(stalled)} are stalled (gone or asked a human) — relieve per the whip skill." if stalled else ""
    whip = whip_entry(st, ags); ws = session_state(whip)
    wsess = (whip or {}).get("sessionId") or st.get("whip_session")
    last_nudge = st.get("last_nudge_ts", 0)
    # 3. whip gone → resume it, verified next tick
    if ws == "gone":
        if capped:
            if not st.get("cap_noted"): st["cap_noted"] = True; event(st, f"watchdog: CAPPED at {st['cap_h']}h and whip gone — no resume; run `mise run whip -- report`")
            return
        if wsess:
            prompt_session(st, wsess, "watchdog: resume — you are whip; `mise run whip -- show`, then continue." + stall_line, "resume whip")
        return
    # 4. whip asked for its own relief
    if st.get("relieve_whip") and ws in ("idle", "blocked") and not capped:
        if not ensure_daemon(): event(st, "watchdog: self-relief waits — daemon unit not active"); return
        sh(["claude", "stop", wsess]); SLEEP(3)
        st["relieve_whip"] = False; save(st)
        unlock()  # the child verb takes the ledger lock itself
        subprocess.run([sys.executable, __file__, "launch", "whip", "", "--self"], cwd=ROOT)
        lock()
        st = load(p); st["_path"] = p
        st["pending"] = {"action": "self-relief", "session": st.get("whip_session", ""), "ts": time.time()}
        event(st, "watchdog: stopped the old whip, launched a fresh one from the ledger"); return
    # 5. whip at its prompt: a spent window, a stalled lead, or a question nobody will answer
    if ws in ("idle", "blocked") and not capped:
        limited, reset = transcript_limited(wsess)
        due_gap = time.time() - last_nudge > nudge_gap
        if limited:
            due = (reset is not None and time.time() >= reset) or (reset is None and due_gap)
            if due:
                st["last_nudge_ts"] = time.time()
                prompt_session(st, wsess, "watchdog: the window reset — `mise run whip -- show`, then continue." + stall_line,
                               f"window reset ({time.strftime('%H:%M', time.localtime(reset)) if reset else 'unparsed'})")
        elif stalled and due_gap:
            st["last_nudge_ts"] = time.time()
            prompt_session(st, wsess, "watchdog:" + stall_line, f"stalled {' '.join(stalled)}")
        elif ws == "blocked" and due_gap:
            st["last_nudge_ts"] = time.time()
            prompt_session(st, wsess, "watchdog: no human is awake — answer your own question from the ledger and continue.", "whip blocked")
    elif capped and not st.get("cap_noted"):
        st["cap_noted"] = True; event(st, f"watchdog: CAPPED at {st['cap_h']}h — no more prompts; run `mise run whip -- report`")
    # 6. binary drift → respawn when everything is idle
    ver = sh("claude --version").strip().split()[0]
    if st.get("cli_version") and st["cli_version"] != ver and all(session_state(x) in ("idle", "gone") for x in ags):
        sh("claude respawn --all"); event(st, f"watchdog: CLI {st['cli_version']}→{ver}, respawned all"); st["cli_version"] = ver; save(st)
    elif not st.get("cli_version"):
        st["cli_version"] = ver; save(st)


# ---------------------------------------------------------------- units
UNIT = """[Unit]
Description=Whip watchdog (overnight swarm supervisor)
[Service]
Type=oneshot
WorkingDirectory={root}
Environment=PATH={path}
ExecStart={mise} run --quiet whip -- watchdog
"""
TIMER = """[Unit]
Description=Whip watchdog every {m} min
[Timer]
OnBootSec=2min
OnUnitActiveSec={m}min
[Install]
WantedBy=timers.target
"""


def timer_install(every):
    os.makedirs(UNIT_DIR, exist_ok=True)
    mise = sh("command -v mise").strip()
    open(f"{UNIT_DIR}/whip-watchdog.service", "w").write(UNIT.format(root=ROOT, path=os.environ.get("PATH", ""), mise=mise))
    open(f"{UNIT_DIR}/whip-watchdog.timer", "w").write(TIMER.format(m=every))
    sh("systemctl --user daemon-reload && systemctl --user enable --now whip-watchdog.timer", check=True)
    print(f"watchdog timer installed, every {every} min")


def timer_uninstall():
    sh("systemctl --user disable --now whip-watchdog.timer")
    for f in ("whip-watchdog.service", "whip-watchdog.timer"):
        try: os.remove(f"{UNIT_DIR}/{f}")
        except FileNotFoundError: pass
    print("watchdog timer removed")


def cmd_timer(a):
    if a.action != "install":
        return timer_uninstall()
    timer_install(a.every)
    p = state_path()
    if p and (load(p).get("gave_up") or os.path.exists(p[:-5] + ".gave-up")):  # the morning restart after a give-up
        st = load(p); st["_path"] = p; st["gave_up"] = None; st["failures"] = 0; st["pending"] = None
        try: os.remove(p[:-5] + ".gave-up")
        except FileNotFoundError: pass
        event(st, "timer reinstalled after a give-up — watchdog resumes")


def cmd_daemon(a):
    if a.action == "start":
        print(f"{DAEMON_UNIT}: {'active' if ensure_daemon() else 'FAILED to start'}")
    elif a.action == "stop":
        sh(f"systemctl --user stop {DAEMON_UNIT}.service"); print(f"{DAEMON_UNIT} stopped — every bg session under it is gone")
    else:
        print(f"{DAEMON_UNIT}: {sh(f'systemctl --user is-active {DAEMON_UNIT}.service').strip()}")
        print(sh("claude daemon status").strip())



    s = sp.add_parser("needs-owner", help="(lead) after a Needs design move"); s.add_argument("--lead"); s.add_argument("n", type=int); s.add_argument("line"); s.set_defaults(f=cmd_needs_owner)
    s = sp.add_parser("note"); s.add_argument("text"); s.set_defaults(f=cmd_note)
    sp.add_parser("show").set_defaults(f=cmd_show)
    sp.add_parser("done-check").set_defaults(f=cmd_done_check)
    sp.add_parser("report").set_defaults(f=cmd_report)
    sp.add_parser("watchdog").set_defaults(f=cmd_watchdog)

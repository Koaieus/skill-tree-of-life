def transcript_limited(session_id):
    """True if the session's last assistant message is an API-error marker; (flag, reset_epoch|None)."""
    slug = "-" + ROOT.strip("/").replace("/", "-")
    p = os.path.expanduser(f"~/.claude/projects/{slug}/{session_id}.jsonl")
    if not os.path.exists(p): return False, None
    last = None
    with open(p, errors="ignore") as f:
        for line in f:
            if '"type":"assistant"' in line: last = line
    if not last or '"isApiErrorMessage":true' not in last: return False, None
    m = re.search(r"resets? (\d{1,2}):(\d{2})\s*([ap]m)", last, re.I)
    if not m: return True, None
    h, mi, ap = int(m.group(1)), int(m.group(2)), m.group(3).lower()
    h = h % 12 + (12 if ap == "pm" else 0)
    t = time.localtime(); reset = time.mktime((t.tm_year, t.tm_mon, t.tm_mday, h, mi, 0, 0, 0, -1))
    if reset < time.time() - 600: reset += 86400
    return True, reset


def silent(st, l):
    """Law 30: no activity of the lead's own, no swarm-ledger write, no commit, no worktree mtime for stall_minutes."""
    since = time.time() - st.get("stall_minutes", 45) * 60
    if max(l.get("launched_ts", 0), l.get("last_ts", 0)) >= since: return False
    for p in glob.glob(os.path.join(HDIR, "swarm-*.md")):
        if os.path.getmtime(p) >= since: return False
    ts = sh("git for-each-ref --sort=-committerdate --count=1 --format=%(committerdate:unix)", cwd=ROOT).strip()
    if ts.isdigit() and int(ts) >= since: return False
    wts = os.path.join(ROOT, ".worktrees")
    if os.path.isdir(wts) and sh(["find", wts, "-mindepth", "1", "(", "-name", ".godot", "-o", "-name", ".git", ")", "-prune",
                                  "-o", "-newermt", f"@{int(since)}", "-print", "-quit"]).strip():
        return False
    return True


def give_up(st, why):
    st["gave_up"] = f"{now()} {why}"; st["pending"] = []; st["requests"] = []; save(st)
    event(st, f"watchdog: GAVE UP — {why}. Timer stopped; the fleet is as the ledger says. Owner: `mise run whip -- show`")
    open(st["_path"][:-5] + ".gave-up", "w").write(st["gave_up"] + "\n")
    sh("systemctl --user stop whip-watchdog.timer")
    if st.get("run_issue"):
        body = os.path.join(HDIR, f"whip-{st['date']}.gave-up.md")
        open(body, "w").write(f"Watchdog gave up at {now()}: {why}. Timer stopped. Ledger: `mise run whip -- show`.\n")
        sh(["gh", "issue", "comment", str(st["run_issue"]), "--body-file", body])


def stall(st, name, l, how):
    l["state"] = f"stalled ({how})"
    event(st, f"watchdog: {name} is {how} — stalled")
    if how != "gone" and not stop_session(l["session"]):
        st["failures"] = st.get("failures", 0) + 1
        l["state"] = "running"  # retried next tick; the strikes bound it
        event(st, f"watchdog: {name} did not stop — strike {st['failures']}/{MAX_FAILURES}, no relief this tick"); return
    request_relief(st, l.get("train"), f"{name} stalled ({how})")


def tick():
    p = state_path()
    if not p: return
    st = load(p); st["_path"] = p
    if st.get("done") or os.path.exists(p[:-5] + ".done") or st.get("gave_up") or os.path.exists(p[:-5] + ".gave-up"): return
    m = re.search(r"TasksCurrent=(\d+)", sh(f"systemctl --user show {DAEMON_UNIT}.service -p TasksCurrent"))
    if m:
        st["tasks_last"] = int(m.group(1)); st["tasks_peak"] = max(st.get("tasks_peak") or 0, st["tasks_last"]); save(st)
    ags = agents()
    # 1. last tick's actions: did they take?
    pend, st["pending"] = st.get("pending", []), []
    for pd in pend:
        if session_state(by_session(ags, pd["session"])) != "gone":
            st["failures"] = 0
            if pd["name"] in st["leads"]: st["leads"][pd["name"]]["verified"] = True
            event(st, f"watchdog: {pd['action']} verified ({pd['session'][:8]} present)")
        else:
            st["failures"] = st.get("failures", 0) + 1
            event(st, f"watchdog: {pd['action']} did not take — {pd['session'][:8]} gone ({st['failures']}/{MAX_FAILURES})")
    if st.get("failures", 0) >= MAX_FAILURES:
        give_up(st, f"{MAX_FAILURES} consecutive actions did not take (last: {pend[-1]['action'] if pend else '?'})"); return
    # 2. the verbs' requests (launches, prompts, stops) — the one launcher
    perform_requests(st)
    ags = agents()
    nudge_gap = int(os.environ.get("WHIP_NUDGE_MIN", "20")) * 60
    # 3. liveness of every lead, from the ledger
    for name, l in list(st["leads"].items()):
        s = session_state(by_session(ags, l["session"]))
        if l["state"] in ("done", "failed") and s != "gone" and time.time() - l.get("last_ts", 0) > RETIRE_GRACE:
            if stop_session(l["session"]): l["state"] = f"{l['state']} (retired)"; event(st, f"watchdog: retired {name} ({l['state'].split()[0]}, still present)")
            continue
        if l["state"] != "running" or not l.get("verified"): continue
        if s == "busy": l["last_ts"] = time.time(); continue
        if s == "waiting": continue
        if s in ("gone", "blocked"):
            stall(st, name, l, s); continue
        limited, reset = transcript_limited(l["session"])
        if limited:
            if (reset is None or time.time() >= reset) and not capped(st) and time.time() - l.get("last_nudge_ts", 0) > nudge_gap:
                l["last_nudge_ts"] = time.time()
                prompt_session(st, name, l["session"], "the window reset — read your ledger (`mise run ledger -- show`) and continue your "
                               f"swarm; drones that died with the window are re-dispatched from the ledger. Whip relay, train {l.get('train')}, unchanged.",
                               f"window reset for {name}")
            continue
        if silent(st, l):
            stall(st, name, l, "silent")
    if st.get("failures", 0) >= MAX_FAILURES:
        give_up(st, f"{MAX_FAILURES} consecutive strikes"); return
    perform_requests(st)
    if capped(st) and not st.get("cap_noted"):
        st["cap_noted"] = True; event(st, f"watchdog: CAPPED at {st['cap_h']}h — nothing launches; leads in flight finish their train")
    maybe_end_run(st)
    if st.get("done"): return
    # 4. binary drift → respawn when everything is idle
    ver = sh("claude --version").strip().split()[0]
    if st.get("cli_version") and st["cli_version"] != ver and all(session_state(x) in ("idle", "gone") for x in ags):
        sh("claude respawn --all"); event(st, f"watchdog: CLI {st['cli_version']}→{ver}, respawned all"); st["cli_version"] = ver; save(st)
    elif not st.get("cli_version"):
        st["cli_version"] = ver; save(st)


def cmd_watchdog(a):
    refuse_in_tree("watchdog")
    tick()


# ---------------------------------------------------------------- units
UNIT = """[Unit]
Description=Whip watchdog (overnight relay of swarms)
[Service]
Type=oneshot
WorkingDirectory={root}
Environment=PATH={path}
ExecStart={mise} run --quiet whip -- watchdog
"""
TIMER = """[Unit]
Description=Whip watchdog every {m} min
[Timer]
OnBootSec=2min
OnUnitActiveSec={m}min
[Install]
WantedBy=timers.target
"""


def timer_install(every):
    os.makedirs(UNIT_DIR, exist_ok=True)
    mise = sh("command -v mise").strip()
    open(f"{UNIT_DIR}/whip-watchdog.service", "w").write(UNIT.format(root=ROOT, path=os.environ.get("PATH", ""), mise=mise))
    open(f"{UNIT_DIR}/whip-watchdog.timer", "w").write(TIMER.format(m=every))
    sh("systemctl --user daemon-reload && systemctl --user enable --now whip-watchdog.timer", check=True)
    print(f"watchdog timer installed, every {every} min")


def timer_uninstall():
    """Returns the unit files it removed, so the caller can announce the teardown."""
    sh("systemctl --user disable --now whip-watchdog.timer")
    removed = []
    for f in ("whip-watchdog.timer", "whip-watchdog.service"):
        try: os.remove(f"{UNIT_DIR}/{f}"); removed.append(f)
        except FileNotFoundError: pass
    return removed


def cmd_timer(a):
    refuse_in_tree("timer")
    if a.action != "install":
        print("removed: " + (" ".join(timer_uninstall()) or "nothing")); return
    timer_install(a.every)
    p = state_path()
    if p and (load(p).get("gave_up") or os.path.exists(p[:-5] + ".gave-up")):  # the morning restart after a give-up
        st = load(p); st["_path"] = p; st["gave_up"] = None; st["failures"] = 0; st["pending"] = []
        try: os.remove(p[:-5] + ".gave-up")
        except FileNotFoundError: pass
        event(st, "timer reinstalled after a give-up — watchdog resumes")


def cmd_daemon(a):
    refuse_in_tree("daemon")
    if a.action == "start":
        print(f"{DAEMON_UNIT}: {'active' if ensure_daemon() else 'FAILED to start'}")
    elif a.action == "stop":
        sh(f"systemctl --user stop {DAEMON_UNIT}.service"); print(f"{DAEMON_UNIT} stopped — every bg session under it is gone")
    else:
        print(f"{DAEMON_UNIT}: {sh(f'systemctl --user is-active {DAEMON_UNIT}.service').strip()}")
        print(sh("claude daemon status").strip())


def tick_minutes(v):
    n = int(v)
    if not 15 <= n <= 55:
        raise argparse.ArgumentTypeError(f"{n} is outside [15, 55] — the tick must land inside the one-hour prompt-cache lifetime")
    return n



def cmd_launch(a):
    """The owner's manual launch (`lead-<t>` or `relief-<t>-<k>`); the relay's own launches go through done/relieve-me."""
    refuse_in_tree("launch")
    st = current()
    if capped(st):
        event(st, f"launch {a.name} REFUSED: past the {st['cap_h']}h cap"); sys.exit(f"past the {st['cap_h']}h cap — nothing launches")
    if st.get("stopped"):
        sys.exit("the owner stopped the run — nothing launches")
    train = a.name.split("-")[1] if "-" in a.name else None
    t = train_of(st, train) or sys.exit(f"no train {train!r} in {a.name}")
    if a.relief:
        if not request_relief(st, train, f"owner launch {a.name}"): sys.exit(2)
    else:
        if a.name in st["leads"] and st["leads"][a.name]["state"] == "running":
            print(f"{a.name} already running — not launched"); return
        running = running_trains(st)
        if len(running) >= st.get("max_leads", 1):
            event(st, f"launch {a.name} REFUSED: lead ceiling {st.get('max_leads', 1)} reached (running: {' '.join(running)})")
            sys.exit(f"ceiling: {len(running)} lead(s) running, max {st.get('max_leads', 1)} — the owner raises it with `mise run whip -- max-leads N`")
        t["state"] = "running"; t["lead"] = a.name
        request(st, kind="launch", name=a.name, train=train)
    kick_watchdog()
    st = current()
    print(f"{a.name}: {'launched · session ' + st['leads'][a.name]['session'][:8] if a.name in st['leads'] else 'left for the next tick (see the ledger events)'}")



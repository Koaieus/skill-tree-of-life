#!/usr/bin/env python3
#MISE description="Whip, the overnight run's ledger + verbs for swarm-train's tree of subagent leads. `mise run whip -- start [--cap H] [--size N|all] [--max-leads N] [--stall-minutes M] [--tick-minutes 15..55] | show | stop [--now] | note '…' | trains [--size N|all] | train split|drop|add | max-leads N | next-train --lead L | done --lead L <sha> <n/m> | relieve --lead L | drained --lead L | needs-owner --lead L <n> '<line>' | done-check | report | retire [--force]`"
"""
State for one overnight run lives in docs/handoffs/whip-<date>.json
(gitignored); every write renders the human ledger whip-<date>.md next to
it. The run is one top session driving subagent leads (swarm-train): the
top takes trains with `next-train --lead <name>` and names the lead on
`done`/`relieve`/`drained`/`needs-owner --lead` (subagents share its
session id, so no verb keys on the caller's session). Nothing here starts
a process: no daemon, timer, linger or `claude` call. The ledger's
`transport: tree` field and `start --tree` remain for compatibility; the
tree is the only transport. Design: docs/charters/swarm-train.md.

Exit 0 on every no-op; non-zero only on a usage error or a refusal.
"""
import argparse, glob, json, os, re, shutil, subprocess, sys, time

ROOT = os.environ.get("MISE_PROJECT_ROOT") or os.getcwd()
HDIR = os.path.join(ROOT, "docs", "handoffs")
REPO = "Koaieus/skill-tree-of-life"
LIVE_HOURS = 36
MAX_RELIEFS = 2       # per train; a third launch fails the train instead
SLEEP = time.sleep
ANSI = re.compile(r"\x1b\[[0-9;]*m")


def now():
    return time.strftime("%Y-%m-%d %H:%M")


def sh(cmd, check=False, **kw):
    r = subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True, text=True, **kw)
    if check and r.returncode:
        sys.exit(f"{cmd}: {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout


# ---------------------------------------------------------------- ledger
def state_path(create=False):
    """The one ledger on disk: today's if it exists (done or not — `start` is the verb that
    retires a done one), else the newest live one of the last LIVE_HOURS, else today's to create."""
    today = os.path.join(HDIR, f"whip-{time.strftime('%Y-%m-%d')}.json")
    if os.path.exists(today):
        return today
    live = [p for p in glob.glob(os.path.join(HDIR, "whip-20*.json"))
            if time.time() - os.path.getmtime(p) <= LIVE_HOURS * 3600 and not load(p).get("done")]
    if live:
        return max(live, key=os.path.getmtime)
    return today if create else None


def load(p):
    """An older ledger (v1, or the retired relay's: pending/requests/failures fields) still loads; they are ignored."""
    with open(p) as f:
        st = json.load(f)
    for t in st.get("trains", []): t.setdefault("reliefs", 0); t.setdefault("lead", None)
    return st


def save(st):
    with open(st["_path"], "w") as f:
        json.dump({k: v for k, v in st.items() if k != "_path"}, f, indent=1)
    render(st)


def recent_path():
    """The newest ledger of the last LIVE_HOURS, done or not — `show` across midnight reads last night's run."""
    ps = [p for p in glob.glob(os.path.join(HDIR, "whip-20*.json")) if time.time() - os.path.getmtime(p) <= LIVE_HOURS * 3600]
    return max(ps, key=os.path.getmtime) if ps else None


def current(any_recent=False):
    p = state_path() or (recent_path() if any_recent else None)
    if not p:
        print("no whip run on disk"); sys.exit(0)
    st = load(p); st["_path"] = p
    return st


_LOCK = None


def lock(timeout=60):
    """One writer at a time: the top's verbs and the owner's all load→modify→save the ledger. Held for the process."""
    global _LOCK
    if _LOCK: return  # re-entrant within one process (the selftest drives main() repeatedly)
    import fcntl
    os.makedirs(HDIR, exist_ok=True)
    _LOCK = open(os.path.join(HDIR, ".whip.lock"), "w")
    deadline = time.time() + timeout
    while True:
        try:
            fcntl.flock(_LOCK, fcntl.LOCK_EX | fcntl.LOCK_NB); return
        except OSError:
            if time.time() > deadline: sys.exit(f"whip ledger locked for {timeout}s by another whip verb — try again")
            SLEEP(1)


def unlock():
    global _LOCK
    if _LOCK:
        import fcntl
        fcntl.flock(_LOCK, fcntl.LOCK_UN); _LOCK.close(); _LOCK = None


def retire_ledger(st, why):
    """Move the run's json/md/markers into handoffs/archive/, suffixed with the start time so two
    runs on one date never collide. The tracked whip-report-* stays. Returns the archive stem."""
    arch = os.path.join(HDIR, "archive"); os.makedirs(arch, exist_ok=True)
    stem = os.path.join(arch, f"whip-{st['date']}-{time.strftime('%H%M', time.localtime(st['started_ts']))}")
    k = 1
    while os.path.exists(stem + ".json"):
        k += 1; stem = stem.rsplit("-", 1)[0] + f"-{k}" if k > 2 else stem + "-2"
    event(st, f"retired: {why}")
    base = st["_path"][:-5]
    for ext in (".json", ".md", ".done", ".gave-up"):
        if os.path.exists(base + ext):
            shutil.move(base + ext, stem + ext)
    return stem


def event(st, line):
    st["events"].append(f"{now()} " + ANSI.sub("", line).replace("\n", " ⏎ "))
    save(st)


def capped(st):
    return time.time() - st["started_ts"] > st["cap_h"] * 3600


def train_of(st, name):
    return next((t for t in st["trains"] if t["name"] == name), None)


def warnings(st):
    w = []
    if st.get("stopped"): w.append(f"STOPPED by the owner {st['stopped'][-5:]}")
    if capped(st): w.append(f"CAPPED at {st['cap_h']}h")
    failed = [t["name"] for t in st["trains"] if t.get("state") == "failed"]
    if failed: w.append(f"FAILED train(s) {' '.join(failed)} (relief cap)")
    return w


def wasted_turns(st):
    """Notes are `<date> <time> <text>`; a scheduled wake that found its run finished notes `wasted: <wake id>`."""
    return sum(1 for n in st["notes"] if n.split(" ", 2)[-1].startswith("wasted:"))


def render(st):
    md = st["_path"][:-5] + ".md"
    L = [f"# Whip {st['date']} — ledger (gitignored; the top and its reliefs read this)",
         f"Start: master `{st['start_sha'][:7]}` · run issue #{st.get('run_issue', '?')} · cap {st['cap_h']}h · "
         f"leads ≤ {st.get('max_leads', 1)} · stall {st.get('stall_minutes', 45)} min · "
         f"tree · tick {st.get('tick_minutes', 45)} min · started {st['started']} · "
         f"{'DONE' if st.get('done') else 'live'}" + "".join(f" · {w}" for w in warnings(st)),
         "", "## Trains", "| train | issues | lead | reliefs | state |", "|---|---|---|---|---|"]
    for t in st["trains"]:
        L.append(f"| {t['name']} | {' '.join('#%d' % n for n in t['issues'])} | {t.get('lead') or '-'} | {t.get('reliefs', 0)} | {t.get('state', 'queued')} |")
    if st.get("dropped"):
        L.append(f"Dropped by the owner: {' '.join('#%d' % n for n in st['dropped'])}")
    L += ["", "## Leads", "| name | session | kind | train | launched | state | last |", "|---|---|---|---|---|---|---|"]
    for n, l in st["leads"].items():
        L.append(f"| {n} | {l['session'][:8]} | {l['kind']} | {l.get('train', '-')} | {l['launched']} | {l['state']} | {l.get('last', '')} |")
    if wasted_turns(st): L += ["", f"Wasted top turns: {wasted_turns(st)}"]
    L += ["", "## Notes"] + [f"- {n}" for n in st["notes"]] + ["", "## Events"] + [f"- {e}" for e in st["events"][-60:]]
    with open(md, "w") as f:
        f.write("\n".join(L) + "\n")


# ---------------------------------------------------------------- board + git
def ready_issues():
    out = sh("mise run --quiet gh-project -- list ready --json", cwd=ROOT)
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        sys.exit("gh-project list ready --json did not return JSON")


def board_lane(lane):
    out = sh(f"mise run --quiet gh-project -- list {lane} --json", cwd=ROOT)
    try: return {i["number"] for i in json.loads(out)}
    except (json.JSONDecodeError, TypeError, KeyError): return set()


def blocked_by(n):
    out = sh(f"gh api repos/{REPO}/issues/{n}/dependencies/blocked_by --jq '.[].number'")
    return [int(x) for x in out.split()]


def title_of(n):
    return sh(f"gh issue view {n} --json title --jq .title").strip()


def milestone_of(n):
    out = sh(f"gh issue view {n} --json milestone --jq '.milestone.title // \"\"'")
    return out.strip()


# ---------------------------------------------------------------- the relay
def running_trains(st):
    return [t["name"] for t in st["trains"] if t.get("state") == "running"]


def pass_baton(st):
    """Launches nothing: the top takes the next train with `next-train`. Refill from Ready, then: is the run over?"""
    refill(st); maybe_end_run(st)


def refill(st):
    """Tree: the watch ends when Ready is empty, not when the snapshot is — with no train queued or running,
    issues that turned Ready since the snapshot (never a drop) become new trains. Stop and the cap still end it."""
    if st.get("stopped") or capped(st) or any(t.get("state") in ("queued", "running") for t in st["trains"]): return
    seen = set(st["ready"]) | set(st.get("dropped", []))
    fresh = [i for i in ready_issues() if i["number"] not in seen]
    if not fresh: return
    for i in fresh:
        st["ready"].append(i["number"]); st["ready_titles"][str(i["number"])] = i["title"]
    compute_trains(st, st.get("size", 4), [i["number"] for i in fresh])


def request_relief(st, train, why):
    """A relief for a train, bounded by MAX_RELIEFS; the third fails the train and moves the baton."""
    t = train_of(st, train)
    if not t: return False
    if st.get("stopped") or capped(st):
        event(st, f"train {train}: no relief ({'owner stop' if st.get('stopped') else 'past the cap'}) — {why}")
        maybe_end_run(st); return False
    if t.get("reliefs", 0) >= MAX_RELIEFS:
        t["state"] = "failed"
        l = st["leads"].get(t.get("lead"))
        if l and l["state"] == "running": l["state"] = "failed"
        event(st, f"train {train} FAILED: a third relief is refused ({why}); its issues fall into Orphaned In progress")
        pass_baton(st); return False
    t["reliefs"] = t.get("reliefs", 0) + 1
    name = f"relief-{train}-{t['reliefs']}"
    t["outgoing"] = t.get("lead"); t["lead"] = name; t["state"] = "running"
    out = st["leads"].get(t["outgoing"])  # the top spawns the relief subagent; the ledger only records it
    if out and out["state"] == "running": out["state"] = "draining"  # still lands its in-flight drones; `drained` closes it
    tree_lead(st, name, train, relief=True)
    event(st, f"relief {name} recorded for the top to spawn: {why}")
    return True


def maybe_end_run(st):
    if st.get("done"): return
    if any(l["state"] in ("running", "draining") for l in st["leads"].values()): return
    if any(t.get("state") == "queued" for t in st["trains"]) and not st.get("stopped") and not capped(st): return
    end_run(st)


def end_run(st):
    """Law 25: what the done-check finds untrue and cannot fix goes into the report, never to a human."""
    noted = {int(m) for n in st["notes"] for m in re.findall(r"still-ready #(\d+)", n)}
    for n in remaining_ready(st):
        if n not in noted:
            st["notes"].append(f"{now()} still-ready #{n}: not reached (run ended: " + ("owner stop" if st.get("stopped") else "cap" if capped(st) else "no lead left") + ")")
    wts = sh("git worktree list --porcelain", cwd=ROOT).count("worktree ") - 1
    if wts > 0: st["notes"].append(f"{now()} {wts} worktree(s) still open at the end (mise run worktree:ls)")
    save(st)
    write_report(st)


def tree_lead(st, name, train, relief=False):
    """A tree lead's row: no session of its own (every subagent shares the top's id)."""
    st["leads"][name] = {"session": "", "kind": "relief" if relief else "lead", "train": train, "launched": now(),
                         "launched_ts": time.time(), "last_ts": time.time(), "state": "running", "verified": True}
    save(st)


def named_lead(st, a, verb, states=("running", "draining")):
    """The top names the lead (`--lead`): every subagent shares its session id, so no verb keys on the caller."""
    if not getattr(a, "lead", None):
        sys.exit(f"{verb}: usage — `whip -- {verb} --lead <name> …` (the top names the lead)")
    l = st["leads"].get(a.lead)
    if not l or l["state"] not in states:
        sys.exit(f"{verb}: {a.lead} is no {'/'.join(states)} lead in the ledger ({l['state'] if l else 'unknown'})")
    l["last_ts"] = time.time()
    return a.lead, l


# ---------------------------------------------------------------- verbs: console
def size_arg(v):
    return "all" if v == "all" else int(v)


def compute_trains(st, size=4, issues=None):
    """`size` is a singleton cap per train, or "all": every issue in ONE train, uncut. Trains over `issues` (default: the snapshot minus drops), appended after any trains already named."""
    ready = set(st["ready"]) - set(st.get("dropped", [])) if issues is None else set(issues)
    deps = {n: [b for b in blocked_by(n) if b in ready] for n in ready}
    seen, comps = set(), []
    for n in sorted(ready):
        if n in seen: continue
        comp, stack = [], [n]
        while stack:
            x = stack.pop()
            if x in seen: continue
            seen.add(x); comp.append(x)
            stack += deps[x] + [y for y in ready if x in deps[y]]
        order, left = [], set(comp)
        while left:
            free = sorted(y for y in left if not (set(deps[y]) & left))
            if not free: free = sorted(left)  # cycle: break it, the lead will see
            order += free; left -= set(free)
        comps.append(order)
    chains = [c for c in comps if len(c) > 1]
    singles = sorted((milestone_of(c[0]), c[0]) for c in comps if len(c) == 1)
    if size == "all":
        trains = [[n for c in comps for n in c]] if comps else []
        singles = []
    trains, cur, cur_ms = trains if size == "all" else [], [], None
    for ms, n in singles:
        if cur and (ms != cur_ms or len(cur) >= size):
            trains.append(cur); cur = []
        cur.append(n); cur_ms = ms
    if cur: trains.append(cur)
    if size != "all": trains = chains + trains
    taken = set() if issues is None else {t["name"] for t in st["trains"]}
    names = (c for c in (chr(97 + i) for i in range(26)) if c not in taken)
    new = [{"name": next(names), "issues": t, "state": "queued", "lead": None, "reliefs": 0} for t in trains]
    st["trains"] = new if issues is None else st["trains"] + new
    save(st); event(st, f"trains: {len(trains)}" if issues is None else f"refill from Ready: {' '.join(t['name'] + ' ' + ' '.join('#%d' % n for n in t['issues']) for t in new)}")


def cmd_start(a):
    os.makedirs(HDIR, exist_ok=True)
    p = state_path(create=True)
    if os.path.exists(p):
        old = load(p); old["_path"] = p
        if not old.get("done"):
            sys.exit(f"a LIVE run is on disk: {p} (started {old.get('started')}). A start would inherit its trains and stale "
                     "Ready set. `mise run whip -- show` to see it; `mise run whip -- retire --force` to archive it, then start again.")
        print(f"previous run {p} was done — retired to {retire_ledger(old, 'start of a new run')}")
    ready = ready_issues()
    sha = sh("git rev-parse master", cwd=ROOT).strip()
    st = {"_path": p, "date": time.strftime("%Y-%m-%d"), "started": now(), "started_ts": time.time(),
          "cap_h": a.cap, "max_leads": a.max_leads, "stall_minutes": a.stall_minutes, "start_sha": sha,
          "ready": [i["number"] for i in ready], "ready_titles": {str(i["number"]): i["title"] for i in ready},
          "trains": [], "leads": {}, "notes": [], "events": [], "dropped": [], "done": False, "stopped": None,
          "console": os.environ.get("CLAUDE_CODE_SESSION_ID", ""), "transport": "tree", "tick_minutes": a.tick_minutes}
    save(st)
    event(st, f"start (tree): {len(ready)} Ready, master {sha[:7]}, cap {a.cap}h, stall {a.stall_minutes} min, tick {a.tick_minutes} min")
    size = a.size if a.size is not None else "all"
    st["size"] = size
    compute_trains(st, size)
    if not a.no_issue:
        body = f"Overnight run started {st['started']} from master `{sha[:7]}` over {len(ready)} Ready issues: " + \
               " ".join(f"#{i['number']}" for i in ready) + "\n\nThe morning report lands here as a comment."
        out = sh(["gh", "issue", "create", "--title", f"Whip run {st['date']}", "--body", body, "--label", "tech-debt"])
        m = re.search(r"/issues/(\d+)", out)
        st["run_issue"] = int(m.group(1)) if m else None; save(st)
    print(f"tree run started: {len(st['trains'])} train(s), tick {a.tick_minutes} min — `mise run whip -- next-train --lead lead-<t>` takes the next")
    print(); print(open(p[:-5] + ".md").read())

def cmd_next_train(a):
    """The next queued train, marked running under the lead the top names. Order is the tool's."""
    st = current()
    if st.get("done"):
        print("no next train: the run is done"); return
    if st.get("stopped") or capped(st):
        print(f"no next train: {'the owner stopped the run' if st.get('stopped') else 'past the %sh cap' % st['cap_h']}"); maybe_end_run(st); return
    if a.lead in st["leads"]:
        sys.exit(f"next-train: {a.lead} is already in the ledger ({st['leads'][a.lead]['state']}) — name a fresh lead")
    t = None
    for q in st["trains"]:
        if q.get("state") != "queued": continue
        if q["issues"]: t = q; break
        q["state"] = "empty"; event(st, f"train {q['name']} is empty — skipped")
    if not t:
        save(st)
        print("no next train: nothing queued"); return
    t["state"] = "running"; t["lead"] = a.lead
    tree_lead(st, a.lead, t["name"])
    event(st, f"train {t['name']} → {a.lead} (tree)")
    print(f"train {t['name']}: {' '.join('#%d' % n for n in t['issues'])} · lead {a.lead}")


def cmd_trains(a):
    st = current()
    if a.redo or not st["trains"]:
        compute_trains(st, a.size)
    print("\n".join(f"{t['name']}: {' '.join('#%d' % n for n in t['issues'])}" for t in st["trains"]))


def cmd_train(a):
    st = current()
    t = train_of(st, a.train)
    if not t and a.verb != "add": sys.exit("no such train")
    if a.verb == "split":
        k = int(a.arg)
        new = {"name": t["name"] + "2", "issues": t["issues"][k:], "state": "queued", "lead": None, "reliefs": 0}
        t["issues"] = t["issues"][:k]
        st["trains"].insert(st["trains"].index(t) + 1, new)
        save(st); event(st, f"train {a.train} split at {k}")
    elif a.verb == "add":
        ns = [int(x) for x in [a.arg] + a.more]
        if t and t.get("state") != "queued": sys.exit(f"train add: train {a.train} is {t.get('state')} — only a queued train takes issues")
        held = [n for n in ns for x in st["trains"] if n in x["issues"]]
        if held: sys.exit(f"train add: {' '.join('#%d' % n for n in held)} already in a train")
        if not t:
            t = {"name": a.train, "issues": [], "state": "queued", "lead": None, "reliefs": 0}; st["trains"].append(t)
        t["issues"] = ns + t["issues"] if a.head else t["issues"] + ns
        for n in ns:
            if n not in st["ready"]: st["ready"].append(n)
        st["dropped"] = [n for n in st.get("dropped", []) if n not in ns]
        save(st); event(st, f"owner: added {' '.join('#%d' % n for n in ns)} to train {a.train}{' at its head' if a.head else ''}")
    else:
        n = int(a.arg)
        if n not in t["issues"]: sys.exit(f"#{n} not in train {a.train}")
        t["issues"].remove(n); st.setdefault("dropped", []).append(n)
        save(st); event(st, f"owner: dropped #{n} from train {a.train}")


def cmd_max_leads(a):
    st = current(); st["max_leads"] = a.n; save(st)
    event(st, f"owner raised the lead ceiling to {a.n}"); print(f"leads ≤ {a.n} — takes effect at the next baton pass (done)")


def cmd_note(a):
    # any_recent: a wake can fire into a finished run, past midnight (swarm-train law 18) and still must land its `wasted:` note
    st = current(any_recent=True); st["notes"].append(f"{now()} {a.text}"); save(st); event(st, f"note: {a.text[:80]}")


def cmd_show(a):
    st = current(any_recent=True); print(open(st["_path"][:-5] + ".md").read())


def cmd_stop(a):
    st = current()
    if st.get("done"): print("the run is already done"); return
    st["stopped"] = st.get("stopped") or now(); save(st)
    event(st, "owner stop" + (" --now" if a.now else "") + ": nothing launches from here on" + ("" if a.now else "; running leads drain"))
    if a.now and not st.get("done"):
        for l in st["leads"].values():
            if l["state"] == "running": l["state"] = "stopped (unverified)"
        save(st)
        end_run(st)
        st = current()
    print(open(st["_path"][:-5] + ".md").read())


def cmd_retire(a):
    p = state_path()
    if not p:
        print("no whip run on disk"); return
    st = load(p); st["_path"] = p
    if not st.get("done") and not a.force:
        sys.exit(f"{p} is a LIVE run (started {st.get('started')}, not reported). `mise run whip -- report` first, "
                 "or `retire --force` to archive it as it stands.")
    print(f"retired to {retire_ledger(st, 'retire' + (' --force' if a.force else ''))}")


# ---------------------------------------------------------------- verbs: the top, naming its lead
def cmd_done(a):
    st = current()
    name, l = named_lead(st, a, "done")
    t = train_of(st, l.get("train"))
    l["state"] = "done"; l["last"] = f"DONE {a.sha[:7]} {a.landed}"
    if t and t.get("lead") == name: t["state"] = f"done {a.sha[:7]} {a.landed}"
    save(st); event(st, f"{name} DONE {a.sha[:7]} {a.landed}")
    n0 = len(st["events"])
    pass_baton(st)
    st = current()
    print("\n".join(st["events"][n0:]))
    left = [t["name"] for t in st["trains"] if t.get("state") == "queued"]
    print(f"DONE recorded for {name}" + (" — the run is over, the report is rendered" if st.get("done") else
          f" — queued: {' '.join(left)} (`next-train --lead …`)" if left else " — nothing queued; the run ends with the last running lead"))

def cmd_drained(a):
    """The outgoing lead has returned its session report; draining -> relieved."""
    st = current()
    name, l = named_lead(st, a, "drained", states=("draining",))
    l["state"] = "relieved"; save(st)
    event(st, f"{name} drained: returned, relieved")
    print(f"{name} relieved (drained)")


def cmd_relieve(a):
    """Record a relief for the named lead's train; the top spawns it. Launches nothing."""
    st = current()
    name, l = named_lead(st, a, "relieve", states=("running",))
    ok = request_relief(st, l.get("train"), f"top relieves {name}")
    st = current(); t = train_of(st, l.get("train")) or {}
    if not ok:
        sys.exit(f"no relief: train {l.get('train')} is {t.get('state')}")
    # No `ledger adopt` hint: every subagent shares the top's session id, so the relief already owns that swarm ledger.
    print(f"relief {t['lead']} recorded for train {t['name']} (relieving {name}) — spawn it; whip ledger: {st['_path']}")


def cmd_needs_owner(a):
    st = current()
    name, l = named_lead(st, a, "needs-owner")
    st["notes"].append(f"{now()} needs owner #{a.n} (train {l.get('train')}, {name}): {a.line}")
    save(st); event(st, f"{name}: needs owner #{a.n} — {a.line[:80]}")
    print("noted for the morning — keep going")


# ---------------------------------------------------------------- done-check + report
def remaining_ready(st):
    return [i["number"] for i in ready_issues() if i["number"] in set(st["ready"]) - set(st.get("dropped", []))]


def cmd_done_check(a):
    st = current(); bad = []
    noted = {int(m) for n in st["notes"] for m in re.findall(r"still-ready #(\d+)", n)}
    for n in remaining_ready(st):
        if n not in noted: bad.append(f"#{n} still Ready and not noted (whip -- note 'still-ready #{n}: <why>')")
    wts = sh("git worktree list --porcelain", cwd=ROOT).count("worktree ") - 1
    if wts > 0: bad.append(f"{wts} worktree(s) still open (mise run worktree:ls)")
    hyg = sh("mise run --quiet gh-project -- hygiene", cwd=ROOT).strip()
    if hyg and "clean" not in hyg.lower(): bad.append("hygiene: " + hyg.splitlines()[0][:120])
    print("\n".join(bad) if bad else "done-check: clean"); sys.exit(1 if bad else 0)


def collapse(lines):
    """Identical incident lines (timestamp stripped) → one line `×N, HH:MM–HH:MM`."""
    out, run_ = [], None
    for e in lines:
        ts, _, body = e.partition(" ")
        hhmm = ts[-5:] if len(ts) >= 5 else ts
        if "T" not in ts and " " in e and re.match(r"\d{4}-\d{2}-\d{2}$", ts):  # "YYYY-MM-DD HH:MM body"
            hhmm, _, body = body.partition(" ")
        if run_ and run_[0] == body:
            run_[1] += 1; run_[3] = hhmm
        else:
            if run_: out.append(run_)
            run_ = [body, 1, hhmm, hhmm]
    if run_: out.append(run_)
    return [f"{b} ×{n}, {t0}–{t1}" if n > 1 else f"{t0} {b}" for b, n, t0, t1 in out]


def write_report(st):
    rem = set(remaining_ready(st)); start = st["start_sha"]; dropped = st.get("dropped", [])
    log = sh(f"git log --oneline {start}..master", cwd=ROOT).strip().splitlines()
    closes = {int(n) for n in re.findall(r"[Cc]loses #(\d+)", sh(f"git log {start}..master", cwd=ROOT))}
    landed = [n for n in st["ready"] if n in closes]
    nd = board_lane("needs-design"); ip = board_lane("in-progress")
    back = [n for n in st["ready"] if n in nd and n not in dropped and n not in landed]
    orphaned = [n for n in st["ready"] if n in ip and n not in landed and n not in dropped and n not in back]
    since = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(st["started_ts"]))
    filed = sh(f"gh issue list --search 'created:>={since}' --state all --json number,title --jq '.[] | \"#\\(.number) \\(.title)\"'").strip()
    owner = [n for n in st["notes"] if "needs owner" in n]
    inc = collapse([e for e in st["events"] if re.search(r"relief|REFUSED|FAILED|dropped|blocked|stalled|limit|ceiling|owner stop|CAPPED|warning", e)])
    cost = sh("mise run --quiet agent-cost -- --latest 20", cwd=ROOT).strip().splitlines()[:25]
    T = lambda n: st["ready_titles"].get(str(n)) or title_of(n)
    why = lambda n: next((" — " + x.split(":", 2)[-1].strip() for x in st["notes"] if f"still-ready #{n}" in x), "")
    head = (f"Landed {len(landed)}/{len(st['ready'])} · {len(log)} commits `{start[:7]}..master` · back to Needs design {len(back)} · "
            f"orphaned In progress {len(orphaned)} · dropped {len(dropped)} · still Ready {len(rem)}")
    head = " · ".join(warnings(st) + [head])
    L = [f"# Whip report {st['date']}", "", f"**{head}**", "",
         "## Landed"] + ([f"- #{n} {T(n)}" for n in landed] or ["- none"]) + \
        ["", "## Back to Needs design"] + ([f"- #{n} {T(n)}" for n in back] or ["- none"]) + \
        ["", "## Still Ready"] + ([f"- #{n} {T(n)}{why(n)}" for n in sorted(rem)] or ["- none"]) + \
        ["", "## Orphaned In progress"] + ([f"- #{n} {T(n)} — left In progress by a dead lead; check its worktree/branch" for n in orphaned] or ["- none"]) + \
        ["", "## Dropped by the owner"] + ([f"- #{n} {T(n)}" for n in dropped] or ["- none"]) + \
        ["", f"## Filed since start ({since})", filed or "- none", "", "## Needs the owner"] + ([f"- {o}" for o in owner] or ["- none"]) + \
        (["", f"Wasted top turns: {wasted_turns(st)}"] if wasted_turns(st) else []) + \
        ["", "## Incidents"] + ([f"- {e}" for e in inc] or ["- none"]) + \
        ["", "## Cost (agent-cost, latest 20)", "```"] + cost + ["```", "",
         "No daemon, timer or session was ever started; nothing to tear down."]
    out = os.path.join(HDIR, f"whip-report-{st['date']}.md")
    if os.path.exists(out) and st.get("report_path") != out:  # another run's report of this date: never overwrite it
        out = os.path.join(HDIR, f"whip-report-{st['date']}-{time.strftime('%H%M', time.localtime(st['started_ts']))}.md")
    with open(out, "w") as f: f.write("\n".join(L) + "\n")
    if st.get("run_issue"):
        sh(["gh", "issue", "comment", str(st["run_issue"]), "--body-file", out])
    st["done"] = True; st["report_path"] = out; save(st); event(st, f"report written {out}")
    open(st["_path"][:-5] + ".done", "w").write(now())
    print(out)
    return out


def cmd_report(a):
    write_report(current())


def tick_minutes(v):
    n = int(v)
    if not 15 <= n <= 55:
        raise argparse.ArgumentTypeError(f"{n} is outside [15, 55] — the tick must land inside the one-hour prompt-cache lifetime")
    return n


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd", required=True)
    s = sp.add_parser("start", help="snapshot Ready + master, the trains, the run issue, the ledger — launches nothing")
    s.add_argument("--cap", type=float, default=15); s.add_argument("--max-leads", type=int, default=1)
    s.add_argument("--stall-minutes", type=int, default=45, help="disk silence that counts as a stall")
    s.add_argument("--size", type=size_arg, default=None, help="max singletons per train, or `all`: every Ready issue in one train (default: all)")
    s.add_argument("--no-issue", action="store_true")
    s.add_argument("--tree", action="store_true", help="accepted and redundant: the tree is the only transport")
    s.add_argument("--tick-minutes", type=tick_minutes, default=45, help="the top's tick interval, [15, 55] (inside the prompt-cache hour)")
    s.set_defaults(f=cmd_start)
    s = sp.add_parser("next-train", help="(top) mark the next queued train running under --lead and print its issues")
    s.add_argument("--lead", required=True); s.set_defaults(f=cmd_next_train)
    s = sp.add_parser("stop", help="the owner's stop: nothing launches; leads drain (--now: leads stopped, report now)"); s.add_argument("--now", action="store_true"); s.set_defaults(f=cmd_stop)
    s = sp.add_parser("retire", help="archive the run on disk into handoffs/archive/ so the next start begins clean"); s.add_argument("--force", action="store_true", help="archive a live, unreported run"); s.set_defaults(f=cmd_retire)
    s = sp.add_parser("trains"); s.add_argument("--redo", action="store_true"); s.add_argument("--size", type=size_arg, default=4); s.set_defaults(f=cmd_trains)
    s = sp.add_parser("train"); s.add_argument("verb", choices=["split", "drop", "add"]); s.add_argument("train"); s.add_argument("arg", help="split: index · drop: issue number · add: issue number(s)")
    s.add_argument("more", nargs="*", type=int, help="add: further issue numbers"); s.add_argument("--head", action="store_true", help="add: first in the train"); s.set_defaults(f=cmd_train)
    s = sp.add_parser("max-leads"); s.add_argument("n", type=int); s.set_defaults(f=cmd_max_leads)
    s = sp.add_parser("done", help="(top) --lead's train landed: records, passes the baton or ends the run"); s.add_argument("--lead"); s.add_argument("sha"); s.add_argument("landed"); s.set_defaults(f=cmd_done)
    s = sp.add_parser("relieve", help="(top) record a relief for --lead's train; launches nothing"); s.add_argument("--lead"); s.set_defaults(f=cmd_relieve)
    s = sp.add_parser("drained", help="(top) an outgoing lead returned: draining -> relieved"); s.add_argument("--lead"); s.set_defaults(f=cmd_drained)
    s = sp.add_parser("needs-owner", help="(top) --lead moved an issue to Needs design"); s.add_argument("--lead"); s.add_argument("n", type=int); s.add_argument("line"); s.set_defaults(f=cmd_needs_owner)
    s = sp.add_parser("note"); s.add_argument("text"); s.set_defaults(f=cmd_note)
    sp.add_parser("show").set_defaults(f=cmd_show)
    sp.add_parser("done-check").set_defaults(f=cmd_done_check)
    sp.add_parser("report").set_defaults(f=cmd_report)
    sp.add_parser("help").set_defaults(f=lambda a: ap.print_help())
    a = ap.parse_args()
    if a.cmd != "help":
        lock()
    a.f(a)


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
#MISE description="Whip v2, the overnight relay of swarms: ledger + verbs + zero-token watchdog. `mise run whip -- start [--cap H] [--max-leads N] [--stall-minutes M] | show | stop [--now] | note '…' | trains | train split|drop | max-leads N | launch <name> [--relief] | done [--lead L] <sha> <n/m> | relieve-me | needs-owner [--lead L] <n> '<line>' | tree: start --tree [--tick-minutes 15..55] · next-train --lead L · relieve --lead L | done-check | report | retire [--force] | watchdog | daemon start|status|stop | timer install|uninstall`"
"""
State for one overnight run lives in docs/handoffs/whip-<date>.json
(gitignored); every write renders the human ledger whip-<date>.md next to
it. There is no whip session: `/whip` from any session runs `start` and is
then the owner's console; leads pass the baton by verb (`done`,
`relieve-me`, `needs-owner`, keyed on the caller's session id); the systemd
user timer runs `watchdog` with no Claude session involved. Design:
docs/charters/whip.md.

Tree transport (`start --tree`, ledger `transport: tree`): one top session
drives subagent leads, so the session process model below stays dormant —
no daemon, timer, linger or `claude` process. The top takes trains with
`next-train --lead <name>` and names the lead on `done`/`relieve`/
`needs-owner --lead` (subagents share its session id); `watchdog`,
`daemon`, `timer`, `launch` and `relieve-me` refuse. Design:
docs/charters/swarm-train.md.

Process model, in one paragraph: every lead is a `--bg` session, and a
`--bg` session lives under whatever `claude daemon` is running — with none
running, `claude --bg` spawns a transient one in the CALLER's cgroup, so
the fleet would inherit the caller's pids budget (a terminal scope, or a
oneshot service that kills it on exit). `ensure_daemon()` therefore runs
the daemon as its own transient systemd user unit before any `--bg`, and
a launch that cannot have it is deferred, never run transient.

Session launches and stops are performed by exactly one path, the
watchdog tick: a verb writes a REQUEST into the ledger and kicks the tick
(`systemctl --user start whip-watchdog.service`, in-process when the unit
is not there). The console that runs `start`/`stop` may be an auto-mode
session whose classifier denies a direct `claude --bg`/`claude stop`
(probed 2026-10-03 from a phone-started session: denied); under systemd
there is no classifier, and a request the kick could not perform is
performed by the timer's next tick.

A running bg session takes a prompt one way only: `claude stop <id>`,
VERIFIED gone, then a FLAGLESS `claude --bg --resume <id> "<prompt>"`
(`-p -r` is refused while it runs; any flag on `--resume`, or a resume of
a session that did not stop, forks a copy under a new id).

Exit 0 on every no-op; non-zero only on a usage error or a refusal.
"""
import argparse, glob, json, os, re, shutil, subprocess, sys, time

ROOT = os.environ.get("MISE_PROJECT_ROOT") or os.getcwd()
HDIR = os.path.join(ROOT, "docs", "handoffs")
UNIT_DIR = os.path.expanduser("~/.config/systemd/user")
REPO = "Koaieus/skill-tree-of-life"
LIVE_HOURS = 36
DAEMON_UNIT = "whip-daemon"
MAX_FAILURES = 3
MAX_RELIEFS = 2       # per train; a third launch fails the train instead
RETIRE_GRACE = 120    # seconds a done/failed lead keeps its session before the tick stops it (its verb must return first)
SLEEP = time.sleep
ANSI = re.compile(r"\x1b\[[0-9;]*m")
# One contract, two readers: `.claude/skills/swarm/SKILL.md` §Whip relay mode is the lead's
# reading of this string; a difference in substance between them is a bug.
CLAUSES = (
    "Whip relay: there is no supervisor session and no human awake; the whip relay is your principal and these clauses "
    "are your instructions. Report by verb, one call each, never to a human and never to a session: "
    "`mise run whip -- relieve-me` where the swarm skill says request relief (it launches your relief; you drain per the "
    "relief skill); `mise run whip -- done <pushed sha> <landed n/m>` after the push and hygiene --fix (it launches the next "
    "train's lead, or ends the run and renders the report — then end your turn and do nothing more); "
    "`mise run whip -- needs-owner <n> \"<one line>\"` after you moved an issue to Needs design with a dated comment stating "
    "your assumption or the fork, then keep going with the rest of the run. The verbs know your train from your session; "
    "you never name it. Never ask: anything you would have put to the owner is answered by your own stated assumption "
    "(ledger + issue comment), or the unit is pulled — ending a turn on a question stalls the night. No other traffic: no "
    "progress pings, no messages to anyone. The only instructions you receive are the watchdog's prompts (a window reset: "
    "continue from your ledger) and the owner's stop (go quiet, let in-flight drones report, land what is reported, then done)."
)
STOP_PROMPT = ("owner stop: go quiet, let in-flight drones report, land what is reported, then `mise run whip -- done <pushed sha> "
               "<landed n/m>`. Launch nothing new. Whip relay, unchanged.")


def now():
    return time.strftime("%Y-%m-%d %H:%M")


def sh(cmd, check=False, **kw):
    r = subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True, text=True, **kw)
    if check and r.returncode:
        sys.exit(f"{cmd}: {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout


# ---------------------------------------------------------------- ledger
def state_path(create=False):
    """The one ledger on disk: today's if it exists (done or not — `start` is the verb that
    retires a done one), else the newest live one of the last LIVE_HOURS, else today's to create."""
    today = os.path.join(HDIR, f"whip-{time.strftime('%Y-%m-%d')}.json")
    if os.path.exists(today):
        return today
    live = [p for p in glob.glob(os.path.join(HDIR, "whip-20*.json"))
            if time.time() - os.path.getmtime(p) <= LIVE_HOURS * 3600 and not load(p).get("done")]
    if live:
        return max(live, key=os.path.getmtime)
    return today if create else None


def load(p):
    """A v1 ledger (one `pending` dict, no requests/reliefs) still loads: `start` retires a done one through render()."""
    with open(p) as f:
        st = json.load(f)
    pend = st.get("pending")
    st["pending"] = [pend] if isinstance(pend, dict) else (pend or [])
    st.setdefault("requests", [])
    st.setdefault("transport", "sessions")
    for t in st.get("trains", []): t.setdefault("reliefs", 0); t.setdefault("lead", None)
    return st


def save(st):
    with open(st["_path"], "w") as f:
        json.dump({k: v for k, v in st.items() if k != "_path"}, f, indent=1)
    render(st)


def current():
    p = state_path()
    if not p:
        print("no whip run on disk"); sys.exit(0)
    st = load(p); st["_path"] = p
    return st


_LOCK = None


def lock(timeout=60):
    """One writer at a time: the leads' verbs, the watchdog tick and the console all load→modify→save
    the ledger. Held for the process; released around the kick so the tick can take it."""
    global _LOCK
    if _LOCK: return  # re-entrant within one process (the selftest drives main() repeatedly)
    import fcntl
    os.makedirs(HDIR, exist_ok=True)
    _LOCK = open(os.path.join(HDIR, ".whip.lock"), "w")
    deadline = time.time() + timeout
    while True:
        try:
            fcntl.flock(_LOCK, fcntl.LOCK_EX | fcntl.LOCK_NB); return
        except OSError:
            if time.time() > deadline: sys.exit(f"whip ledger locked for {timeout}s by another whip verb — try again")
            SLEEP(1)


def unlock():
    global _LOCK
    if _LOCK:
        import fcntl
        fcntl.flock(_LOCK, fcntl.LOCK_UN); _LOCK.close(); _LOCK = None


def retire_ledger(st, why):
    """Move the run's json/md/markers into handoffs/archive/, suffixed with the start time so two
    runs on one date never collide. The tracked whip-report-* stays. Returns the archive stem."""
    arch = os.path.join(HDIR, "archive"); os.makedirs(arch, exist_ok=True)
    stem = os.path.join(arch, f"whip-{st['date']}-{time.strftime('%H%M', time.localtime(st['started_ts']))}")
    k = 1
    while os.path.exists(stem + ".json"):
        k += 1; stem = stem.rsplit("-", 1)[0] + f"-{k}" if k > 2 else stem + "-2"
    event(st, f"retired: {why}")
    base = st["_path"][:-5]
    for ext in (".json", ".md", ".done", ".gave-up"):
        if os.path.exists(base + ext):
            shutil.move(base + ext, stem + ext)
    return stem


def event(st, line):
    st["events"].append(f"{now()} " + ANSI.sub("", line).replace("\n", " ⏎ "))
    save(st)


def capped(st):
    return time.time() - st["started_ts"] > st["cap_h"] * 3600


def tree(st):
    """Tree transport: the top session drives subagent leads; no daemon, timer, linger or `claude` process."""
    return st.get("transport") == "tree"


def refuse_in_tree(verb):
    """One line, non-zero, when a live tree-transport ledger is on disk; silent otherwise."""
    p = state_path()
    if p:
        st = load(p)
        if tree(st) and not st.get("done"):
            sys.exit(f"{verb}: refused — the live run is tree transport (the top session drives its leads; no daemon, timer or launch)")


def train_of(st, name):
    return next((t for t in st["trains"] if t["name"] == name), None)


def warnings(st):
    w = []
    if not tree(st) and st.get("linger") != "yes": w.append(f"linger: {st.get('linger') or '?'} (the timer and the fleet die at logout)")
    if st.get("stopped"): w.append(f"STOPPED by the owner {st['stopped'][-5:]}")
    if capped(st): w.append(f"CAPPED at {st['cap_h']}h")
    if st.get("gave_up"): w.append(f"GAVE UP: {st['gave_up']}")
    failed = [t["name"] for t in st["trains"] if t.get("state") == "failed"]
    if failed: w.append(f"FAILED train(s) {' '.join(failed)} (relief cap)")
    if st.get("tasks_peak"): w.append(f"fleet tasks peak {st['tasks_peak']}")
    return w


def render(st):
    md = st["_path"][:-5] + ".md"
    wd = (f"watchdog pending: {', '.join(p['action'] for p in st['pending'])}" if st.get("pending") else
          f"watchdog failures {st.get('failures', 0)}/{MAX_FAILURES}" if st.get("failures") else "watchdog ok")
    L = [f"# Whip {st['date']} — ledger (gitignored; relief and the watchdog read this)",
         f"Start: master `{st['start_sha'][:7]}` · run issue #{st.get('run_issue', '?')} · cap {st['cap_h']}h · "
         f"leads ≤ {st.get('max_leads', 1)} · stall {st.get('stall_minutes', 45)} min · "
         f"{'tree · tick %s min · ' % st.get('tick_minutes') if tree(st) else ''}started {st['started']} · "
         f"{'DONE' if st.get('done') else 'live'} · {wd}" + "".join(f" · {w}" for w in warnings(st)),
         "", "## Trains", "| train | issues | lead | reliefs | state |", "|---|---|---|---|---|"]
    for t in st["trains"]:
        L.append(f"| {t['name']} | {' '.join('#%d' % n for n in t['issues'])} | {t.get('lead') or '-'} | {t.get('reliefs', 0)} | {t.get('state', 'queued')} |")
    if st.get("dropped"):
        L.append(f"Dropped by the owner: {' '.join('#%d' % n for n in st['dropped'])}")
    L += ["", "## Leads", "| name | session | kind | train | launched | state | last |", "|---|---|---|---|---|---|---|"]
    for n, l in st["leads"].items():
        L.append(f"| {n} | {l['session'][:8]} | {l['kind']} | {l.get('train', '-')} | {l['launched']} | {l['state']} | {l.get('last', '')} |")
    if st.get("requests"):
        L += ["", "## Requests (performed by the next watchdog tick)"] + [f"- {r['kind']} {r.get('name') or r.get('session', '')[:8]}" for r in st["requests"]]
    L += ["", "## Notes"] + [f"- {n}" for n in st["notes"]] + ["", "## Events"] + [f"- {e}" for e in st["events"][-60:]]
    with open(md, "w") as f:
        f.write("\n".join(L) + "\n")


# ---------------------------------------------------------------- board + git
def ready_issues():
    out = sh("mise run --quiet gh-project -- list ready --json", cwd=ROOT)
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        sys.exit("gh-project list ready --json did not return JSON")


def board_lane(lane):
    out = sh(f"mise run --quiet gh-project -- list {lane} --json", cwd=ROOT)
    try: return {i["number"] for i in json.loads(out)}
    except (json.JSONDecodeError, TypeError, KeyError): return set()


def blocked_by(n):
    out = sh(f"gh api repos/{REPO}/issues/{n}/dependencies/blocked_by --jq '.[].number'")
    return [int(x) for x in out.split()]


def milestone_of(n):
    out = sh(f"gh issue view {n} --json milestone --jq '.milestone.title // \"\"'")
    return out.strip()


# ---------------------------------------------------------------- sessions
def agents():
    try:
        return json.loads(sh("claude agents --json"))
    except json.JSONDecodeError:
        return []


def by_session(ags, sid):
    return next((x for x in ags if sid and x.get("sessionId", "").startswith(sid)), None)


def session_state(a):
    """gone | blocked | waiting | busy | idle, from `claude agents --json`'s two vocabularies.

    Interactive sessions carry `status` (busy/idle); background ones `state`
    (working/done/blocked), plus `status` once they have a pid. A dead bg
    record lingers as {state: blocked} with no pid and no status — gone, not
    blocked. `status: waiting` is a held cross-session message (state reads
    blocked at the same time): not a question to a human, never a stall.
    `status` decides busy; `state` alone cannot.
    """
    if not a or (a.get("pid") is None and "status" not in a):
        return "gone"
    if a.get("status") == "waiting":
        return "waiting"
    if a.get("state") == "blocked":
        return "blocked"
    if a.get("status") == "busy" or ("status" not in a and a.get("state") == "working"):
        return "busy"
    return "idle"


def daemon_active():
    return sh(f"systemctl --user is-active {DAEMON_UNIT}.service").strip() == "active"


def ensure_daemon():
    """The fleet's cgroup: `claude daemon run` as a transient user unit. True when it is up."""
    if daemon_active():
        return True
    cli = os.path.realpath(shutil.which("claude") or "claude")
    sh(f"systemctl --user reset-failed {DAEMON_UNIT}.service")
    props = ["-p", f"Environment=PATH={os.environ.get('PATH', '')}", "-p", f"Environment=HOME={os.path.expanduser('~')}",
             "-p", "Environment=DISABLE_AUTOUPDATER=1"]
    if os.environ.get("WHIP_TASKS_MAX"):
        props += ["-p", f"TasksMax={os.environ['WHIP_TASKS_MAX']}"]
    sh(["systemd-run", "--user", f"--unit={DAEMON_UNIT}", "--quiet", "-p", f"WorkingDirectory={ROOT}", *props, cli, "daemon", "run"])
    for _ in range(20):
        if daemon_active() and "pid:" in sh("claude daemon status"):
            return True
        SLEEP(0.5)
    return False


def bg(cmd, env=None):
    """Run a `claude --bg …` client and return (the session id it printed or None, its first output)."""
    out = subprocess.run(cmd, capture_output=True, text=True, env=env or dict(os.environ, DISABLE_AUTOUPDATER="1"), cwd=ROOT).stdout
    out = ANSI.sub("", out)  # `claude --bg` colours the id even into a pipe
    m = re.search(r"backgrounded · (\w+)", out)
    return (m.group(1) if m else None), out.strip()[:200]


def stop_session(sid, tries=10):
    """`claude stop`, verified: True once the session is gone from the fleet."""
    sh(["claude", "stop", sid])
    for _ in range(tries):
        if session_state(by_session(agents(), sid)) == "gone":
            return True
        SLEEP(1)
    return session_state(by_session(agents(), sid)) == "gone"


def prompt_session(st, name, sid, prompt, action):
    """The one way to put a prompt into a bg session: stop, VERIFIED, then a flagless resume;
    the resume is verified on the next tick. A stop that does not take is a strike, never a resume
    (the resume of a running session forks a copy under a new id)."""
    if not ensure_daemon():
        event(st, f"{action}: daemon unit {DAEMON_UNIT} not active and could not be started; no resume"); return False
    if not stop_session(sid):
        st["failures"] = st.get("failures", 0) + 1
        event(st, f"{action}: {name} ({sid[:8]}) did not stop (status {session_state(by_session(agents(), sid))}) — no resume, "
                  f"strike {st['failures']}/{MAX_FAILURES}")
        return False
    got, out = bg(["claude", "--bg", "--resume", sid, prompt])
    st.setdefault("pending", []).append({"action": action, "session": sid, "name": name})
    event(st, f"{action} → stop + resume {name} ({sid[:8]}): {out[:80]}")
    return got is not None


# ---------------------------------------------------------------- requests: the one launcher is the tick
def request(st, **req):
    st.setdefault("requests", []).append(req); save(st)


def kick_watchdog():
    """Perform the queued requests now: the systemd oneshot (no classifier, the fleet's cgroup),
    in-process when the unit is not installed or systemd cannot be reached."""
    unlock()
    try:
        r = subprocess.run(["systemctl", "--user", "start", "whip-watchdog.service"], capture_output=True, text=True)
        ok = r.returncode == 0
    finally:
        lock()
    if not ok:
        tick()


def lead_prompt(st, name, train, relief):
    t = train_of(st, train) or {"issues": []}
    if relief:
        outgoing = t.get("outgoing") or "the previous lead"
        sid = (st.get("leads", {}).get(t.get("outgoing")) or {}).get("session", "")[:8]
        adopt = f"`mise run ledger -- adopt --from {sid}`" if sid else "`mise run ledger -- adopt`"
        return f"/relief — whip relay, train {train}, relieving {outgoing}; join its ledger with {adopt}. {CLAUSES}"
    nums = " ".join(f"#{n}" for n in t["issues"])
    return f"/swarm {nums} — whip relay, train {train}. {CLAUSES}"


def perform_launch(st, req):
    """One launch request. True when performed or dropped; False when it must wait for the next tick."""
    name, train, relief = req["name"], req["train"], req.get("relief", False)
    t = train_of(st, train)
    if capped(st) or st.get("stopped"):
        event(st, f"launch {name} dropped: {'past the cap' if capped(st) else 'owner stop'}")
        if t and t.get("lead") == name and not relief: t["state"] = "queued"; t["lead"] = None
        return True
    live = next((x for x in agents() if x.get("name") == name and session_state(x) != "gone"), None)
    if live and name in st["leads"]:
        event(st, f"launch {name}: already running — not launched twice"); return True
    if not ensure_daemon():
        event(st, f"launch {name} deferred: daemon unit {DAEMON_UNIT} not active and could not be started — the next tick retries")
        return False
    if live:  # alive but unrecorded (a launch whose output we failed to parse): adopt, never launch twice
        return record_launch(st, name, train, relief, live["sessionId"])
    mode = os.environ.get("WHIP_PERMISSION_MODE", "bypassPermissions")
    model = os.environ.get("WHIP_LEAD_MODEL", "opus")
    got, out = bg(["claude", "--bg", "-n", name, "--permission-mode", mode, "--model", model, lead_prompt(st, name, train, relief)])
    if not got:
        st["failures"] = st.get("failures", 0) + 1
        event(st, f"launch {name} FAILED ({st['failures']}/{MAX_FAILURES}): {out}")
        if t and t.get("lead") == name and not relief: t["state"] = "queued"; t["lead"] = None
        return True
    sess = next((x["sessionId"] for x in agents() if x.get("name") == name), got)
    return record_launch(st, name, train, relief, sess)


def record_launch(st, name, train, relief, sess):
    kind = "relief" if relief else "lead"
    t = train_of(st, train)
    if t:
        if relief and t.get("outgoing") in st["leads"] and st["leads"][t["outgoing"]]["state"] == "running":
            st["leads"][t["outgoing"]]["state"] = "relieved"
        t["lead"] = name; t["state"] = "running"
    st["leads"][name] = {"session": sess, "kind": kind, "train": train, "launched": now(), "launched_ts": time.time(),
                         "last_ts": time.time(), "state": "running", "verified": False}
    st.setdefault("pending", []).append({"action": f"launch {name}", "session": sess, "name": name})
    event(st, f"launched {kind} {name} ({sess[:8]}) for train {train}")
    return True


def perform_requests(st):
    left = []
    for req in st.get("requests", []):
        if req["kind"] == "launch":
            if not perform_launch(st, req): left.append(req)
        elif req["kind"] == "prompt":
            prompt_session(st, req["name"], req["session"], req["prompt"], req["action"])
        elif req["kind"] == "stop":
            l = st["leads"].get(req["name"], {})
            if stop_session(req["session"]):
                l["state"] = "stopped"; event(st, f"{req['action']}: stopped {req['name']} ({req['session'][:8]})")
            else:
                st["failures"] = st.get("failures", 0) + 1
                event(st, f"{req['action']}: {req['name']} did not stop — strike {st['failures']}/{MAX_FAILURES}")
    st["requests"] = left; save(st)


# ---------------------------------------------------------------- the relay
def running_trains(st):
    return [t["name"] for t in st["trains"] if t.get("state") == "running"]


def pass_baton(st):
    """Queued trains launch under the ceiling — unless stopped or capped. Then: is the run over?
    Tree transport launches nothing: the top takes the next train with `next-train`."""
    if tree(st):
        maybe_end_run(st); return
    if not st.get("stopped") and not capped(st):
        for t in st["trains"]:
            if len(running_trains(st)) >= st.get("max_leads", 1): break
            if t.get("state") == "queued":
                name = f"lead-{t['name']}"
                t["state"] = "running"; t["lead"] = name
                request(st, kind="launch", name=name, train=t["name"])
                event(st, f"baton: train {t['name']} → {name} requested")
    maybe_end_run(st)


def request_relief(st, train, why):
    """A relief for a train, bounded by MAX_RELIEFS; the third fails the train and moves the baton."""
    t = train_of(st, train)
    if not t: return False
    if st.get("stopped") or capped(st):
        event(st, f"train {train}: no relief ({'owner stop' if st.get('stopped') else 'past the cap'}) — {why}")
        maybe_end_run(st); return False
    if t.get("reliefs", 0) >= MAX_RELIEFS:
        t["state"] = "failed"
        l = st["leads"].get(t.get("lead"))
        if l and l["state"] == "running": l["state"] = "failed"
        event(st, f"train {train} FAILED: a third relief is refused ({why}); its issues fall into Orphaned In progress")
        pass_baton(st); return False
    t["reliefs"] = t.get("reliefs", 0) + 1
    name = f"relief-{train}-{t['reliefs']}"
    t["outgoing"] = t.get("lead"); t["lead"] = name; t["state"] = "running"
    if tree(st):  # the top spawns the relief subagent; the ledger only records it
        out = st["leads"].get(t["outgoing"])
        if out and out["state"] == "running": out["state"] = "relieved"
        tree_lead(st, name, train, relief=True)
        event(st, f"relief {name} recorded for the top to spawn: {why}")
        return True
    request(st, kind="launch", name=name, train=train, relief=True)
    event(st, f"relief {name} requested: {why}")
    return True


def maybe_end_run(st):
    if st.get("done"): return
    if any(l["state"] == "running" for l in st["leads"].values()): return
    if st.get("requests"): return
    if any(t.get("state") == "queued" for t in st["trains"]) and not st.get("stopped") and not capped(st): return
    end_run(st)


def end_run(st):
    """Law 25: what the done-check finds untrue and cannot fix goes into the report, never to a human."""
    noted = {int(m) for n in st["notes"] for m in re.findall(r"still-ready #(\d+)", n)}
    for n in remaining_ready(st):
        if n not in noted:
            st["notes"].append(f"{now()} still-ready #{n}: not reached (run ended: " + ("owner stop" if st.get("stopped") else "cap" if capped(st) else "no lead left") + ")")
    wts = sh("git worktree list --porcelain", cwd=ROOT).count("worktree ") - 1
    if wts > 0: st["notes"].append(f"{now()} {wts} worktree(s) still open at the end (mise run worktree:ls)")
    save(st)
    write_report(st)


def tree_lead(st, name, train, relief=False):
    """A tree lead's row: no session of its own (every subagent shares the top's id)."""
    st["leads"][name] = {"session": "", "kind": "relief" if relief else "lead", "train": train, "launched": now(),
                         "launched_ts": time.time(), "last_ts": time.time(), "state": "running", "verified": True}
    save(st)


def named_lead(st, a, verb):
    """Tree transport: the top names the lead (`--lead`); session mode keys on the caller's session."""
    if not tree(st):
        if getattr(a, "lead", None):
            sys.exit(f"{verb}: --lead is tree transport only — this run's leads are sessions; run it from the lead's session")
        return need_caller(st, verb)
    if not getattr(a, "lead", None):
        sys.exit(f"{verb}: usage — tree transport: `whip -- {verb} --lead <name> …` (the top names the lead)")
    l = st["leads"].get(a.lead)
    if not l or l["state"] != "running":
        sys.exit(f"{verb}: {a.lead} is no running lead in the ledger ({l['state'] if l else 'unknown'})")
    l["last_ts"] = time.time()
    return a.lead, l


def caller_lead(st):
    me = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    if not me: return None, None
    for name, l in st["leads"].items():
        if l["session"] and (l["session"].startswith(me) or me.startswith(l["session"])):
            return name, l
    return None, None


def need_caller(st, verb):
    name, l = caller_lead(st)
    if not name:
        sys.exit(f"{verb}: this session ({os.environ.get('CLAUDE_CODE_SESSION_ID', 'no CLAUDE_CODE_SESSION_ID')[:8]}) is no lead in the ledger — "
                 "the relay verbs are run by a lead-*/relief-* session; the owner's verbs are show/stop/note/train/max-leads")
    l["last_ts"] = time.time()
    return name, l


# ---------------------------------------------------------------- verbs: console
def compute_trains(st, size=4):
    ready = set(st["ready"]) - set(st.get("dropped", []))
    deps = {n: [b for b in blocked_by(n) if b in ready] for n in ready}
    seen, comps = set(), []
    for n in sorted(ready):
        if n in seen: continue
        comp, stack = [], [n]
        while stack:
            x = stack.pop()
            if x in seen: continue
            seen.add(x); comp.append(x)
            stack += deps[x] + [y for y in ready if x in deps[y]]
        order, left = [], set(comp)
        while left:
            free = sorted(y for y in left if not (set(deps[y]) & left))
            if not free: free = sorted(left)  # cycle: break it, the lead will see
            order += free; left -= set(free)
        comps.append(order)
    chains = [c for c in comps if len(c) > 1]
    singles = sorted((milestone_of(c[0]), c[0]) for c in comps if len(c) == 1)
    trains, cur, cur_ms = [], [], None
    for ms, n in singles:
        if cur and (ms != cur_ms or len(cur) >= size):
            trains.append(cur); cur = []
        cur.append(n); cur_ms = ms
    if cur: trains.append(cur)
    trains = chains + trains
    st["trains"] = [{"name": chr(97 + i), "issues": t, "state": "queued", "lead": None, "reliefs": 0} for i, t in enumerate(trains)]
    save(st); event(st, f"trains: {len(trains)}")



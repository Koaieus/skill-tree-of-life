#!/usr/bin/env python3
#MISE description="Self-test for issue-drift: throwaway git repo + synthetic issue payload; asserts last-stamp-wins, range intersection, whole-file, deleted, missing-at-stamp, no-stamp, exit 0 everywhere. `mise run issue-drift-selftest`"
import contextlib, importlib.machinery, importlib.util, io, json, os, subprocess, sys, tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
spec = importlib.util.spec_from_loader("issue_drift", importlib.machinery.SourceFileLoader("issue_drift", os.path.join(HERE, "issue-drift")))
idr = importlib.util.module_from_spec(spec); spec.loader.exec_module(idr)

failed = 0
def check(name, cond):
    global failed
    print(("[ok] " if cond else "[FAIL] ") + name); failed += not cond


# --- throwaway repo: two commits on master ---------------------------------
root = tempfile.mkdtemp(prefix="issue-drift-")
env = {**os.environ, "GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@t", "GIT_COMMITTER_NAME": "t", "GIT_COMMITTER_EMAIL": "t@t",
       "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_CONFIG_SYSTEM": "/dev/null"}
def git(*a):
    return subprocess.run(["git", "-C", root, *a], env=env, check=True, capture_output=True, text=True).stdout.strip()
def put(rel, lines):
    with open(os.path.join(root, rel), "w") as fh:
        fh.write("\n".join(lines) + "\n")

git("init", "-q", "-b", "master")
put("a.txt", [f"a{i}" for i in range(1, 41)])
put("b.txt", ["gone soon"])
put("c.txt", ["untouched"])
git("add", "a.txt", "b.txt", "c.txt"); git("commit", "-q", "-m", "one")
sha1 = git("rev-parse", "--short", "HEAD")
lines = [f"a{i}" for i in range(1, 41)]
lines[4] = "a5 changed"; lines[5] = "a6 changed"      # old lines 5-6
lines.insert(20, "inserted after a20")               # pure insertion at old 21 (zero-length old span)
put("a.txt", lines)
os.remove(os.path.join(root, "b.txt"))
git("add", "-A"); git("commit", "-q", "-m", "two")

STAMP2 = "\n".join([
    f"```drift-stamp {sha1}",
    "a.txt:4-8 — in range of the 5-6 edit",
    "a.txt:30-35 — out of range",
    "a.txt:21-22 — pure insertion at old line 21 counts",
    "a.txt:19-20 — just before the insertion, untouched",
    "a.txt — whole-file entry",
    "b.txt — deleted",
    "c.txt — untouched",
    "nope.txt:1-2 — typo path",
    "```",
])
payload = {
    "body": "Intro prose.\n\n```drift-stamp deadbeef\nzzz.txt — the OLD stamp, must lose\n```\n",
    "comments": [{"body": "chatter"}, {"body": "Re-swarmified.\n\n" + STAMP2 + "\nTrailing prose."}],
}


# --- parser ------------------------------------------------------------------
sha, entries = idr.parse_stamp(payload)
check("last stamp wins", sha == sha1 and all(e["path"] != "zzz.txt" for e in entries))
check("entry parse", entries[0] == {"path": "a.txt", "start": 4, "end": 8, "text": "in range of the 5-6 edit"}
      and entries[4] == {"path": "a.txt", "start": None, "end": None, "text": "whole-file entry"})
check("no stamp → None", idr.parse_stamp({"body": "nothing here", "comments": []}) == (None, []))


# --- drift computation ---------------------------------------------------------
rows = idr.compute(root, sha, entries, base="master")
by = {(r["path"], r["start"], r["end"]): r for r in rows}
check("(a) in-range hunk drifts", by[("a.txt", 4, 8)]["drifted"] is True)
check("(b) out-of-range hunk does not", by[("a.txt", 30, 35)]["drifted"] is False)
check("pure insertion drifts the line it lands on", by[("a.txt", 21, 22)]["drifted"] is True)
check("range ending before an insertion does not", by[("a.txt", 19, 20)]["drifted"] is False)
check("(c) whole-file entry drifts on any hunk", by[("a.txt", None, None)]["drifted"] is True)
check("(d) deleted file drifts", by[("b.txt", None, None)]["drifted"] is True and by[("b.txt", None, None)]["reason"] == "deleted")
check("untouched whole-file does not drift", by[("c.txt", None, None)]["drifted"] is False)
check("missing path at stamp is drift", by[("nope.txt", 1, 2)]["drifted"] is True and by[("nope.txt", 1, 2)]["reason"] == "missing-at-stamp")
check("json row shape", set(rows[0]) >= {"path", "start", "end", "drifted", "reason"})


# --- main: exit codes + output -----------------------------------------------
pf = os.path.join(root, "payload.json")
with open(pf, "w") as fh:
    json.dump(payload, fh)

def run(*argv):
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        code = idr.main(["--payload-json", pf, "--repo", root, *argv])
    return code, out.getvalue(), err.getvalue()

code, out, _ = run("903")
check("(f) drift case exits 0", code == 0)
check("one line per drifted entry, nothing for the clean ones",
      "a.txt:4-8" in out and "b.txt" in out and "nope.txt:1-2" in out and "a.txt:30-35" not in out and "c.txt" not in out)
check("line carries +ins/-del and a hunk header", "@@" in out and "+" in out and "/-" in out)

code, out, _ = run("903", "--json")
data = json.loads(out)
check("--json is the row list", code == 0 and isinstance(data, list) and len(data) == len(entries) and all("drifted" in d for d in data))

with open(pf, "w") as fh:
    json.dump({"body": "no stamp here", "comments": [{"body": "still none"}]}, fh)
code, out, _ = run("903")
check("(e) no stamp → 'no stamp on #903', exit 0", code == 0 and out.strip() == "no stamp on #903")

# a clean stamp (against HEAD itself) is silent
with open(pf, "w") as fh:
    json.dump({"body": f"```drift-stamp {git('rev-parse', 'HEAD')}\na.txt:1-3 — clean\n```", "comments": []}, fh)
code, out, _ = run("903")
check("nothing drifted → silent, exit 0", code == 0 and out == "")

# only a tool failure is non-zero: a sha the repo does not know
with open(pf, "w") as fh:
    json.dump({"body": "```drift-stamp 0123456789abcdef\na.txt — x\n```", "comments": []}, fh)
code, out, err = run("903")
check("unknown sha is a tool failure (non-zero)", code != 0)

print("all checks passed" if not failed else f"{failed} FAILED")
sys.exit(1 if failed else 0)

#!/usr/bin/env python3
#MISE description="Run the GUT suite headless and report a verdict: `mise run test` (add a .gd script or a dir to narrow)"
"""
Run GUT, then report what actually happened in ~20 lines instead of ~7000.

Exists so an agent doesn't burn a second 2-minute suite run re-grepping the
first one. The full console output is ALWAYS kept at .godot/gut-last.log and
the machine-readable results at .godot/gut-last.xml — if this summary elides
something you need, grep the log, never re-run. Same spirit as `mise refresh`.

The log is written LIVE, line by line, so `tail -f .godot/gut-last.log` shows
which script GUT is on while the ~200s suite is still running — and a run that
is killed or crashes still leaves everything it printed. The verdict below is
the last thing to arrive, never the first: assume the summary is absent until
the run ends, and read the log if you need to know what is happening now.

Usage:
    mise run test                              # whole suite (reads .gutconfig.json)
    mise run test -- res://test/unit/foo.gd    # one script   (alias: test:one)
    mise run test -- res://test/unit/ui/       # one directory (alias: test:dir)

Two GUT traps live in the flags below, both of which silently ran the ENTIRE
suite instead of one script: GUT's cmdln options are `-gopt=value` (a bare
`-gtest` with the path as a separate positional is valueless and ignored), AND
`-gtest` alone does not override .gutconfig.json's `dirs` — `-gdir=` must clear
them.

Before GUT starts, the task compares the `class_name` set declared in the tree
with `.godot/global_script_class_cache.cfg` (`class_cache_drift`, below) and
runs `mise run refresh` only when they differ (#919). A stale cache reads as a
regression — `Could not find type "X"` on 3/5 tests after a sibling landed a
new class — and a refresh costs ~12s, which is +5% on the full suite but +240%
on `test:one`; hence the exact predicate, not an unconditional refresh. `land`
runs `check` (itself an editor pass, rebuilding the cache) before `test:dir`,
so there the predicate finds the cache current and costs nothing. A `.gd`
with a parse error AND a `class_name` never enters the cache, so the predicate
fires on every run until it is fixed — and the refresh prints the SCRIPT
ERROR, which is the right noise.
"""
import os
import re
import subprocess
import sys
import xml.etree.ElementTree as ET

ROOT = os.environ.get("MISE_PROJECT_ROOT") or os.getcwd()
OUT_DIR = os.path.join(ROOT, ".godot")
LOG = os.path.join(OUT_DIR, "gut-last.log")
XML = os.path.join(OUT_DIR, "gut-last.xml")


MAX_TESTS_SHOWN = 15
MAX_MSG_CHARS = 240

# Godot's exit trailer. Noisy, always present, never the thing you are looking
# for — anything NOT matching these is passed through, because that is where a
# real crash shows up.
BENIGN_TRAILER = (
    "ObjectDB instances were leaked",
    "resources still in use at exit",
    "Pages in use exist at exit in PagedAllocator",
)
# Lines that mean the run itself is broken, not that a test failed. `Ignoring
# script` is the silent cause of the "suite count dropped after a rebase" trap
# (see docs/domain/godot-workflow.md) — it must never be filtered away.
ALARM = re.compile(r"Ignoring script |Could not find type |SCRIPT ERROR|Parse Error")

CLASS_CACHE = os.path.join(".godot", "global_script_class_cache.cfg")
# `class_name X` at column 0 — Godot itself only honours it as a top-level
# declaration, so an indented or commented one is not a class either.
CLASS_DECL = re.compile(r"^class_name\s+(\w+)", re.M)
CACHE_ENTRY = re.compile(r'"class":\s*&"(\w+)"[^}]*?"path":\s*"([^"]+)"', re.S)
# Dirs Godot never scans: hidden ones (.git, .godot, .worktrees, …) and any
# dir holding a `.gdignore`. addons/ is NOT skipped — GUT's classes are cached.
SKIP_DIR_PREFIX = "."


def _tree_classes(root):
    """{(class, res://path)} declared by every *.gd Godot would scan under root."""
    pairs = set()
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(
            d for d in dirnames
            if not d.startswith(SKIP_DIR_PREFIX)
            and not os.path.exists(os.path.join(dirpath, d, ".gdignore")))
        for name in filenames:
            if not name.endswith(".gd"):
                continue
            full = os.path.join(dirpath, name)
            try:
                with open(full, encoding="utf-8", errors="replace") as fh:
                    m = CLASS_DECL.search(fh.read())
            except OSError:
                continue
            if m:
                rel = os.path.relpath(full, root).replace(os.sep, "/")
                pairs.add((m.group(1), "res://" + rel))
    return pairs


def _cached_classes(root):
    """{(class, res://path)} in the class cache; empty when the file is absent."""
    try:
        with open(os.path.join(root, CLASS_CACHE), encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        return set()
    return set(CACHE_ENTRY.findall(text))


def class_cache_drift(root):
    """Lines describing how the tree's class_name set differs from the cache.

    Empty = current. Each line is `new <Class> <res://path>` (declared, not
    cached) or `gone <Class> <res://path>` (cached, no longer declared there).
    A missing cache — a fresh worktree — makes every declared pair `new`.
    Pure: one os.walk + one regex per file, no godot.
    """
    tree, cached = _tree_classes(root), _cached_classes(root)
    return ([f"new {c} {p}" for c, p in sorted(tree - cached)]
            + [f"gone {c} {p}" for c, p in sorted(cached - tree)])


def refresh_if_stale(root):
    """One preamble line + `mise run refresh` when the class cache drifted."""
    drift = class_cache_drift(root)
    if not drift:
        return
    new = sum(d.startswith("new ") for d in drift)
    print(f"class cache stale ({new} new / {len(drift) - new} gone): refreshing…", flush=True)
    subprocess.run(["mise", "run", "refresh"], cwd=root, check=False)


def build_args(argv):
    """(godot gut flags, human label for what we are running)."""
    args = argv[1:]
    # Raw GUT flags (-gselect=…, -glog=3) pass through untouched — the old bare
    # `godot … gut_cmdln.gd` task accepted them and wrapping one as a directory
    # would silently run nothing.
    passthrough = [a for a in args if a.startswith("-")]
    targets = [a for a in args if not a.startswith("-")]
    if len(targets) > 1:
        sys.exit(f"✗ one target at a time, got: {' '.join(targets)}")
    if not targets:
        return passthrough, "suite" if not passthrough else " ".join(passthrough)
    target = targets[0]
    if target.endswith(".gd"):
        return [f"-gtest={target}", "-gdir=", *passthrough], target
    return [f"-gdir={target}", *passthrough], target


def _cost_hint(label):
    """What this run is about to cost, said UP FRONT.

    Only the whole suite earns the warning: ~215s is a gate you spend once at
    final green (CLAUDE.md), and the number is here so nobody starts one to
    "just check something" without being told. A narrowed target is the cheap
    rung of the ladder and needs no disclaimer.
    """
    if label != "suite":
        return ""
    return "(~215s, the whole suite — a gate, not a feedback loop)"


def _preamble_notes(label):
    """The lines under the header — where to look, and what NOT to do.

    "Don't poll" is here rather than in a doc because this is the moment it is
    needed: an agent that has just started a 200s run is standing at exactly
    the fork where it either backgrounds the thing or burns three minutes of
    the user's session re-reading an empty file. The harness wakes you when the
    process exits; a `sleep`-and-`tail` loop buys nothing and blocks the user
    out of the conversation while it spins.
    """
    notes = [f"  progress: tail -f {os.path.relpath(LOG, ROOT)} — written live, "
             f"so it shows the script GUT is on right now"]
    if label == "suite":
        notes.append("  don't poll: background it (the harness wakes you on exit) "
                     "and do something else meanwhile")
    return notes


def truncate(s, n=MAX_MSG_CHARS):
    s = " ".join(s.split())
    return s if len(s) <= n else s[: n - 1] + "…"


def parse_xml():
    """[(suite, test, status, message)] or None if the run never produced results."""
    try:
        tree = ET.parse(XML)
    except (OSError, ET.ParseError):
        return None
    out = []
    for suite in tree.getroot().iter("testsuite"):
        suite_name = suite.get("name", "?")
        for case in suite.iter("testcase"):
            child = case.find("failure")
            if child is None:
                child = case.find("skipped")
            msg = (child.text or child.get("message", "") or "") if child is not None else ""
            out.append((suite_name, case.get("name", "?"), case.get("status", "?"), msg))
    return out


def report_failures(cases):
    shown = 0
    current = None
    for suite, test, status, msg in cases:
        if status != "fail":
            continue
        if shown == MAX_TESTS_SHOWN:
            break
        if suite != current:
            current = suite
            print(f"\n{suite}")
        print(f"  {test}")
        # GUT's XML records only the first failing assert per test; the rest are
        # in the log. Its "at line N" tail is folded onto the message line.
        body, _, line = msg.rpartition("at line ")
        if body.strip() and line.strip().isdigit():
            print(f"    {truncate(body.strip())}  (line {line.strip()})")
        elif msg.strip():
            print(f"    {truncate(msg)}")
        shown += 1
    failing = sum(1 for c in cases if c[2] == "fail")
    if failing > shown:
        print(f"\n  …and {failing - shown} more failing tests — see the log.")


def main():
    flags, label = build_args(sys.argv)
    os.makedirs(OUT_DIR, exist_ok=True)
    for stale in (LOG, XML):
        try:
            os.remove(stale)
        except OSError:
            pass

    # The PREAMBLE, printed before godot starts and terminated with a newline
    # so it is a COMPLETE line the moment it is written. It used to be
    # `end=""`, sharing its line with the verdict, which meant a run in
    # progress looked like a dangling fragment — or, piped anywhere, like an
    # empty file. Three minutes of "is this even running?" is exactly the
    # question this task exists to stop you asking.
    print(f"Running {label}… {_cost_hint(label)}".rstrip(), flush=True)
    for note in _preamble_notes(label):
        print(note, flush=True)
    refresh_if_stale(ROOT)
    # Merge stderr INTO stdout rather than capturing both: godot writes engine
    # errors to stderr and GUT to stdout, and concatenating the two streams
    # scrambles the ordering — the log stops matching what you'd see live, and
    # the "last lines are the exit trailer" heuristic below reads stderr's tail.
    #
    # STREAMED to the log rather than captured and written at the end (Popen,
    # not `subprocess.run`). Two things this buys, both about the ~200s window
    # where the old task was a black box:
    #   * the log is peekable WHILE the suite runs — `tail -f` shows the script
    #     GUT is on, which is the only way to tell a slow suite from a hung one;
    #   * a run that is killed, crashes, or times out still leaves its log.
    #     Previously the single write at the end never happened and the whole
    #     console output was lost — the one case where you most wanted it.
    console_lines = []
    with open(LOG, "w", buffering=1) as f:
        proc = subprocess.Popen(
            ["godot", "--headless", "--path", ROOT, "-s", "res://addons/gut/gut_cmdln.gd",
             *flags, "-gdisable_colors", f"-gjunit_xml_file={XML}"],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
        )
        for line in proc.stdout:
            f.write(line)
            console_lines.append(line)
        proc.wait()
    console = "".join(console_lines)

    cases = parse_xml()
    alarms = sorted({l.strip() for l in console.splitlines() if ALARM.search(l)})

    # Four outcomes, not two: passed, tests failed, the run never completed, and
    # *zero tests collected*. Reporting either of the last two as the other is
    # what costs you a re-run — a bad path and a stale class cache look nothing
    # alike, and the alarm lines are the whole diagnosis for the second.
    if cases is None:
        print(f"✗ run did not complete (godot exit {proc.returncode}) — no results file")
        tail = [l for l in console.splitlines()[-40:]
                if l.strip() and not any(b in l for b in BENIGN_TRAILER)]
        print("\n".join(tail[-20:]))
        print(f"\nfull output: {os.path.relpath(LOG, ROOT)}")
        return 1
    if not cases:
        print(f"✗ 0 tests collected — bad path, or a stale class cache "
              f"(`mise run refresh`); target was: {label}")
        for line in alarms[:10]:
            print(f"  {truncate(line)}")
        print(f"\nfull output: {os.path.relpath(LOG, ROOT)}")
        return 1

    failing = sum(1 for c in cases if c[2] == "fail")
    passing = sum(1 for c in cases if c[2] == "pass")
    other = [c for c in cases if c[2] not in ("fail", "pass")]
    scripts = len({c[0] for c in cases})
    elapsed = re.search(r"^Time\s+([\d.]+)s", console, re.M)
    verdict = "✗" if failing else "✓"
    print(f"{verdict} {failing} failing · {passing} passed · {len(other)} pending · "
          f"{scripts} script" + ("s" if scripts != 1 else "")
          + (f" ({elapsed.group(1)}s)" if elapsed else ""))

    if failing:
        report_failures(cases)
    for suite, test, status, msg in other[:5]:
        print(f"\n{status}: {suite}::{test}" + (f" — {truncate(msg, 120)}" if msg.strip() else ""))

    # Since #847 a missing native binary is a FAILURE in test_blade_goldens.gd's
    # before_each (and a push_error on every simulated swing), never a PENDING —
    # so it shows up in the failure report above with `mise run native:fetch`
    # in the message, and needs no separate verdict line.

    if alarms:
        print("\nrun health:")
        for line in alarms[:10]:
            print(f"  {truncate(line)}")

    unexpected = [l for l in console.splitlines()[-25:]
                  if l.startswith(("ERROR:", "WARNING:", "CRASH"))
                  and not any(b in l for b in BENIGN_TRAILER)]
    if unexpected:
        print("\nexit trailer:")
        for line in unexpected[:5]:
            print(f"  {truncate(line)}")

    # -F, not a bare pattern: [Failed] is a bracket expression matching any of
    # F/a/i/l/e/d, i.e. nearly every line of a 7000-line log.
    print(f"\nfull output: {os.path.relpath(LOG, ROOT)} "
          f"(grep -F '[Failed]' for every assert; {os.path.relpath(XML, ROOT)} for junit)")
    return 1 if failing else 0


if __name__ == "__main__":
    sys.exit(main())

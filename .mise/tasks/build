#!/usr/bin/env bash
#MISE description="Export the game: `mise run build` (linux+windows, release), `-- linux`, `-- windows`, `--debug`, `--dirty`"
set -euo pipefail

# Export the runnable artifacts, and nothing else — no packaging, no upload.
#
# What this exists to get right, beyond calling godot:
#
#   1. THE BUILD KNOWS ITS OWN COMMIT. An exported build has no res://.git, so
#      BuildInfo would report an empty sha, and CommandLink's #546 hello gate
#      compares shas — two DIFFERENT builds would both announce "" , compare
#      equal, and desync on the wire instead of refusing at link-up. We write
#      build_stamp.cfg (gitignored, packed via the presets' include_filter) and
#      BuildInfo falls back to it.
#
#   2. A DIRTY TREE MAKES THAT SHA A LIE. Default is to refuse. `--dirty` is
#      the deliberate escape hatch and does NOT weaken the gate: the stamp
#      becomes `<sha>+<digest>` where the digest hashes the full working diff,
#      so two builds off the same tree still match and any difference still
#      refuses — and the diff itself is written beside the artifacts, so the
#      state stays reproducible rather than merely labelled.
#
#   3. THE FILENAME CARRIES THE SHA TOO. The project has no semver or calver,
#      so the commit is the only version there is, and a stamp inside the pck
#      is unreadable without launching the thing. `skill-tree-of-life-<sha>`
#      makes two builds distinguishable in a directory listing, in a chat
#      attachment, and in the sentence "are we both on de9bb95?" — which is
#      exactly the question the hello gate answers the hard way. The commit's
#      calendar DATE leads that name (`-<date>-<sha>`) because two shas never
#      say which one is newer, and a directory listing sorts on the date.
#
#   4. AN EXPORT IS A DIRECTORY, NOT A FILE. Godot copies each GDExtension
#      library NEXT TO the executable — you cannot dlopen out of a pck, which
#      is what "failed to copy shared object" is telling you. Handing someone
#      the bare executable therefore hands them a build that cannot simulate
#      a melee swing at all (no GDScript fallback since #847). One
#      directory per build keeps the binary and its libraries together, and
#      restores what per-sha naming was for: a flat `export/linux/` shared ONE
#      `.so` across every build in it, and `rm` never touched it.
#
#   5. GODOT'S EXIT CODE IS NOT THE CHECK. `--export-release` has returned 0 on
#      a failed export in 4.x. Every artifact — executable AND every library
#      the preflight said would ship — is asserted to exist and be non-empty
#      afterwards.
#
#   6. A DECLARED-BUT-MISSING LIBRARY IS CAUGHT BEFORE GODOT RUNS. The exporter
#      hard-fails on a `.gdextension` that names a binary the tree does not
#      have — a different thing from the runtime fallback the extension was
#      designed around (#806: the Windows export was broken for a day because
#      no `.dll` has ever existed here). The preflight below reads the same
#      `[libraries]` keys the engine would and refuses at second zero, naming
#      the command that cures it.
#
# Templates are NOT fetched here — `mise run build:templates` is a ~1GB
# download that only matters when the engine pin in mise.toml moves.

cd "${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"

STAMP="build_stamp.cfg"
OUT="export"
platforms=()
mode="release"
allow_dirty=0

for arg in "$@"; do
  case "$arg" in
    linux|windows) platforms+=("$arg") ;;
    --debug)       mode="debug" ;;
    --release)     mode="release" ;;
    --dirty)       allow_dirty=1 ;;
    *) echo "✗ unknown argument: $arg"; echo "  usage: mise run build [linux|windows] [--debug] [--dirty]"; exit 1 ;;
  esac
done
[ ${#platforms[@]} -eq 0 ] && platforms=(linux windows)

# Every export target this script knows: the preset name, the CPU architecture
# the preset is pinned to (`binary_format/architecture` in export_presets.cfg)
# and the executable's extension. The architecture is here and not only there
# because the preflight needs it to pick `[libraries]` keys.
target_of() {
  case "$1" in
    linux)   echo "Linux x86_64 .x86_64" ;;
    windows) echo "Windows x86_64 .exe" ;;
  esac
}

# ── preflight: a declared library must exist ───────────────────────────────
# See header note 6. This runs before anything slow, and before the stamp, so
# a missing binary costs a message instead of an asset import plus an export.

# Both bundled editor addons ship .gdextension files, and the presets drop them
# on the floor. So does anything under a .gdignore (native/godot-cpp), and so
# does a nested worktree checkout, which has its own gitignored native/bin.
preset_exclude_filter=$(sed -n 's/^exclude_filter="\(.*\)"$/\1/p' export_presets.cfg | head -1)

is_exported_path() {
  local path="$1" dir pat
  case "$path" in .worktrees/*) return 1 ;; esac
  dir=$(dirname "$path")
  while [ "$dir" != "." ] && [ "$dir" != "/" ]; do
    [ -f "$dir/.gdignore" ] && return 1
    dir=$(dirname "$dir")
  done
  local IFS=,
  for pat in $preset_exclude_filter; do
    pat="${pat#"${pat%%[![:space:]]*}"}"
    [ -z "$pat" ] && continue
    # shellcheck disable=SC2053  # the filter IS a glob; that is the point
    [[ "$path" == $pat ]] && return 1
  done
  return 0
}

# The libraries one export would ship: every `[libraries]` key whose feature
# tags are ALL satisfied by this export. That subset rule is the engine's own,
# and it is what makes an `editor`-only key (both addons) and a `debug` key on
# a release run invisible here, with no platform special-cased as "tolerant".
declared_libraries() {
  local platform="$1" arch="$2" gdext="$3" key value tag ok
  sed -n '/^\[libraries\]/,/^\[/p' "$gdext" \
    | sed -n 's/^[[:space:]]*\([A-Za-z0-9._]\+\)[[:space:]]*=[[:space:]]*"\(.*\)"[[:space:]]*$/\1 \2/p' \
    | while read -r key value; do
        ok=1
        for tag in ${key//./ }; do
          case "$tag" in
            "$platform"|"$mode"|"$arch") ;;
            *) ok=0 ;;
          esac
        done
        # A path is either res:// (project-relative) or relative to the
        # .gdextension's own directory — the bundled git plugin uses the latter.
        case "$value" in
          res://*) value="${value#res://}" ;;
          *)       value="$(dirname "$gdext")/$value" ;;
        esac
        [ "$ok" = 1 ] && printf '%s\n' "$value"
      done
}

# Every library path, repo-relative, that `$1`/`$2` would try to ship.
shipped_libraries() {
  local platform="$1" arch="$2" gdext lib
  while IFS= read -r gdext; do
    gdext="${gdext#./}"
    is_exported_path "$gdext" || continue
    while IFS= read -r lib; do
      [ -n "$lib" ] && is_exported_path "$lib" && printf '%s\n' "$lib"
    done < <(declared_libraries "$platform" "$arch" "$gdext")
  done < <(find . -name '*.gdextension' | sort)
}

missing_any=0
for p in "${platforms[@]}"; do
  read -r _preset arch _ext <<<"$(target_of "$p")"
  missing=()
  while IFS= read -r lib; do
    # -e, not -f: a macOS library is a .framework directory.
    [ -e "$lib" ] || missing+=("$lib")
  done < <(shipped_libraries "$p" "$arch")
  [ ${#missing[@]} -eq 0 ] && continue
  missing_any=1
  echo "✗ the $p export declares a GDExtension library that does not exist:"
  printf '    %s\n' "${missing[@]}"
  echo ""
  echo "  Godot's exporter hard-fails on a declared-but-missing library — this is"
  echo "  NOT the runtime fallback BladeSim is designed around (#806). Build it:"
  echo ""
  echo "      mise run native:build -- template_$mode $p"
  echo ""
done
[ "$missing_any" -eq 1 ] && exit 1

# ── identity ───────────────────────────────────────────────────────────────
branch=$(git rev-parse --abbrev-ref HEAD)
[ "$branch" = "HEAD" ] && branch=""
sha=$(git rev-parse --short=7 HEAD)
# A worktree's .git is a file, not a directory — same test BuildInfo makes.
worktree=""
[ -f .git ] && worktree=$(basename "$(git rev-parse --git-dir)")

# `diff HEAD` covers staged and unstaged; untracked files are listed separately
# because they can absolutely change a build (a new .tres a scene loads) and a
# diff never shows them.
dirty_diff=$(git diff HEAD)
untracked=$(git ls-files --others --exclude-standard)
if [ -n "$dirty_diff" ] || [ -n "$untracked" ]; then
  if [ "$allow_dirty" -eq 0 ]; then
    echo "✗ working tree is dirty — the stamped sha $sha would not describe this build."
    git status --short | head -20
    echo ""
    echo "  Commit first, or pass --dirty to stamp <sha>+<digest of the diff>"
    echo "  (still exact: peers off the same tree match, any difference refuses)."
    exit 1
  fi
  # Untracked file NAMES, not contents: enough to make "you added a file" a
  # different build, without reading arbitrary blobs into the digest.
  digest=$(printf '%s\n%s\n' "$dirty_diff" "$untracked" | sha1sum | cut -c1-7)
  sha="${sha}+${digest}"
  mkdir -p "$OUT"
  printf '%s\n' "$dirty_diff" > "$OUT/${digest}.diff"
  printf '%s\n' "$untracked" > "$OUT/${digest}.untracked"
  echo "⚠ dirty build: stamping $sha (diff kept at $OUT/${digest}.diff)"
fi

# The stamp is generated, never committed, and never left behind: a stale one in
# the checkout would be read by any run whose .git lookup failed, and would then
# describe a commit that is no longer HEAD.
trap 'rm -f "$STAMP"' EXIT
{
  echo "; Generated by \`mise run build\` — gitignored, packed into the export."
  echo "[build]"
  echo "branch=\"$branch\""
  echo "short_sha=\"$sha\""
  echo "worktree=\"$worktree\""
} > "$STAMP"
echo "→ stamping $sha${branch:+ ($branch)}"

# ── export ─────────────────────────────────────────────────────────────────
# A cold .godot has no import cache, and a headless export against one produces
# an artifact missing every imported asset. Cheap when already warm.
echo "→ importing assets…"
godot --headless --import >/dev/null 2>&1 || true

export_one() {
  local platform="$1" preset="$2" arch="$3" ext="$4"
  # Two statements: bash expands every word of a `local` before assigning any
  # of them, so `path` cannot read `dir` on the same line under `set -u`.
  local dir="$OUT/$platform/$name"
  local path="$dir/$name$ext"
  # The whole directory goes, so a rebuild cannot leave one stale library from
  # the previous run sitting beside the new executable.
  rm -rf "$dir"
  mkdir -p "$dir"
  echo "→ exporting $preset ($mode) → $dir/"
  local log
  log=$(godot --headless "--export-$mode" "$preset" "$path" 2>&1) || true
  if [ ! -s "$path" ]; then
    printf '%s\n' "$log"
    echo "✗ $preset export produced nothing at $path"
    exit 1
  fi
  # Header note 5: the executable alone is not the artifact. Every library the
  # preflight cleared has to have landed beside it, or this build silently runs
  # on a slower fallback with nothing to say so.
  local lib
  while IFS= read -r lib; do
    if [ ! -s "$dir/$(basename "$lib")" ]; then
      printf '%s\n' "$log"
      echo "✗ $preset export did not copy $(basename "$lib") next to the executable"
      exit 1
    fi
  done < <(shipped_libraries "$platform" "$arch")
  printf '%s\n' "$log" | grep -iE '^(ERROR|WARNING)' | head -5 || true
  echo "✓ $preset  $(du -sh "$dir" | cut -f1)  $dir/"
}

# A debug and a release export off the same commit share a sha; without the
# suffix the second would silently overwrite the first. The date is the
# COMMIT's, not the build's — the same build made twice keeps one name.
suffix="$sha"
[ "$mode" = "debug" ] && suffix="$sha-debug"
name="skill-tree-of-life-$(git show -s --format=%cd --date=format:%Y-%m-%d HEAD)-$suffix"

for p in "${platforms[@]}"; do
  read -r preset arch ext <<<"$(target_of "$p")"
  export_one "$p" "$preset" "$arch" "$ext"
done

echo ""
echo "Ship the whole directory — the executable alone loses the GDExtension"
echo "libraries beside it, and with them the native blade solver."
echo "Both machines must run the SAME build — the link refuses a sha mismatch"
echo "at hello and prints both stamps, and the directories say $name on both."
echo "Host on one, JOIN with its LAN IP on the other."

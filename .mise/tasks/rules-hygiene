#!/usr/bin/env python3
#MISE description="Report rule-tier invariant violations: `mise run rules-hygiene [-- --json|--strict]`"
"""
Rule-tier hygiene. Reports; fixes nothing — same contract as `gh-project hygiene`.

The always-on tier is injected into every turn of every session, so its size is a
tax on all future work. This checks the invariants that keep it small and the
scoped tier honest. See docs/domain/breadcrules.md.

Two headline checks. DOC ACCRETION is the newer one: a docs/domain page that
grew sharply in the last month, which is how a diagnostic doc turns into a
paranoia generator (see the DOCS constants below). The other is DEAD GLOB: a `paths:` pattern matching zero files makes a
rule that silently never loads. It looks fine, ships green, and nobody finds out.
Nothing else in the repo can catch that.
"""
import fnmatch
import glob
import json
import subprocess
import os
import re
import sys

RULES = ".claude/rules"
ALWAYS_ON_BUDGET = 4000   # bytes across the always-on RULE tier
CLAUDE_MD_BUDGET = 12000  # CLAUDE.md is always-on too, and is the biggest single payload
USER_TIER_BUDGET = 3000   # ~/.claude: the memory index + global unscoped rules
# What a session actually pays before it reads anything. Raised 16000 -> 16500 on
# 2026-08-21 when the ~/.claude tier became visible: it was always being paid, so
# the ceiling moves by less than the newly-counted bytes, deliberately — the point
# is to acknowledge the tier, not to hand out slack.
COMBINED_BUDGET = 16500
# What a scoped rule really costs is share-of-tree x size, not either alone: a
# tiny rule on a wide glob is cheap, a fat rule on a medium glob is not. Flag the
# product, in bytes-per-average-session.
EXPECTED_COST_MAX = 1500
CRUMB_MAX = 600          # a single always-on rule above this isn't a crumb
SCOPED_MAX_LINES = 150   # above this, a scoped rule is a doc wearing a rule's hat

# The docs/domain tier is read on demand, so it gets no total budget — a big doc
# is only paid for by the agent who opens it. What it gets instead is a GROWTH
# check, because the failure mode here is not size, it is accretion: a doc that
# grows without any addition citing an observed incident, until it primes wrong
# diagnoses. Attested — godot-workflow.md's class-cache section regrew 91% by
# bytes in the month AFTER 963618ef deliberately cut it back, and every addition
# in that window cited no reproduced instance (audit 2026-08-29, see ee42f80).
# Growth is the signal a pure size cap misses: that file was never the biggest.
DOCS = "docs/domain"
DOC_MAX_BYTES = 36000     # p90 of the tier on 2026-08-29 (median 12k, max 41.6k)
# Calibration matters more than the mechanism here. A doc growing next to active
# feature work is HEALTHY, and at 25%/30d this fired on 7 of 42 docs — a check
# that noisy is the anxiety failure mode 963618ef already cost this repo once.
# The real signal is a doc that is ALREADY MATURE and still growing fast, so the
# floor does most of the work. At 60/15000 the tier yields one finding.
DOC_GROWTH_PCT = 60       # growth over the window that reads as accretion
DOC_GROWTH_DAYS = 30
DOC_GROWTH_FLOOR = 15000  # a doc smaller than this is still being written


def user_always_on():
    """Always-on bytes that live OUTSIDE the repo, so nothing else can see them:
    the auto-memory index for this project, and any unscoped ~/.claude rule.
    Both are injected into every turn exactly like a crumb is.

    The memory dir is keyed by a path slug. Resolve it from the MAIN checkout, not
    cwd: ~/.claude/projects holds exactly one entry for this repo and none for any
    worktree (checked 2026-08-21), so a drone in .worktrees/<slug>/ keyed off cwd
    would silently report 0 instead of the tier it is actually paying."""
    home = os.path.expanduser("~/.claude")
    root = subprocess.run(["git", "rev-parse", "--path-format=absolute",
                           "--git-common-dir"], capture_output=True, text=True)
    base = os.path.dirname(root.stdout.strip()) if root.returncode == 0 else os.getcwd()
    slug = (base or os.getcwd()).replace("/", "-")
    paths = [os.path.join(home, "projects", slug, "memory", "MEMORY.md")]
    for p in sorted(glob.glob(os.path.join(home, "rules", "*.md"))):
        head = open(p, encoding="utf-8").read(400)
        if not (head.startswith("---") and "paths:" in head):
            paths.append(p)
    files = [(os.path.relpath(p, os.path.dirname(home)), os.path.getsize(p))
             for p in paths if os.path.isfile(p)]
    return sum(s for _, s in files), files

SKIP_DIRS = (".godot/", ".claude/worktrees/", ".worktrees/", ".git/")

# TODO: a check for prescriptive commands a mise task now owns. When `mise run
# refresh` landed, six rules/skills still told agents to run the raw command and
# hand-diff — the task existed but nothing routed to it, so the improvement was
# inert until someone grepped by hand (9400d48). Detecting "this doc prescribes
# a command that a task wraps" would catch that class of staleness.


def frontmatter(text):
    """Return (paths list, had_frontmatter). No frontmatter => always-on."""
    if not text.startswith("---"):
        return [], False
    end = text.find("\n---", 3)
    if end == -1:
        return [], False
    block = text[3:end]
    if not re.search(r"^paths:", block, re.M):
        return [], True
    return re.findall(r'^\s*-\s*"([^"]+)"', block, re.M), True


def matches_any(pattern):
    """Does this paths: pattern match at least one real file?"""
    for hit in glob.glob(pattern, recursive=True):
        if not any(s in hit + "/" for s in SKIP_DIRS) and os.path.isfile(hit):
            return True
    # `dir/**` should also count a bare file directly under dir
    if pattern.endswith("/**"):
        return matches_any(pattern[:-1] + "*")
    return os.path.isfile(pattern)


def doc_baseline_sha(days):
    """The commit HEAD was at `days` ago, or None in a shallow/young repo."""
    out = subprocess.run(["git", "rev-list", "-1", f"--before={days} days ago", "HEAD"],
                         capture_output=True, text=True)
    return out.stdout.strip() or None


def blob_size(sha, path):
    """Byte size of `path` at `sha`, or None if it did not exist there."""
    out = subprocess.run(["git", "cat-file", "-s", f"{sha}:{path}"],
                         capture_output=True, text=True)
    return int(out.stdout.strip()) if out.returncode == 0 else None


_SOURCES = None


def tracked_sources():
    global _SOURCES
    if _SOURCES is None:
        out = subprocess.run(["git", "ls-files", "*.gd", "*.tscn", "*.tres", "*.gdshader"],
                             capture_output=True, text=True).stdout
        _SOURCES = [f for f in out.splitlines()
                    if not any(d in f + "/" for d in SKIP_DIRS)]
    return _SOURCES


def matched_share(patterns):
    """Fraction of tracked source files this rule's paths: pulls in."""
    files = tracked_sources()
    if not files:
        return 0.0
    hit = set()
    for pat in patterns:
        for f in files:
            if f in hit:
                continue
            if fnmatch.fnmatch(f, pat) or (pat.endswith("/**") and f.startswith(pat[:-2])):
                hit.add(f)
    return len(hit) / len(files)


def main():
    as_json = "--json" in sys.argv
    strict = "--strict" in sys.argv
    findings = []
    always_on_total = 0
    always_on, scoped = [], []

    for path in sorted(glob.glob(f"{RULES}/*.md")):
        name = os.path.basename(path)
        text = open(path, encoding="utf-8").read()
        size = len(text.encode("utf-8"))
        paths, _ = frontmatter(text)

        if not paths:
            always_on.append((name, size))
            always_on_total += size
            if size > CRUMB_MAX:
                findings.append({
                    "check": "fat-crumb", "file": path, "bytes": size,
                    "msg": f"always-on but {size}B (>{CRUMB_MAX}) — scope it with "
                           f"paths:, or move the body to docs/domain/ and leave one line",
                })
        else:
            lines = text.count("\n") + 1
            scoped.append((name, size, lines))
            if lines > SCOPED_MAX_LINES:
                findings.append({
                    "check": "doc-in-a-rule", "file": path, "lines": lines,
                    "msg": f"{lines} lines (>{SCOPED_MAX_LINES}) — a rule this long is a "
                           f"doc; move the narrative to docs/domain/ and keep the gotchas",
                })
            share = matched_share(paths)
            expected = share * size
            if expected > EXPECTED_COST_MAX:
                findings.append({
                    "check": "expensive-scope", "file": path,
                    "share": round(share, 2), "expected_bytes": int(expected),
                    "msg": f"~{share:.0%} of tracked source x {size}B = ~{int(expected)}B "
                           f"per average session (max {EXPECTED_COST_MAX}B) — either "
                           f"narrow the glob or cut the rule",
                })
            dead = [p for p in paths if not matches_any(p)]
            for pat in dead:
                fatal = len(dead) == len(paths)
                findings.append({
                    "check": "dead-glob", "file": path, "pattern": pat, "fatal": fatal,
                    "msg": f'paths: "{pat}" matches no file'
                           + (" — ALL patterns dead, this rule NEVER loads"
                              if fatal else " (other patterns still match)"),
                })

        for link in re.findall(r"\((?!https?:)([^)\s#]+\.md)\)", text):
            target = link if link.startswith(("docs/", ".claude/")) else \
                os.path.normpath(os.path.join(os.path.dirname(path), link))
            if not os.path.isfile(target):
                findings.append({
                    "check": "broken-link", "file": path, "target": link,
                    "msg": f"links to {link}, which does not exist",
                })
        for bare in re.findall(r"See (docs/domain/[\w.-]+\.md)", text):
            if not os.path.isfile(bare):
                findings.append({
                    "check": "dead-crumb", "file": path, "target": bare,
                    "msg": f"crumb points at {bare}, which does not exist",
                })

    docs, doc_total = [], 0
    base = doc_baseline_sha(DOC_GROWTH_DAYS)
    for path in sorted(glob.glob(f"{DOCS}/*.md")):
        size = os.path.getsize(path)
        doc_total += size
        was = blob_size(base, path) if base else None
        grew = round((size - was) / was * 100) if was else None
        docs.append((os.path.basename(path), size, grew))
        if size > DOC_MAX_BYTES:
            findings.append({
                "check": "fat-doc", "file": path, "bytes": size,
                "msg": f"{size}B (>{DOC_MAX_BYTES}) — past the point an agent reads it "
                       f"end to end; split by topic or cut what no longer earns its place",
            })
        if grew is not None and size >= DOC_GROWTH_FLOOR and grew >= DOC_GROWTH_PCT:
            findings.append({
                "check": "doc-accretion", "file": path, "growth_pct": grew,
                "msg": f"+{grew}% in {DOC_GROWTH_DAYS}d ({was}B -> {size}B) — check the "
                       f"commit bodies behind that growth actually cite observed "
                       f"incidents; if they assert a cause without one, cut them "
                       f"(.claude/rules/writing-rules.md)",
            })

    claude_md = os.path.getsize("CLAUDE.md") if os.path.isfile("CLAUDE.md") else 0
    user_tier, user_files = user_always_on()
    combined = always_on_total + claude_md + user_tier
    for label, actual, budget, key in (
        ("always-on rule tier", always_on_total, ALWAYS_ON_BUDGET, "tier-over-budget"),
        ("CLAUDE.md", claude_md, CLAUDE_MD_BUDGET, "claude-md-over-budget"),
        ("~/.claude user tier", user_tier, USER_TIER_BUDGET, "user-tier-over-budget"),
        ("combined always-on", combined, COMBINED_BUDGET, "always-on-over-budget"),
    ):
        if actual > budget:
            findings.append({"check": key, "bytes": actual,
                             "msg": f"{label} is {actual}B (budget {budget}B)"})

    known = {os.path.basename(p) for p in glob.glob(f"{RULES}/*.md")}
    for doc in glob.glob("docs/**/*.md", recursive=True) + glob.glob(f"{RULES}/*.md") \
            + glob.glob(".claude/skills/**/*.md", recursive=True) + ["CLAUDE.md", "README.md"]:
        if not os.path.isfile(doc):
            continue
        for ref in set(re.findall(r"\.claude/rules/([\w.-]+\.md)", open(doc, encoding="utf-8").read())):
            if ref not in known:
                findings.append({
                    "check": "stale-reference", "file": doc, "target": ref,
                    "msg": f"references .claude/rules/{ref}, which no longer exists",
                })

    if as_json:
        print(json.dumps({"always_on_bytes": combined,
                          "rule_tier_bytes": always_on_total,
                          "user_tier_bytes": user_tier,
                          "claude_md_bytes": claude_md,
                          "doc_tier_bytes": doc_total, "findings": findings}, indent=2))
        return 1 if (findings and strict) else 0

    print(f"ALWAYS-ON (paid by every session before it reads anything): "
          f"{combined}B / {COMBINED_BUDGET}B")
    print(f"  {claude_md:6d}  CLAUDE.md  (budget {CLAUDE_MD_BUDGET}B)")
    print(f"  {always_on_total:6d}  rule tier, {len(always_on)} crumbs "
          f"(budget {ALWAYS_ON_BUDGET}B)")
    print(f"  {user_tier:6d}  ~/.claude user tier, {len(user_files)} file(s) "
          f"(budget {USER_TIER_BUDGET}B)")
    for n, s in sorted(user_files, key=lambda x: -x[1]):
        print(f"  {s:6d}    {n}")
    for n, s in sorted(always_on, key=lambda x: -x[1]):
        print(f"  {s:6d}  {n}")
    print(f"\nScoped: {len(scoped)} rules, {sum(s for _, s, _ in scoped)}B (loaded on demand)")
    for n, s, l in sorted(scoped, key=lambda x: -x[1])[:5]:
        print(f"  {s:6d}  {l:4d}L  {n}")

    print(f"\nDocs: {len(docs)} in {DOCS}/, {doc_total}B (read on demand, no total budget)")
    for n, sz, g in sorted(docs, key=lambda x: -(x[2] or 0))[:5]:
        print(f"  {sz:6d}  {('%+d%%' % g) if g is not None else 'new':>6}"
              f" /{DOC_GROWTH_DAYS}d  {n}")

    if not findings:
        print("\n✓ no violations")
        return 0
    print(f"\n{len(findings)} violation(s):")
    for f in findings:
        loc = f.get("file", "-")
        print(f"  [{f['check']}] {loc}\n      {f['msg']}")
    return 1 if strict else 0


if __name__ == "__main__":
    sys.exit(main())

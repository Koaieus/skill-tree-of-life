#!/usr/bin/env bash
#MISE description="Manage the kanban board: `mise gh-project -- add|status|priority|size <issue> [value]`"
set -euo pipefail

PROJECT=${GH_PROJECT_NUMBER:-1}
OWNER=${GH_PROJECT_OWNER:-@me}
PROJECT_ID=${GH_PROJECT_ID:-PVT_kwHOAExWR84BcS99}
REPO=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || echo "Koaieus/skill-tree-of-life")

FIELD_STATUS="PVTSSF_lAHOAExWR84BcS99zhW81wo"
FIELD_PRIORITY="PVTSSF_lAHOAExWR84BcS99zhW82Ck"
FIELD_SIZE="PVTSSF_lAHOAExWR84BcS99zhW82Co"

# --- GraphQL budget hygiene --------------------------------------------------
# GitHub bills GraphQL by the *requested* connection sizes, not rows returned.
# `gh project item-list --format json` asks for items(first:100){ fieldValues
# (first:100){…} } — that nested fieldValues expansion is what makes each page
# cost ~100+ points. (`--limit 999` is a red herring: gh stops paginating at the
# first short page, so a sub-100-item board fetches ONE page regardless.) A burst
# of commands for one issue (add+status+size+priority) used to run four such
# queries; bulk-wiring a dozen issues ran dozens and repeatedly exhausted the
# 5000-pt budget.
#
# Two fixes:
#  1. `ids_json` — a LEAN custom query for the hot path (issue# → item-id, all a
#     set-field call needs). It requests only id + content.number, no
#     fieldValues, so each page costs ~1 point instead of ~100+, and --paginate
#     makes it correct at any board size (no magic limit to guess).
#  2. A short-lived tempfile cache on the ID MAP ONLY. A set-burst
#     (add+status+size+priority for one issue) reuses one lean fetch instead of
#     one-per-command. item-add invalidates it (membership changed); field edits
#     don't (item-ids are stable), so id lookups stay correct.
#
# The FULL item-list (field values) is deliberately NOT cached — `list` and
# read-mode must reflect the live board. Parallel agents use `list` to find work
# to pick up, so a stale read there risks two agents claiming the same issue.
# Reads are infrequent; the burst problem was writes, and (1)+(2) already fix it.
CACHE_TTL=${GH_PROJECT_CACHE_TTL:-15}
CACHE_TMP="${TMPDIR:-/tmp}/gh-project-${PROJECT}-items.tmp"
ID_CACHE="${TMPDIR:-/tmp}/gh-project-${PROJECT}-ids.txt"

# Lean "<number> <item-id>" map — cheap query, the hot path for field edits.
ids_json() {
  if [ -f "$ID_CACHE" ]; then
    local age=$(( $(date +%s) - $(stat -c %Y "$ID_CACHE" 2>/dev/null || echo 0) ))
    if [ "$age" -ge 0 ] && [ "$age" -lt "$CACHE_TTL" ]; then cat "$ID_CACHE"; return 0; fi
  fi
  local tmp="${ID_CACHE}.tmp.$$"
  if gh api graphql --paginate -f id="$PROJECT_ID" -f query='
      query($id: ID!, $endCursor: String) {
        node(id: $id) {
          ... on ProjectV2 {
            items(first: 100, after: $endCursor) {
              nodes { id content { ... on Issue { number } ... on PullRequest { number } } }
              pageInfo { hasNextPage endCursor }
            }
          }
        }
      }' \
      --jq '.data.node.items.nodes[] | select(.content.number != null) | "\(.content.number) \(.id)"' \
      > "$tmp" && [ -s "$tmp" ]; then
    mv -f "$tmp" "$ID_CACHE"; cat "$ID_CACHE"
  else
    rm -f "$tmp"
    [ -f "$ID_CACHE" ] && cat "$ID_CACHE" || true   # stale fallback / empty
  fi
}

# Full item-list JSON (with field values) — read/list display paths. Always
# fetched fresh (see the "NOT cached" note above): correctness over cost here.
items_json() {
  local tmp="${CACHE_TMP}.$$"
  if gh project item-list "$PROJECT" --owner "$OWNER" --limit 999 --format json > "$tmp" && [ -s "$tmp" ]; then
    cat "$tmp"; rm -f "$tmp"
  else
    rm -f "$tmp"
    echo '{"items":[]}'   # query failed (e.g. rate-limited) → empty, not partial
  fi
}

# Membership changed (item added) → drop the id map so the next lookup refetches.
invalidate_cache() { rm -f "$ID_CACHE" "${ID_CACHE}.tmp.$$"; }

item_id() {
  ids_json | awk -v n="$1" '$1==n {print $2; exit}'
}

ensure_item() {
  local issue=$1
  local id
  id=$(item_id "$issue")
  if [ -z "$id" ]; then
    gh project item-add "$PROJECT" --owner "$OWNER" --url "https://github.com/$REPO/issues/$issue" >/dev/null
    invalidate_cache
    id=$(item_id "$issue")
  fi
  echo "$id"
}

cmd_add() {
  local issue=$1
  local id
  id=$(item_id "$issue")
  [ -n "$id" ] && { echo "✓ issue #$issue already in project"; return; }
  gh project item-add "$PROJECT" --owner "$OWNER" --url "https://github.com/$REPO/issues/$issue"
  invalidate_cache
  echo "✓ issue #$issue added to project"
}

cmd_status() {
  local issue=$1 status=${2:-}
  local id
  id=$(ensure_item "$issue")
  [ -n "$id" ] || exit 1

  if [ -z "$status" ]; then
    items_json \
      | jq -r '.items[] | select(.content.number == '$issue') | .status // empty'
    return
  fi

  local option
  case "$status" in
    backlog)        option="f75ad846" ;;
    ready)          option="61e4505c" ;;
    in-progress|ip)  option="47fc9ee4" ;;
    in-review|ir)    option="df73e18b" ;;
    done)           option="98236657" ;;
    *) echo "✗ unknown status: $status (backlog|ready|in-progress|in-review|done)"; exit 1 ;;
  esac
  gh project item-edit --id "$id" --project-id "$PROJECT_ID" --field-id "$FIELD_STATUS" --single-select-option-id "$option"
  echo "✓ issue #$issue status → $status"
}

cmd_priority() {
  local issue=$1 priority=${2:-}
  local id option
  id=$(ensure_item "$issue") || exit 1

  if [ -z "$priority" ]; then
    # gh emits custom single-select fields lowercased (`priority`, not `Priority`).
    items_json \
      | jq -r --arg i "$issue" '.items[] | select(.content.number == ($i|tonumber)) | .priority // .Priority // "—"'
    return
  fi

  case "$priority" in
    p0|P0) option="79628723" ;;
    p1|P1) option="0a877460" ;;
    p2|P2) option="da944a9c" ;;
    *) echo "✗ unknown priority: $priority (p0|p1|p2)"; exit 1 ;;
  esac
  gh project item-edit --id "$id" --project-id "$PROJECT_ID" --field-id "$FIELD_PRIORITY" --single-select-option-id "$option"
  echo "✓ issue #$issue priority → $priority"
}

cmd_size() {
  local issue=$1 size=${2:-}
  local id option
  id=$(ensure_item "$issue") || exit 1

  if [ -z "$size" ]; then
    items_json \
      | jq -r --arg i "$issue" '.items[] | select(.content.number == ($i|tonumber)) | .size // .Size // "—"'
    return
  fi

  case "$size" in
    xs|XS) option="6c6483d2" ;;
    s|S)   option="f784b110" ;;
    m|M)   option="7515a9f1" ;;
    l|L)   option="817d0097" ;;
    xl|XL) option="db339eb2" ;;
    *) echo "✗ unknown size: $size (xs|s|m|l|xl)"; exit 1 ;;
  esac
  gh project item-edit --id "$id" --project-id "$PROJECT_ID" --field-id "$FIELD_SIZE" --single-select-option-id "$option"
  echo "✓ issue #$issue size → $size"
}

# Map a CLI status token to the board's display label. Empty = no filter.
status_label() {
  case "$1" in
    backlog)        echo "Backlog" ;;
    ready)          echo "Ready" ;;
    in-progress|ip) echo "In progress" ;;
    in-review|ir)   echo "In review" ;;
    done)           echo "Done" ;;
    all)            echo "" ;;
    *) return 1 ;;
  esac
}

# List board items in a column, so an agent can pick work up off it.
# Defaults to `ready` — the column agents claim from.
cmd_list() {
  local want="ready" as_json=false arg
  for arg in "$@"; do
    case "$arg" in
      --json) as_json=true ;;
      "") ;;
      *) want="$arg" ;;
    esac
  done

  local label
  if ! label=$(status_label "$want"); then
    echo "✗ unknown status: $want (backlog|ready|in-progress|in-review|done|all)"
    exit 1
  fi

  local items
  items=$(items_json \
    | jq --arg label "$label" '
        [ .items[]
          | select(.content.type == "Issue")
          | select($label == "" or (.status // "") == $label)
          | { number: .content.number,
              title:  .title,
              status: (.status // "—"),
              priority: (.priority // .Priority // "—"),
              size:   (.size // .Size // "—"),
              labels: (.labels // []),
              url:    .content.url } ]
        | sort_by(.priority, .number)')

  if [ "$as_json" = true ]; then
    printf '%s\n' "$items"
    return
  fi

  local count
  count=$(printf '%s' "$items" | jq 'length')
  if [ "$count" -eq 0 ]; then
    echo "— no issues in ${label:-any column}"
    return
  fi

  printf '%s\n' "$items" | jq -r '.[]
    | "#\(.number)\t[\(.priority)/\(.size)]\t\(.status)\t\(.title)"' \
    | column -t -s $'\t'
  echo ""
  echo "$count issue(s) in ${label:-all columns}"
}

usage() {
  cat <<EOF
Usage: mise gh-project -- <cmd> [args...]

Commands:
  list [<status>] [--json]     List issues in a column (default: ready).
                               status: backlog|ready|in-progress|in-review|done|all
  add <n>                      Add issue to project (idempotent)
  status <n> [<status>]        Read or set status (backlog|ready|in-progress|in-review|done)
  priority <n> [<p0|p1|p2>]    Read or set priority
  size <n> [<xs|s|m|l|xl>]    Read or set size

Examples:
  mise gh-project -- list                 # what's ready to pick up
  mise gh-project -- list in-review
  mise gh-project -- add 173
  mise gh-project -- status 173 in-progress
  mise gh-project -- priority 173 p1

Agents — machine-readable listing:
  mise run --quiet gh-project -- list ready --json | jq -r '.[].number'
  (mise's task banner goes to STDERR; don't merge it with 2>&1 or you'll
   corrupt the JSON on stdout.)
EOF
  exit 0
}

CMD=${1:-}
case "$CMD" in
  list)     shift; cmd_list "$@" ;;
  add)      cmd_add "${2:-}" ;;
  status)   cmd_status "${2:-}" "${3:-}" ;;
  priority) cmd_priority "${2:-}" "${3:-}" ;;
  size)     cmd_size "${2:-}" "${3:-}" ;;
  -h|--help|help) usage ;;
  *) usage ;;
esac

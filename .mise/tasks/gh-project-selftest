#!/usr/bin/env python3
#MISE description="Self-test for gh-project's pure jq halves (lib/hub_derive.jq, lib/claims.jq): fixture boards in, expected actions out. `mise run gh-project-selftest`"
import json, os, subprocess, sys
from datetime import datetime, timezone

JQ = os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib", "hub_derive.jq")

def item(n, status, state="OPEN", parent=None, kids=0, done=0):
    return {"number": n, "state": state, "status": status, "parent": parent, "kids_total": kids, "kids_done": done}

def derive(items):
    p = subprocess.run(["jq", "-c", "include \"hub_derive\"; derive", "-L", os.path.dirname(JQ)],
                       input=json.dumps(items), capture_output=True, text=True)
    if p.returncode != 0:
        print(p.stderr); sys.exit(1)
    return json.loads(p.stdout)

def stalled(items):
    p = subprocess.run(["jq", "-c", "include \"hub_derive\"; stalled", "-L", os.path.dirname(JQ)],
                       input=json.dumps(items), capture_output=True, text=True)
    if p.returncode != 0:
        print(p.stderr); sys.exit(1)
    return json.loads(p.stdout)

cases = [
    ("hollow hub In progress -> Done + close (closed kids archived off the board)",
     [item(1, "In progress", kids=2, done=2)],
     [{"number": 1, "from": "In progress", "to": "Done", "close": True}], []),
    ("last child In review -> hub In review",
     [item(1, "In progress", kids=2, done=1), item(3, "In review", parent=1)],
     [{"number": 1, "from": "In progress", "to": "In review", "close": False}], []),
    ("a child Ready -> hub In progress (from Needs design)",
     [item(1, "Needs design", kids=2), item(2, "Ready", parent=1), item(3, "Backlog", parent=1)],
     [{"number": 1, "from": "Needs design", "to": "In progress", "close": False}], []),
    ("a child in Intake -> no action (the owner has not routed it)",
     [item(1, "In progress", kids=1), item(2, "Intake", parent=1)],
     [], []),
    ("children only Backlog/Needs design -> no action",
     [item(1, "Needs design", kids=2), item(2, "Backlog", parent=1), item(3, "Needs design", parent=1)],
     [], []),
    ("Intake hub, no child in Intake, one Needs design -> Needs design",
     [item(1, "Intake", kids=2), item(2, "Needs design", parent=1), item(3, "Backlog", parent=1)],
     [{"number": 1, "from": "Intake", "to": "Needs design", "close": False}], []),
    ("Intake hub, no child in Intake, one Designing -> Needs design",
     [item(1, "Intake", kids=2), item(2, "Designing", parent=1), item(3, "Backlog", parent=1)],
     [{"number": 1, "from": "Intake", "to": "Needs design", "close": False}], []),
    ("children only Needs design/Designing -> no action",
     [item(1, "Needs design", kids=2), item(2, "Designing", parent=1), item(3, "Needs design", parent=1)],
     [], []),
    ("Intake hub, children only Backlog -> Backlog",
     [item(1, "Intake", kids=2), item(2, "Backlog", parent=1), item(3, "Backlog", parent=1)],
     [{"number": 1, "from": "Intake", "to": "Backlog", "close": False}], []),
    ("Intake hub with a child still in Intake -> no action",
     [item(1, "Intake", kids=2), item(2, "Intake", parent=1), item(3, "Backlog", parent=1)],
     [], []),
    ("a hub is never Ready -> In progress even with idle children",
     [item(1, "Ready", kids=1), item(2, "Backlog", parent=1)],
     [{"number": 1, "from": "Ready", "to": "In progress", "close": False}], []),
    ("OPEN child missing from the board -> unboarded, no action",
     [item(1, "In progress", kids=2, done=1)],
     [], [{"number": 1, "missing": 1}]),
    ("closed hub -> nothing",
     [item(1, "Done", "CLOSED", kids=1, done=1)],
     [], []),
    ("already derived -> idempotent",
     [item(1, "In review", kids=2, done=1), item(3, "In review", parent=1)],
     [], []),
    ("leaf issues are never touched",
     [item(1, "Ready"), item(2, "In progress")],
     [], []),
]
failed = 0
for name, items, want_actions, want_unboarded in cases:
    out = derive(items)
    got = [{k: a[k] for k in ("number", "from", "to", "close")} for a in out["actions"]]
    ok = got == want_actions and out["unboarded"] == want_unboarded
    print(("✓" if ok else "✗"), name)
    if not ok:
        failed += 1
        print("   got:", json.dumps(out))

stalled_cases = [
    ("In progress hub, every child parked -> stalled",
     [item(1, "In progress", kids=2), item(2, "Backlog", parent=1), item(3, "Needs design", parent=1)],
     [{"number": 1, "children": [2, 3]}]),
    ("hub moved back to Needs design over a Needs design child -> not stalled",
     [item(1, "Needs design", kids=2), item(2, "Backlog", parent=1), item(3, "Needs design", parent=1)],
     []),
    ("hub moved back to Backlog over all-Backlog children -> not stalled",
     [item(1, "Backlog", kids=1), item(2, "Backlog", parent=1)],
     []),
    ("hub in Needs design over all-Backlog children -> stalled (belongs in Backlog)",
     [item(1, "Needs design", kids=1), item(2, "Backlog", parent=1)],
     [{"number": 1, "children": [2]}]),
    ("hub in Backlog over a Needs design child -> stalled (belongs in Needs design)",
     [item(1, "Backlog", kids=1), item(2, "Needs design", parent=1)],
     [{"number": 1, "children": [2]}]),
    ("an Intake child -> not stalled (hygiene lists Intake on its own)",
     [item(1, "In progress", kids=2), item(2, "Intake", parent=1), item(3, "Backlog", parent=1)],
     []),
    ("a child actually moving -> not stalled",
     [item(1, "In progress", kids=2), item(2, "In progress", parent=1), item(3, "Backlog", parent=1)],
     []),
]
for name, items, want in stalled_cases:
    got = stalled(items)
    ok = got == want
    print(("✓" if ok else "✗"), "stalled:", name)
    if not ok:
        failed += 1
        print("   got:", json.dumps(got))

# in_progress_stale (lib/claims.jq): $now injected so ages are deterministic.
NOW = 1_800_000_000
HOUR = 3600
THRESHOLD = 6 * HOUR

def iso(epoch):
    return datetime.fromtimestamp(epoch, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

def aged(n, status, hours_ago, **kw):
    it = item(n, status, **kw)
    it["updated"] = iso(NOW - hours_ago * HOUR)
    return it

def in_progress_stale(items, activity):
    p = subprocess.run(["jq", "-c", "--argjson", "now", str(NOW), "--argjson", "activity", json.dumps(activity),
                        "--argjson", "threshold", str(THRESHOLD),
                        "include \"claims\"; in_progress_stale($now; $activity; $threshold)", "-L", os.path.dirname(JQ)],
                       input=json.dumps(items), capture_output=True, text=True)
    if p.returncode != 0:
        print(p.stderr); sys.exit(1)
    return json.loads(p.stdout)

stale_cases = [
    ("In progress leaf, last activity 7h ago -> reported",
     [aged(5, "In progress", 7)], {},
     [{"number": 5, "age_hours": 7}]),
    ("same leaf, a commit citing it 1h ago -> not reported",
     [aged(5, "In progress", 7)], {"5": NOW - 1 * HOUR},
     []),
    ("an old activity signal never hides a fresh updatedAt",
     [aged(5, "In progress", 1)], {"5": NOW - 30 * HOUR},
     []),
    ("hub In progress with an In progress child -> hub never reported; the old child is",
     [aged(1, "In progress", 200, kids=2), aged(2, "In progress", 9, parent=1), aged(3, "Backlog", 50, parent=1)], {},
     [{"number": 2, "age_hours": 9}]),
    ("Ready / In review / Designing with old activity -> not reported",
     [aged(5, "Ready", 48), aged(6, "In review", 48), aged(7, "Designing", 48)], {},
     []),
    ("closed In progress -> not reported (closed_not_done owns it)",
     [aged(5, "In progress", 48, state="CLOSED")], {},
     []),
    ("no updatedAt, no activity -> reported as never touched, no crash",
     [item(5, "In progress")], {},
     [{"number": 5, "age_hours": NOW // HOUR}]),
]
for name, items, activity, want in stale_cases:
    got = in_progress_stale(items, activity)
    ok = got == want
    print(("✓" if ok else "✗"), "in_progress_stale:", name)
    if not ok:
        failed += 1
        print("   got:", json.dumps(got))
total = len(cases) + len(stalled_cases) + len(stale_cases)
print(f"{total - failed}/{total} passed")
sys.exit(1 if failed else 0)

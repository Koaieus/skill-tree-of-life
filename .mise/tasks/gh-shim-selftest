#!/usr/bin/env bash
#MISE description="Self-test for .mise/bin/gh (the rate-limit retry shim): a fake gh behind it fails in scripted ways. `mise run gh-shim-selftest`"
set -u
root=$(cd "$(dirname "$0")/../.." && pwd)
work=$(mktemp -d); trap 'rm -rf "$work"' EXIT
mkdir -p "$work/fake"
# The fake "real" gh: reads a script of per-call behaviours from $work/plan,
# one line per attempt (`rl` = secondary rate limit, `q` = hourly quota spent, `err` = other failure,
# `ok` = success echoing its args and stdin), and counts calls in $work/n.
cat >"$work/fake/gh" <<'EOF'
#!/usr/bin/env bash
n=$(( $(cat "$WORK/n" 2>/dev/null || echo 0) + 1 )); echo "$n" >"$WORK/n"
mode=$(sed -n "${n}p" "$WORK/plan")
case "$mode" in
  rl)  echo "gh: You have exceeded a secondary rate limit. (HTTP 403)" >&2; exit 1 ;;
  q)   echo "GraphQL: API rate limit already exceeded for user ID 1" >&2; exit 1 ;;
  err) echo "GraphQL: Could not resolve to an Issue" >&2; exit 3 ;;
  ok)  echo "ok:$*"; [ -t 0 ] || cat; exit 0 ;;
  *)   echo "fake gh: no plan for call $n" >&2; exit 99 ;;
esac
EOF
chmod +x "$work/fake/gh"
export WORK="$work" PATH="$root/.mise/bin:$work/fake:$PATH" GH_SHIM_BACKOFF=0
fail=0
check() { if [ "$2" = "$3" ]; then echo "  ok   $1"; else echo "  FAIL $1: expected [$3] got [$2]"; fail=1; fi; }
reset() { printf '%s\n' "$@" >"$work/plan"; rm -f "$work/n"; }

echo "gh-shim-selftest"
reset rl rl ok
out=$(gh issue view 7 </dev/null 2>"$work/err"); rc=$?
check "two rate limits then success -> stdout of the success, rc 0" "$rc:$out" "0:ok:issue view 7"
check "  ...after exactly 3 calls" "$(cat "$work/n")" "3"
check "  ...retry notices on stderr" "$(grep -c 'retrying' "$work/err")" "2"

reset err
out=$(gh issue view 7 </dev/null 2>"$work/err"); rc=$?
check "non-rate-limit failure passes through once, rc kept" "$rc:$(cat "$work/n")" "3:1"
check "  ...stderr kept" "$(grep -c 'Could not resolve' "$work/err")" "1"

reset rl rl rl
out=$(GH_SHIM_RETRIES=2 gh issue edit 7 </dev/null 2>"$work/err"); rc=$?
check "gives up after GH_SHIM_RETRIES, rc kept" "$rc:$(cat "$work/n")" "1:2"
check "  ...give-up message names the secondary limit" "$(grep -c 'SECONDARY' "$work/err")" "1"
check "  ...and says the call may not have landed" "$(grep -c 'DID NOT LAND' "$work/err")" "1"

reset q ok
out=$(gh issue edit 7 </dev/null 2>"$work/err"); rc=$?
check "hourly-quota failure is not retried, rc kept" "$rc:$(cat "$work/n")" "1:1"
check "  ...message names the hourly quota" "$(grep -c 'HOURLY' "$work/err")" "1"
check "  ...and points at the REST pool" "$(grep -c 'separate 5000/h pool' "$work/err")" "1"

reset rl ok
out=$(printf 'body text' | gh issue comment 7 --body-file - 2>/dev/null); rc=$?
check "stdin is replayed on retry when gh reads it" "$rc:$out" "0:ok:issue comment 7 --body-file -
body text"

reset ok
out=$(GH_SHIM=off gh x </dev/null 2>/dev/null)
check "GH_SHIM=off passes through" "$out" "ok:x"

# Anything posted to GitHub is scanned before it leaves: a bare `@name` outside code is a live
# mention (it pinged a stranger from #1383), and a `#{name}` left in the text is a swarmify
# handle the clerk never resolved. Refused calls never reach the real gh.
posted() { reset ok; printf '%s\n' "$1" >"$work/body.md"; }
refused() { check "$1 -> refused before gh" "$rc:$(cat "$work/n" 2>/dev/null):$(grep -c "$3" "$work/err")" "64::1"; }
posted 'see #@sibling for the bargain'
out=$(gh issue comment 7 --body-file "$work/body.md" </dev/null 2>"$work/err"); rc=$?
refused "an old-style #@handle in a body file" x 'mention'
posted 'thanks @someone'
out=$(gh issue edit 7 -F "$work/body.md" </dev/null 2>"$work/err"); rc=$?
refused "a bare @name via -F" x 'mention'
posted 'the bargain addon: #{sibling}'
out=$(gh issue create --title t --body-file "$work/body.md" </dev/null 2>"$work/err"); rc=$?
refused "an unresolved #{handle}" x 'handle'
reset ok
out=$(gh issue comment 7 --body "cc @someone" </dev/null 2>"$work/err"); rc=$?
refused "a mention in --body text" x 'mention'
reset ok
out=$(printf 'hi @someone' | gh issue comment 7 --body-file - 2>"$work/err"); rc=$?
refused "a mention on stdin" x 'mention'
posted 'ping @someone'
out=$(gh api repos/o/r/issues/7/comments -F "body=@$work/body.md" </dev/null 2>"$work/err"); rc=$?
refused "gh api -F body=@file" x 'mention'
reset ok
out=$(gh api repos/o/r/issues/7/comments -f 'body=hey @someone' </dev/null 2>"$work/err"); rc=$?
refused "gh api -f body=text" x 'mention'
reset ok
out=$(GH_SHIM=off gh issue comment 7 --body "cc @someone" </dev/null 2>"$work/err"); rc=$?
refused "GH_SHIM=off is no way around the scan" x 'mention'
posted 'an `@export var x` and a `` @tool `` span, mail a@b.com
```gdscript
@onready var y
```'
out=$(gh issue comment 7 --body-file "$work/body.md" </dev/null 2>"$work/err"); rc=$?
check "@ inside code spans, fences and an email -> posted" "$rc:$(cat "$work/n")" "0:1"
reset ok
out=$(GH_MENTION_OK=1 gh issue comment 7 --body "cc @someone" </dev/null 2>"$work/err"); rc=$?
check "GH_MENTION_OK=1 posts a deliberate mention" "$rc:$(cat "$work/n")" "0:1"
reset ok
out=$(gh issue comment 7 --body "over to @Koaieus, and @koaieus" </dev/null 2>"$work/err"); rc=$?
check "the repo owner's own login -> posted" "$rc:$(cat "$work/n")" "0:1"
reset ok
out=$(gh issue view 7 --json body </dev/null 2>"$work/err"); rc=$?
check "a read is never scanned" "$rc:$(cat "$work/n")" "0:1"

# A worktree carries its own copy of this shim and mise puts BOTH .mise/bin dirs on PATH.
# Each copy must skip every shim, not just itself — or they call each other until the pids
# budget is gone (the 2026-10-02 fleet crash). The call runs inside a task-capped scope so a
# regression fails fast instead of forking the machine over.
mkdir -p "$work/wt/.mise/bin"; cp "$root/.mise/bin/gh" "$work/wt/.mise/bin/gh"
reset ok
if command -v systemd-run >/dev/null; then
  out=$(systemd-run --user --quiet --scope -p TasksMax=200 --setenv=PATH="$work/wt/.mise/bin:$root/.mise/bin:$work/fake:$PATH" \
        --setenv=WORK="$work" --setenv=GH_SHIM_BACKOFF=0 timeout 10 gh issue view 9 </dev/null 2>"$work/err"); rc=$?
  check "two shims on PATH (worktree + main) reach the real gh once, never each other" "$rc:$out:$(cat "$work/n" 2>/dev/null)" "0:ok:issue view 9:1"
else
  echo "  skip two-shims check: no systemd-run to cage a regression"
fi

[ "$fail" -eq 0 ] && echo "gh-shim-selftest: all green" || { echo "gh-shim-selftest: FAILED"; exit 1; }

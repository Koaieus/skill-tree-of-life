#!/usr/bin/env python3
#MISE description="Fail on a new upward module dependency: `mise run lint-module-deps [-- --json|--explain <src→dst>|--self-test]`"
"""
Dependency direction between top-level modules. The layer map and the allowlist
below are THE owner of that fact; docs/architecture.md is prose about them.

A reference is either
  - a `class_name` token in code (comments and string contents stripped), or
  - a `"res://…"` string literal (covers `preload(` / `load(` / bare paths).
Granularity is the top-level directory. A module may reference itself and any
module BELOW it in LAYERS; anything else is an upward edge. Every upward edge
not in ALLOWLIST is printed with its file:line and the script exits 1.

Only `.gd` files under a layered directory are scanned; `addons/ test/ tools/`
and friends are outside the map, as sources and as targets.

  ALLOWLIST DISCIPLINE: the allowlist only SHRINKS. An edge that a refactor
  removes is a one-line delete in the same landing (a stale entry is reported
  as a warning). Adding an entry is an architectural call — cite the issue
  that retires it, or say why it is permanent.
"""
import json
import os
import re
import subprocess
import sys
import tempfile

# Lowest first. A layer may reference itself and anything earlier in the list.
LAYERS = [
    # sim
    "archetypes", "stats_system", "graph", "skill_node", "entity",
    "effects", "combat", "attack", "systems",
    # spine — `procgen` sits just above `session`: it may read sim and session.
    "session", "procgen", "command", "network",
    # shell
    "presentation", "ui", "scenes", "autoload", "settings",
]
RANK = {name: i for i, name in enumerate(LAYERS)}

# Reachable from every layer (the bus). Its OWN outgoing edges are still checked.
REACHABLE_FROM_ALL = {"autoload"}

# Single files every layer may reference: permanent primitives, each with why.
ALLOWED_PRIMITIVES = {
    "ui/theme/emissive.gd": "the HDR glow tier table (hdr-color.md) — a colour "
                            "vocabulary, not UI; permanent, not a debt.",
}

# "src→dst": (retiring issue or None, what crosses). Today's upward edges,
# verbatim, as of the landing of this check (2026-09-27). The second field names
# the classes/paths that carry the edge, so a reader can grep for them;
# `--json` lists every file:line. None = no issue retires it yet.
ALLOWLIST = {
    "archetypes→skill_node": (None, "no retiring issue — CarveShape"),
    "attack→command": (None, "no retiring issue — CommandCodec, LaunchAttackCommand, WireFields"),
    "attack→session": (None, "no retiring issue — SeatPolicy"),
    "attack→settings": (None, "no retiring issue — GameSettings"),
    "attack→systems": (None, "no retiring issue — BattleSystem, VisionSystem"),
    "attack→ui": (None, "no retiring issue — HighlightProvider, ShatterField, ui/z_layers.gd"),
    "autoload→settings": (None, "no retiring issue — GameSettings, settings/default_settings.tres"),
    "combat→attack": (None, "no retiring issue — DamageInstance, HealInstance, HitInstance, Mitigation"),
    "combat→systems": (None, "no retiring issue — AllocationSystem"),
    "command→network": (1133, "WorldFingerprint"),
    "effects→attack": (None, "no retiring issue — CritRoll, DamageInstance, EuclideanRangeFinder, HealInstance, HitInstance, …"),
    "effects→combat": (None, "no retiring issue — CombatWorld, EntityCombat, NodeCombat"),
    "entity→attack": (None, "no retiring issue — AmmoTypeRoster, AttackOutcome, BladeDefenderZones, BladeDriver, BladeSim, …"),
    "entity→combat": (None, "no retiring issue — EntityCombat"),
    "entity→command": (None, "no retiring issue — AllocateCommand, Command, CommandApplier, EndTurnCommand, ReloadCommand"),
    "entity→effects": (None, "no retiring issue — AuraDistanceCache, Effect, EffectContext, EffectInstance, NodeStatus"),
    "entity→scenes": (1131, "GameRoot"),
    "entity→systems": (None, "no retiring issue — BattleSystem, LootSystem, TurnManager, VisionCircles"),
    "graph→entity": (None, "no retiring issue — Entity"),
    "graph→scenes": (None, "no retiring issue — GraphCamera"),
    "graph→skill_node": (None, "no retiring issue — ClampAddon, SkillNode"),
    "procgen→scenes": (None, "no retiring issue — GameRoot"),
    "scenes→settings": (None, "no retiring issue — GameSettings"),
    "session→network": (1133, "NetworkTransport"),
    "session→procgen": (None, "no retiring issue — GraphProcgenConfig"),

    "skill_node→attack": (None, "no retiring issue — AttackPlan, BladeDistanceConstraint, BladeState, HitInstance, SpellDef, …"),
    "skill_node→combat": (None, "no retiring issue — NodeCombat"),
    "skill_node→command": (1138, "CommandApplier, LootRoundCommand"),

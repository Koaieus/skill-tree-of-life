#!/usr/bin/env python3
#MISE description="Self-test for commit-mention-guard: synthetic Bash payloads, asserts the allow/deny matrix. `mise run commit-mention-guard-selftest`"
import json, os, subprocess, sys, tempfile

HOOK = os.path.join(os.path.dirname(os.path.abspath(__file__)), "commit-mention-guard")
tmp = tempfile.mkdtemp()
dirty = os.path.join(tmp, "dirty.txt"); open(dirty, "w").write("fix: ping @someone\n")
clean = os.path.join(tmp, "clean.txt"); open(clean, "w").write("fix: the export annotation\n")

def run(payload):
    p = subprocess.run([HOOK], input=payload if isinstance(payload, str) else json.dumps(payload), capture_output=True, text=True)
    return p.returncode, p.stdout.strip()

def bash(cmd):
    return {"tool_name": "Bash", "tool_input": {"command": cmd}}

cases = [
    ("-m with a bare mention -> deny", bash('git commit -m "fix: thanks @someone"'), True),
    ("-m with a backticked annotation -> deny (commit text is not markdown)", bash('git commit -m "fix: drop `@export` on x"'), True),
    ("heredoc -F - with a mention -> deny", bash("git commit -q -F - <<'EOF'\nfix: cc @someone\nEOF"), True),
    ("same-command cat > f && commit -F f -> deny", bash(f"cat > {tmp}/new.txt <<'EOF'\nfix: @someone\nEOF\ngit commit -F {tmp}/new.txt"), True),
    ("existing -F file with a mention -> deny", bash(f"git commit -F {dirty}"), True),
    ("existing --file= with a mention -> deny", bash(f"git commit --file={dirty}"), True),
    ("-C dir commit -m with a mention -> deny", bash('git -C wt commit -m "x @someone"'), True),
    ("an unresolved #{handle} -> deny", bash('git commit -m "feat: see #{state}"'), True),
    ("clean -m -> allow", bash('git commit -m "fix: the export annotation"'), False),
    ("clean -F file -> allow", bash(f"git commit -F {clean}"), False),
    ("co-author email trailer -> allow", bash('git commit -m "x\n\nCo-Authored-By: C <noreply@anthropic.com>"'), False),
    ("--author email -> allow", bash('git commit --author="A <a@b.com>" -m "fix: x"'), False),
    ("HEAD@{1} reflog -> allow", bash('git reset HEAD@{1} && git commit -m "fix: x"'), False),
    ("--amend --no-edit -> allow", bash("git commit --amend --no-edit"), False),
    ("not a commit: git log --author=@x -> allow", bash("git log --author=@someone"), False),
    ("not a commit: grep for @export -> allow", bash("grep -rn '@export' src"), False),
    ("GH_MENTION_OK=1 -> allow", bash('GH_MENTION_OK=1 git commit -m "cc @Koaieus"'), False),
    ("non-Bash tool -> allow", {"tool_name": "Read", "tool_input": {"file_path": dirty}}, False),
    ("garbage stdin -> silent exit 0", "garbage", False),
]
failed = 0
for name, payload, expect_deny in cases:
    code, out = run(payload)
    denied = '"permissionDecision": "deny"' in out
    ok = code == 0 and denied == expect_deny
    print(("[ok] " if ok else "[FAIL] ") + name + ("" if ok else f"  (exit={code}, out={out[:120]!r})"))
    failed += not ok
print("\nall checks passed" if not failed else f"\n{failed} check(s) FAILED")
sys.exit(1 if failed else 0)

#!/usr/bin/env python3
#MISE description="Compile-checks every .gdshader in the repo by walking the tree, plus .gdshaderinc coverage-by-inclusion: `mise run check-shaders`"
"""
Force-compiles every `.gdshader` the tree walk finds, so a shader's coverage
follows its existence on disk rather than a hand-maintained scene list (#682 —
the two-scene probe this replaced went green through a real `SHADER ERROR`
because neither `dev_sandbox.tscn` nor `meta_root.tscn` happened to instantiate
the broken shader).

Assigning a loaded `Shader` to a fresh `ShaderMaterial.shader` synchronously
calls into `RenderingServer.shader_set_code` and prints `SHADER ERROR` /
`Shader compilation failed` on a bad shader — confirmed by injection, and true
for every `shader_type` tried (canvas_item, spatial). No node needs to be added
to a tree and no frame needs to render, so the probe skips scene/mesh setup
entirely: just load + assign, in a `SceneTree`-derived headless script.

`.gdshaderinc` files aren't independently loadable as a `Shader` resource —
they're plain text pulled in by `#include`, and (per lighting.gdshaderinc's own
header comment) not always meaningful outside the includer's uniform scope. So
they're checked by proof of inclusion instead of by direct compile: the probe
walks them too, and fails if one is never `#include`-d by any walked
`.gdshader` — that shader-inc would silently carry zero coverage otherwise,
reproducing this exact issue one file type over.

Parse-clean shaders can still fail at code generation: the compiler logs
`ERROR: Condition "..." is true. Continuing.` (e.g. `TEXTURE` forwarded through
a user function's `sampler2D` parameter) and carries on. The same assign drives
that codegen headless, so any `ERROR:` line in the probe run is red -- a clean
tree logs none. `WARNING:` is not, since shaders warn legitimately. Each failure
is attributed to the shader whose `PROBE: compiling` marker precedes it;
`--self-test` plants that shape in a temp project and asserts both. Driver-level
GLSL errors still need the rendered xvfb + opengl3 recipe.
"""
import os
import re
import subprocess
import sys
import tempfile

PROBE_SCRIPT = r'''
extends SceneTree

func _initialize() -> void:
	var shaders: Array[String] = []
	var includes: Array[String] = []
	_walk("res://", shaders, includes)
	shaders.sort()
	includes.sort()

	for path in shaders:
		var shader: Shader = load(path)
		if shader == null:
			push_error("PROBE: failed to load %s" % path)
			continue
		# Marker on stderr, the stream the engine's ERROR: lines use, so a
		# failure line can be attributed to the shader compiled just before it.
		printerr("PROBE: compiling %s" % path)
		var mat := ShaderMaterial.new()
		mat.shader = shader

	for inc in includes:
		var referenced := false
		for sp in shaders:
			var text := FileAccess.get_file_as_string(sp)
			if text.find(inc) != -1:
				referenced = true
				break
		if not referenced:
			push_error("PROBE: %s is never #include-d by any .gdshader -- cannot be compile-checked" % inc)

	print("PROBE: checked %d shader(s), %d include(s)" % [shaders.size(), includes.size()])
	quit()

func _walk(dir_path: String, shaders: Array[String], includes: Array[String]) -> void:
	var dir := DirAccess.open(dir_path)
	if dir == null:
		return
	dir.list_dir_begin()
	var name := dir.get_next()
	while name != "":
		# Dot-dirs cover .git, .godot, .mise, .claude, and (in the shared main
		# checkout, not a worktree) .worktrees -- none of them are project
		# source, and .worktrees would double-probe sibling drones' scratch state.
		if name.begins_with("."):
			name = dir.get_next()
			continue
		var full := dir_path.path_join(name)
		if dir.current_is_dir():
			_walk(full, shaders, includes)
		elif name.ends_with(".gdshader"):
			shaders.append(full)
		elif name.ends_with(".gdshaderinc"):
			includes.append(full)
		name = dir.get_next()
'''

FAIL_PATTERN = re.compile(
    r"\bERROR:|SHADER ERROR|Shader compilation failed|PROBE: failed to load|PROBE: .* is never #include"
)
SUMMARY_PATTERN = re.compile(r"PROBE: checked (\d+) shader\(s\), (\d+) include\(s\)")


COMPILING_PATTERN = re.compile(r"PROBE: compiling (\S+)")

# The #908 shape: `TEXTURE` forwarded through a user function's sampler2D
# parameter. Parses clean; codegen logs `ERROR: Condition
# "!actions.custom_samplers.has(...)" is true. Continuing.`
SELF_TEST_BAD = """shader_type canvas_item;

vec4 tap(sampler2D tex, vec2 uv) {
\treturn texture(tex, uv);
}

void fragment() {
\tCOLOR = tap(TEXTURE, UV);
}
"""
# Sorts after bad.gdshader: a failure attributed one shader late would name it.
SELF_TEST_GOOD = """shader_type canvas_item;

void fragment() {
\tCOLOR = texture(TEXTURE, UV);
}
"""


def run_probe(project_path: str) -> tuple[list[str], str]:
    """Runs the probe against `project_path`; returns (failure lines, output).

    stderr is merged into stdout so markers and engine errors keep their
    order; each failure is prefixed with the shader last announced compiling.
    """
    fd, probe_path = tempfile.mkstemp(suffix=".gd", prefix="check-shaders-probe-")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(PROBE_SCRIPT)
        r = subprocess.run(
            ["godot", "--headless", "--path", project_path, "--script", probe_path],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
        )
    finally:
        os.unlink(probe_path)

    out = r.stdout
    failures = []
    current = "<before first shader>"
    for line in out.splitlines():
        m = COMPILING_PATTERN.search(line)
        if m:
            current = m.group(1)
            continue
        if FAIL_PATTERN.search(line):
            failures.append(f"{current}: {line.strip()}")
    return failures, out


def self_test() -> int:
    with tempfile.TemporaryDirectory(prefix="check-shaders-selftest-") as d:
        with open(os.path.join(d, "project.godot"), "w") as f:
            f.write("config_version=5\n")
        with open(os.path.join(d, "bad.gdshader"), "w") as f:
            f.write(SELF_TEST_BAD)
        with open(os.path.join(d, "zz_good.gdshader"), "w") as f:
            f.write(SELF_TEST_GOOD)
        failures, out = run_probe(d)
    if not failures:
        print(out[-2000:])
        print("✗ self-test: the #908 shape did not go red")
        return 1
    print("\n".join(failures))
    misattributed = [l for l in failures if not l.startswith("res://bad.gdshader: ")]
    if misattributed:
        print("✗ self-test: failure not attributed to res://bad.gdshader")
        return 1
    print("✓ self-test: the #908 shape goes red, attributed to bad.gdshader")
    return 0


def main() -> int:
    if "--self-test" in sys.argv[1:]:
        return self_test()

    failures, out = run_probe(".")
    if failures:
        print("\n".join(failures))
        print("✗ shader errors found")
        return 1

    summary = SUMMARY_PATTERN.search(out)
    if not summary:
        # The probe never reached its own summary line -- e.g. it crashed
        # mid-walk. Print what we have and fail loud rather than reporting a
        # green that didn't actually check anything (the exact failure mode
        # #682 was filed over).
        print(out[-2000:])
        print("✗ probe did not complete (no summary line found)")
        return 1

    print(f"✓ all shaders compiled clean ({summary.group(1)} shaders, "
          f"{summary.group(2)} includes)")
    return 0


if __name__ == "__main__":
    sys.exit(main())

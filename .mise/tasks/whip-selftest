def run(*argv, me=None):
    """Drive whip's own argv parser as session `me`; returns (exit code, stdout+stderr)."""
    out, saved = io.StringIO(), sys.argv
    sys.argv = ["whip", *argv]
    if me: os.environ["CLAUDE_CODE_SESSION_ID"] = me
    else: os.environ.pop("CLAUDE_CODE_SESSION_ID", None)
    code = 0
    try:
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(out):
            try:
                wh.main()
            except SystemExit as e:
                code = e.code if isinstance(e.code, int) else (0 if e.code is None else (print(e.code) or 1))
    finally:
        sys.argv = saved
    return code, out.getvalue()


def launches(since=0):
    """Every session start/stop/prompt."""
    return [c for c in calls[since:] if c.startswith("claude") and "--version" not in c and "daemon status" not in c]


today = time.strftime("%Y-%m-%d")
jpath = os.path.join(handoffs, f"whip-{today}.json")


def state():
    with open(jpath) as f:
        return json.load(f)


def poke(**kv):
    st = state(); st.update(kv)
    with open(jpath, "w") as f:
        json.dump(st, f)


def lead(name):
    return state().get("leads", {}).get(name, {})


def train(name):
    return next((t for t in state().get("trains", []) if t["name"] == name), {})


def events_since(n):
    return state().get("events", [])[n:]



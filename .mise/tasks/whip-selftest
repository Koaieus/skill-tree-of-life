def run(*argv):
    """Drive whip's own argv parser; returns (exit code, stdout+stderr)."""
    out, saved = io.StringIO(), sys.argv
    sys.argv = ["whip", *argv]
    code = 0
    try:
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(out):
            try:
                wh.main()
            except SystemExit as e:
                code = e.code if isinstance(e.code, int) else (0 if e.code is None else (print(e.code) or 1))
    finally:
        sys.argv = saved
    return code, out.getvalue()


def launches(since=0):
    """Every session start/stop/prompt, including the relieve path's re-exec of whip itself."""
    return [c for c in calls[since:] if (c.startswith("claude") and "--version" not in c and "daemon status" not in c) or wh.__file__ in c]



failed = 0


def check(label, ok):
    global failed
    print(("  ✓ " if ok else "  ✗ ") + label)
    if not ok:
        failed += 1


# --- the fence: nothing below ever execs a process ------------------------
# `sh` and `subprocess` are replaced by recorders that answer from canned
# output and drive a fake fleet (`fx["agents"]`): a `claude --bg -n <name>`
# adds a live record, `claude stop <id>` removes it iff `fx["stop_takes"]`.
calls = []
SHA = "c0ffee0123456789abcdef0123456789abcdef01"
fx = {"ready": [], "blocked_by": {}, "milestone": {}, "agents": [], "needs_design": [], "in_progress": [], "daemon": "active",
      "systemd_run_ok": True, "linger": "yes", "enable_linger_ok": True, "tasks": "", "stop_takes": True, "newer_files": False,
      "last_commit_ts": 0, "seq": 0}
CANNED = (
    ("git rev-parse master", SHA + "\n"),
    ("git worktree list --porcelain", "worktree /main\nHEAD x\n"),
    ("gh-project -- hygiene", "hygiene: clean\n"),
    ("git log --oneline", "aaaaaaa feat: thing (#10)\nbbbbbbb feat: other (#11)\n"),
    ("git log", "commit aaaaaaa\n\n    feat: thing\n\n    Closes #10\n\ncommit bbbbbbb\n\n    Closes #11\n"),
    ("gh issue list", "#99 Filed overnight\n"),
    ("agent-cost", "drone d10 · 80k\n"),
    ("claude --version", "2.9.0 (Claude Code)\n"),
    ("command -v mise", "/usr/bin/mise\n"),
)


def sid_of(name):
    return next((x["sessionId"] for x in fx["agents"] if x.get("name") == name), None)


def fake_launch(name):
    fx["seq"] += 1
    short = f"ab{fx['seq']:06d}"
    fx["agents"].append({"kind": "background", "pid": 100 + fx["seq"], "name": name, "sessionId": short + "-full-id", "state": "working"})
    return short


def fake_stop(sid):
    if fx["stop_takes"]:
        fx["agents"] = [x for x in fx["agents"] if not x["sessionId"].startswith(sid)]


def fake_sh(cmd, check=False, **kw):
    s = cmd if isinstance(cmd, str) else " ".join(cmd)
    calls.append(s)
    if "loginctl enable-linger" in s:
        if fx["enable_linger_ok"]: fx["linger"] = "yes"
        return ""
    if "loginctl show-user" in s:
        return f"Linger={fx['linger']}\n"
    if "TasksCurrent" in s:
        return f"TasksCurrent={fx['tasks']}\n"
    if "is-active" in s:
        return fx["daemon"] + "\n"
    if "claude daemon status" in s:
        return "pid: 1\nversion: x\n" if fx["daemon"] == "active" else "not running\n"
    if "systemd-run" in s:
        if fx["systemd_run_ok"]: fx["daemon"] = "active"
        return ""
    if s.startswith("claude stop "):
        fake_stop(s.split()[2]); return ""
    if "for-each-ref" in s:
        return f"{fx['last_commit_ts']}\n" if fx["last_commit_ts"] else ""
    if s.startswith("find "):
        return "/x/y\n" if fx["newer_files"] else ""
    if "list needs-design --json" in s:
        return json.dumps([{"number": n} for n in fx["needs_design"]])
    if "list in-progress --json" in s:
        return json.dumps([{"number": n} for n in fx["in_progress"]])
    for key, out in CANNED:
        if key in s:
            return out
    return ""


class FakeSubprocess:
    DEVNULL = -3

    class _R:
        stdout = ""; stderr = ""; returncode = 0

    def run(self, cmd, *a, **kw):
        s = " ".join(cmd) if not isinstance(cmd, str) else cmd
        calls.append(s); r = self._R()
        if "--bg" in s:
            if "--resume" in s:
                sid = cmd[cmd.index('--resume') + 1]
                if not any(x["sessionId"].startswith(sid) for x in fx["agents"]):
                    fx["agents"].append({"kind": "background", "pid": 999, "sessionId": sid, "status": "idle", "state": "done"})
                r.stdout = f"backgrounded · \x1b[36m{sid[:8]}\x1b[0m\n"
            else:
                r.stdout = f"backgrounded · \x1b[36m{fake_launch(cmd[cmd.index('-n') + 1])}\x1b[0m\n"
        elif s.startswith("claude stop "):
            fake_stop(cmd[2])
        return r


wh.sh = fake_sh
wh.subprocess = FakeSubprocess()

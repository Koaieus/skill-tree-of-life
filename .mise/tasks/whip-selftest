def fake_sh(cmd, check=False, **kw):
    s = cmd if isinstance(cmd, str) else " ".join(cmd)
    calls.append(s)
    if "loginctl show-user" in s:
        return f"Linger={fx['linger']}\n"
    if "TasksCurrent" in s:
        return f"TasksCurrent={fx['tasks']}\n"
    if "is-active" in s:
        return fx["daemon"] + "\n"
    if "claude daemon status" in s:
        return "pid: 1\nversion: x\n" if fx["daemon"] == "active" else "not running\n"
    if "systemd-run" in s:
        if fx["systemd_run_ok"]: fx["daemon"] = "active"
        return ""
    for key, out in CANNED:
        if key in s:
            return json.dumps([{"number": n} for n in fx["needs_design"]]) if out is None else out
    return ""


class FakeSubprocess:
    DEVNULL = -3

    class _R:
        stdout = ""; stderr = ""; returncode = 0

    def run(self, cmd, *a, **kw):
        s = " ".join(cmd) if not isinstance(cmd, str) else cmd
        calls.append(s); r = self._R()
        if "--bg" in s:  # a launch or a resume prints the backgrounded line
            name = cmd[cmd.index("-n") + 1] if "-n" in cmd else "whip"
            r = self._R(); r.stdout = f"backgrounded · \x1b[36mabcd1234\x1b[0m · {name}\n"
        return r

    def Popen(self, cmd, *a, **kw):
        calls.append(" ".join(cmd) if not isinstance(cmd, str) else cmd); return self._R()



#!/usr/bin/env python3
#MISE description="Self-test for whip v2 (the relay): a scratch handoffs dir and a zero-exec fake fleet for gh/git/claude/systemd; asserts start-from-anywhere, the trains, the lead ceiling, the baton (done → next lead / the report), relieve-me and the relief cap, needs-owner, stop draining, every watchdog path (verify-next-tick, give-up, gone/blocked/silent stalls, waiting, stop-not-taken, window reset) and the report buckets. Never launches a session, never calls gh. `mise run whip-selftest`"
import contextlib, importlib.machinery, importlib.util, io, json, os, re, sys, tempfile, time


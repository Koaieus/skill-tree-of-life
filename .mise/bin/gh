#!/usr/bin/env bash
# gh shim — retries GitHub rate limits so a burst from parallel agents degrades
# to "slow for a minute" instead of a dead clerk or drone.
#
# Contract:
#   - Sits first on PATH via mise.toml `[env._] path`; finds the real gh by
#     skipping EVERY copy of this shim (a worktree carries its own and mise
#     puts both .mise/bin dirs on PATH — two copies skipping only themselves
#     call each other until the pids budget is gone), recognised by the
#     marker line below; GH_SHIM_DEPTH is a hard guard: a shim invoked by a
#     shim refuses instead of recursing. Interactive terminals (stdin AND
#     stdout a tty) and GH_SHIM=off pass straight through — the shim exists
#     for agents.
#   - A failed call whose stderr names GitHub's SECONDARY (burst) limit is
#     retried with linear backoff (GH_SHIM_BACKOFF s × attempt, default 15;
#     GH_SHIM_RETRIES attempts, default 4 — 90 s of sleep, inside a 120 s tool
#     timeout). The PRIMARY limit (the hourly quota: "API rate limit [already]
#     exceeded" without "secondary") is never retried — it lasts until the
#     hour resets, so sleeping only turns a failure into a hang. Any other
#     failure, and every success, passes through untouched with its exit code.
#   - stdout is buffered per attempt so a retry never double-prints. stdin is
#     buffered only when an argument asks gh to read it (`-`, `--input -`,
#     `=@-`), so an inherited open pipe never blocks the shim.
#   - The give-up message is the documentation: it fires exactly when an
#     agent needs it. Long form: docs/domain/issue-workflow.md → Rate limits.
set -u
# gh-shim-marker: every copy of this file carries this line; the PATH scan skips any file that has it.

if [ "${GH_SHIM_DEPTH:-0}" -ge 1 ]; then
  echo "gh shim: invoked by another gh shim ($0) — a copy on PATH predates the marker scan; refusing to recurse" >&2
  exit 127
fi
export GH_SHIM_DEPTH=1

real=""
IFS=: read -ra dirs <<<"$PATH"
for d in "${dirs[@]}"; do
  c="$d/gh"
  [ -x "$c" ] || continue
  head -c 4096 "$c" 2>/dev/null | grep -q 'gh-shim-marker' && continue
  real="$c"; break
done
[ -n "$real" ] || { echo "gh shim: no real gh found on PATH" >&2; exit 127; }

if { [ -t 0 ] && [ -t 1 ]; } || [ "${GH_SHIM:-}" = "off" ]; then
  exec "$real" "$@"
fi

max=${GH_SHIM_RETRIES:-4}
backoff=${GH_SHIM_BACKOFF:-15}
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

stdin_file=""
if printf '%s\n' "$@" | grep -qxE -- '-|--input=-|.*=@-'; then
  stdin_file="$tmp/in"; cat >"$stdin_file"
fi

run() {
  if [ -n "$stdin_file" ]; then "$real" "$@" <"$stdin_file"
  else "$real" "$@"; fi
}

secondary() { grep -qiE 'secondary rate limit|abuse detection|HTTP 429' "$tmp/err"; }
primary()   { grep -qiE 'rate limit|RATE_LIMIT' "$tmp/err"; }

passthrough() { cat "$tmp/out"; cat "$tmp/err" >&2; exit "$rc"; }

attempt=1
while :; do
  run "$@" >"$tmp/out" 2>"$tmp/err"; rc=$?
  [ "$rc" -eq 0 ] && passthrough
  if ! secondary; then
    primary || passthrough
    cat "$tmp/out"; cat "$tmp/err" >&2
    cat >&2 <<EOF
gh shim: HOURLY GraphQL quota spent (gh ${1:-} ${2:-}) — not retried.
  It refills at the hour's reset, up to 60 min away; sleeping or re-running
  only spends turns. Read the reset with GraphQL's own counter (REST
  \`gh api rate_limit\` misreports it):
    gh api graphql -f query='{rateLimit{remaining resetAt}}'
  REST draws from a separate 5000/h pool and still works: \`gh api repos/...\`
  for reads, comments, labels, milestones; \`mise gh-project -- blocked-by\`
  and \`status\` fall back to it on their own. Assume THIS CALL DID NOT LAND
  unless stdout above shows it.
EOF
    exit "$rc"
  fi
  if [ "$attempt" -ge "$max" ]; then
    cat "$tmp/out"; cat "$tmp/err" >&2
    cat >&2 <<EOF
gh shim: gave up after $max attempts (gh ${1:-} ${2:-}) — GitHub's SECONDARY
  (burst / concurrency) limit: too many gh calls at once across sessions. It
  clears as the concurrent traffic eases, usually within minutes; the hourly
  reset is irrelevant to it. Assume THIS CALL DID NOT LAND unless stdout
  above shows it. Verify with REST (\`gh api repos/<owner>/<repo>/issues/<n>\`),
  then re-run as-is. Do not hand-poll in a loop: every probe is a request.
EOF
    exit "$rc"
  fi
  wait=$(( backoff * attempt ))
  echo "gh shim: secondary rate limit on attempt $attempt/$max (gh ${1:-} ${2:-}); retrying in ${wait}s" >&2
  sleep "$wait"
  attempt=$(( attempt + 1 ))
done

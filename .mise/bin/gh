#!/usr/bin/env bash
# gh shim — retries GitHub rate limits so a burst from parallel agents degrades
# to "slow for a minute" instead of a dead clerk or drone.
#
# Contract:
#   - Sits first on PATH via mise.toml `[env._] path`; finds the real gh by
#     skipping itself. Interactive terminals (stdin AND stdout a tty) and
#     GH_SHIM=off pass straight through — the shim exists for agents.
#   - A failed call whose stderr names a rate limit is retried with linear
#     backoff (GH_SHIM_BACKOFF s × attempt, default 60; GH_SHIM_RETRIES
#     attempts, default 5). Any other failure, and every success, is passed
#     through untouched with its exit code.
#   - stdout is buffered per attempt so a retry never double-prints. stdin is
#     buffered only when an argument asks gh to read it (`-`, `--input -`,
#     `=@-`), so an inherited open pipe never blocks the shim.
#   - The give-up message is the documentation: it fires exactly when an
#     agent needs it. Long form: docs/domain/issue-workflow.md → Rate limits.
set -u

self=$(realpath "${BASH_SOURCE[0]}")
real=""
IFS=: read -ra dirs <<<"$PATH"
for d in "${dirs[@]}"; do
  c="$d/gh"
  [ -x "$c" ] || continue
  [ "$(realpath "$c" 2>/dev/null)" = "$self" ] && continue
  real="$c"; break
done
[ -n "$real" ] || { echo "gh shim: no real gh found on PATH" >&2; exit 127; }

if { [ -t 0 ] && [ -t 1 ]; } || [ "${GH_SHIM:-}" = "off" ]; then
  exec "$real" "$@"
fi

max=${GH_SHIM_RETRIES:-5}
backoff=${GH_SHIM_BACKOFF:-60}
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

stdin_file=""
if printf '%s\n' "$@" | grep -qxE -- '-|--input=-|.*=@-'; then
  stdin_file="$tmp/in"; cat >"$stdin_file"
fi

run() {
  if [ -n "$stdin_file" ]; then "$real" "$@" <"$stdin_file"
  else "$real" "$@"; fi
}

rate_limited() {
  grep -qiE 'rate limit|RATE_LIMIT|secondary|abuse detection|HTTP 429' "$tmp/err"
}

attempt=1
while :; do
  run "$@" >"$tmp/out" 2>"$tmp/err"; rc=$?
  if [ "$rc" -eq 0 ] || ! rate_limited; then
    cat "$tmp/out"; cat "$tmp/err" >&2; exit "$rc"
  fi
  if [ "$attempt" -ge "$max" ]; then
    cat "$tmp/out"; cat "$tmp/err" >&2
    cat >&2 <<EOF
gh shim: gave up after $max attempts (gh ${1:-} ${2:-}) — GitHub rate limit.
  Run \`gh api rate_limit --jq .resources.graphql\`. If "remaining" is far
  from 0 this is the SECONDARY limit (burst / concurrency from a swarm or
  other sessions), NOT the hourly quota: waiting for "reset" does nothing;
  it clears when the concurrent gh traffic eases, usually within minutes.
  Only when remaining≈0 is it the hourly quota — then wait for the reset.
  Assume THIS CALL DID NOT LAND unless stdout above shows it. Verify with
  REST (\`gh api repos/<owner>/<repo>/issues/<n>\`, throttled separately),
  then re-run as-is. Do not hand-poll in a loop: every probe is a request.
EOF
    exit "$rc"
  fi
  wait=$(( backoff * attempt ))
  echo "gh shim: rate limit on attempt $attempt/$max (gh ${1:-} ${2:-}); retrying in ${wait}s" >&2
  sleep "$wait"
  attempt=$(( attempt + 1 ))
done

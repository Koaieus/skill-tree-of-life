metadata/_custom_type_script = "uid://ddlh35gou7ixj"

[resource]
script = ExtResource("3_466st")
pickable_in = 1
display_name = "Balanced"
description = "The vanilla class: +10 to all five attributes (STR/DEX/INT/CON/WIS), +1 STR/DEX/INT per level gained. STR/DEX/INT's flat +10 comes from the shared attribute_baseline.tres pack (D-27, #279), not hand-declared here. CON's per-level grant lives on the board intrinsic (mod_level_to_con), not here — every entity's durability scales with level regardless of core class (D-11/D-14/#269). WIS is deliberately excluded from the per-level grant (D-15): baseline xp_per_turn income stays flat forever unless the entity expands into WIS-bearing territory, which is the stall the design leans on. The baseline every other class is tuned against — every class delta is \"vs Balanced\"."
modifiers = Array[ExtResource("2_mod")]([ExtResource("6_baseline"), SubResource("mod_con"), SubResource("mod_wis"), SubResource("mod_str_per_level"), SubResource("mod_dex_per_level"), SubResource("mod_int_per_level")])
sigil = SubResource("Resource_1xoxv")
aura = SubResource("heal_aura_balanced")

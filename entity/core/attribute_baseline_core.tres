[gd_resource type="Resource" script_class="CoreClass" format=3]

[ext_resource type="Script" uid="uid://che6xhl6srqh3" path="res://stats_system/stat_modifier.gd" id="1_mod"]
[ext_resource type="Script" uid="uid://ci0mmuifd3c71" path="res://entity/core/core_class.gd" id="2_core"]

[sub_resource type="Resource" id="mod_str"]
script = ExtResource("1_mod")
stat_id = &"strength"
value = 10.0

[sub_resource type="Resource" id="mod_dex"]
script = ExtResource("1_mod")
stat_id = &"dexterity"
value = 10.0

[sub_resource type="Resource" id="mod_int"]
script = ExtResource("1_mod")
stat_id = &"intelligence"
value = 10.0

[resource]
script = ExtResource("2_core")
display_name = "Attribute Baseline"
description = "Composition base (D-27, #279): the +10 STR/DEX/INT block shared verbatim by every class that hasn't diverged from it. Not a selectable class on its own — other CoreClass .tres files add this resource to their `composes` array instead of hand-declaring the same three modifiers. Edit here, every composing class picks it up."
modifiers = Array[ExtResource("1_mod")]([SubResource("mod_str"), SubResource("mod_dex"), SubResource("mod_int")])

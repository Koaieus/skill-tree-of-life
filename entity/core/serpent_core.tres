[resource]
script = ExtResource("7_7hpuy")
pickable_in = 3
display_name = "Serpent"
description = "The Coil — two auras at once: a node gains armor and damage the further it winds from the core in hops, and loses armor and damage the further it sits from the core in space. The sweet spot is many hops away yet spatially close — a tight coil, or a wind bridging a chasm."
modifiers = Array[ExtResource("2_mod")]([ExtResource("8_5dwqy")])
effects = Array[ExtResource("8_effect")]([SubResource("aura_hop_buff"), SubResource("aura_euclid_penalty")])
sigil = SubResource("Resource_u38nb")

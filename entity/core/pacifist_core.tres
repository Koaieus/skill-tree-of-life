[resource]
script = ExtResource("1_core")
pickable_in = 3
display_name = "Pacifist"
description = "Movement and deallocation points are set to zero outright — no free repositioning, no free reshaping. Its only income for both is action points left unspent: whatever AP survives to turn's end converts to surplus movement AND deallocation points next round, at double rate. Spend your AP to attack and you're locked in place until the next windfall; hold back and you inch forward and reshape instead. Extra armor and action points round out the trade."
modifiers = Array[ExtResource("2_mod")]([SubResource("mod_str"), SubResource("mod_dex"), SubResource("mod_int"), SubResource("mod_armor"), SubResource("mod_ap"), SubResource("mod_transfer"), SubResource("mod_mp_zero"), SubResource("mod_dp_zero")])
sigil = ExtResource("3_sigil")

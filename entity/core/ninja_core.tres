[ext_resource type="PackedScene" path="res://attack/range_finder/visuals/range_ring.tscn" id="5_122wq"]
[ext_resource type="Script" uid="uid://bqx5b6e0rrtb2" path="res://effects/distance_scale/linear_scale.gd" id="5_scale"]
[ext_resource type="Script" uid="uid://dg4m4os0d6e5f" path="res://effects/effect.gd" id="7_effect"]
[ext_resource type="Script" uid="uid://ci0mmuifd3c71" path="res://entity/core/core_class.gd" id="8_mw6me"]
[ext_resource type="Script" uid="uid://cyj0to3m0jdxa" path="res://stats_system/composite_stat_modifier.gd" id="9_comp"]

[sub_resource type="Resource" id="scale_falling"]
script = ExtResource("5_scale")

[sub_resource type="Resource" id="mod_aura_strength"]
script = ExtResource("2_mod")
stat_id = &"strength"
operation = 3
value = 6.0

[sub_resource type="Resource" id="reach_2hop"]
script = ExtResource("4_reach")
max_hops = 2

[sub_resource type="Resource" id="aura_strike"]
script = ExtResource("3_aura")
reach = SubResource("reach_2hop")
distance_scale = SubResource("scale_falling")
display_name = "Phantom Strike"
description = "Nearby owned nodes hit harder — intense at the core, gone by 2 hops out."
modifiers = Array[ExtResource("2_mod")]([SubResource("mod_aura_strength")])

[sub_resource type="Resource" id="mod_dealloc"]
script = ExtResource("2_mod")
stat_id = &"deallocation_points"
value = 2.0

[sub_resource type="Resource" id="mod_sp"]
script = ExtResource("2_mod")
stat_id = &"skill_points"
value = -1.0

[sub_resource type="Resource" id="mod_budget_pack"]
script = ExtResource("9_comp")
children = Array[ExtResource("2_mod")]([SubResource("mod_dealloc"), SubResource("mod_sp")])

[resource]
script = ExtResource("8_mw6me")
display_name = "Ninja"
description = "The Phantom — a high deallocation budget for in-turn reshaping and a low skill-point cap that keeps your constellation compact, wrapped around an intense but very-short-range core aura that makes nearby owned nodes hit harder. Rewarded for staying tight, not for sprawling. STR/DEX/INT's flat +10 comes from the shared attribute_baseline.tres pack (D-27, #279), not hand-declared here."
modifiers = Array[ExtResource("2_mod")]([ExtResource("10_baseline"), SubResource("mod_budget_pack")])
effects = Array[ExtResource("7_effect")]([SubResource("aura_strike")])

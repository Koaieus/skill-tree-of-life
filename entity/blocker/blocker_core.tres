[resource]
script = ExtResource("1_core")
pickable_in = 0
display_name = "Dormant Core"
description = "What a Dormant Core is made of, rather than a class anyone picks: no modifiers, no sigil, no turn hook — just the #777 falloff aura, which thins its territory's Node Health by 5 per hop out from the core. pickable_in is 0 and this resource is absent from core_class_roster.tres, so no lobby slot can choose it; it lives under entity/blocker/ rather than entity/core/ for the same reason."
effects = Array[ExtResource("2_effect")]([ExtResource("3_falloff")])

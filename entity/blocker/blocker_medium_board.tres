[sub_resource type="Resource" id="formula_int_to_mana_pt"]
script = ExtResource("script_expr")
formula = "floor(log(max(1e-5, float(intelligence))) / log(10.0))"
inputs = Array[StringName]([&"intelligence"])
per_phrase = "×10 INT"


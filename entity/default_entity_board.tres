blade_size = SubResource("scalar_blade_size")
blade_damage = SubResource("scalar_blade_damage")
crit_chance = SubResource("scalar_crit_chance")
crit_multiplier = SubResource("scalar_crit_multiplier")
intrinsic_modifiers = Array[ExtResource("12_3edt8")]([SubResource("mod_per_to_vision"), SubResource("mod_int_to_mana"), SubResource("mod_int_to_mana_pt"), SubResource("mod_wis_to_xp_pt"), SubResource("mod_dex_to_sensor"), SubResource("mod_str_to_blade_damage"), SubResource("mod_str_to_blade_size"), SubResource("mod_dex_to_range"), SubResource("mod_int_to_spell_range")])

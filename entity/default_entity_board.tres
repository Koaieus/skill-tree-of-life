[resource]
resource_local_to_scene = true
script = ExtResource("1_board")
strength = SubResource("scalar_strength")
dexterity = SubResource("scalar_dexterity")
intelligence = SubResource("scalar_intelligence")
wisdom = SubResource("scalar_wisdom")
perception = SubResource("scalar_perception")
health = SubResource("pool_health")
node_health = SubResource("scalar_node_health")
xp = SubResource("pool_xp")
xp_per_turn = SubResource("scalar_xp_per_turn")
skill_points = SubResource("sp_skill_points")
wound_heal_per_turn = SubResource("scalar_wound_heal_per_turn")
deallocation_points = SubResource("pool_dealloc")
action_points = SubResource("pool_ap")
movement_points = SubResource("pool_movement_points")
initiative_speed = SubResource("scalar_initiative_speed")
vision_range = SubResource("scalar_vision_range")
sensor_range = SubResource("scalar_sensor_range")
mana = SubResource("pool_mana")
mana_per_turn = SubResource("scalar_mana_per_turn")
blade_size = SubResource("scalar_blade_size")
intrinsic_modifiers = Array[ExtResource("12_3edt8")]([SubResource("mod_per_to_vision"), SubResource("mod_int_to_mana"), SubResource("mod_int_to_mana_pt"), SubResource("mod_wis_to_xp_pt"), SubResource("Resource_3edt8"), SubResource("mod_str_to_blade_size")])

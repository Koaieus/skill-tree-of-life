[sub_resource type="Resource" id="formula_per_to_vision"]
script = ExtResource("script_linear")
source_stat_id = &"perception"
scale_per_point = 2.0

[sub_resource type="Resource" id="mod_per_to_vision"]
script = ExtResource("script_derived")
formula = SubResource("formula_per_to_vision")
stat_id = &"vision_range"
operation = 1

[sub_resource type="Resource" id="formula_int_to_mana"]
script = ExtResource("script_expr")
formula = "floor(float(intelligence) / 10.0)"
inputs = Array[StringName]([&"intelligence"])

[sub_resource type="Resource" id="mod_int_to_mana"]
script = ExtResource("script_derived")
formula = SubResource("formula_int_to_mana")
stat_id = &"mana"

[sub_resource type="Resource" id="formula_int_to_mana_pt"]
script = ExtResource("script_expr")
formula = "floor(log(max(1e-5, float(intelligence))) / log(10.0))"
inputs = Array[StringName]([&"intelligence"])

[sub_resource type="Resource" id="mod_int_to_mana_pt"]
script = ExtResource("script_derived")
formula = SubResource("formula_int_to_mana_pt")
stat_id = &"mana_per_turn"

[sub_resource type="Resource" id="formula_wis_to_xp_pt"]
script = ExtResource("script_expr")
formula = "floor(log(max(1e-5, float(wisdom))) / log(10.0))"
inputs = Array[StringName]([&"wisdom"])

[sub_resource type="Resource" id="mod_wis_to_xp_pt"]
script = ExtResource("script_derived")
formula = SubResource("formula_wis_to_xp_pt")
stat_id = &"xp_per_turn"

[sub_resource type="Resource" id="Resource_vupus"]
script = ExtResource("script_expr")
formula = "floor(dexterity / 10.)"
metadata/_custom_type_script = "uid://dn253es0cni7j"


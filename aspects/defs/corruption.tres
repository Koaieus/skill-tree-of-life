[ext_resource type="Resource" path="res://attack/ammo/types/corruption.tres" id="5_ammo"]
[ext_resource type="Resource" path="res://attack/spell/defs/defile.tres" id="6_defile"]
[ext_resource type="PackedScene" path="res://skill_node/addons/defs/compromiser_addon.tscn" id="7_addon"]

[ext_resource type="Resource" path="res://attack/spell/defs/purification.tres" id="8_purification"]

{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000"
  },
  "claudeMdExcludes": [
    "**/.worktrees/**",
    "**/.claude/worktrees/**"
  ],
  "permissions": {
    "allow": [
      "Bash(mise run test*)",
      "Bash(mise run check*)",
      "Bash(mise run --quiet gh-project -- list*)",
      "Bash(mise run --quiet gh-project -- hygiene*)",
      "Bash(mise run --quiet gh-project -- swarmq*)",
      "Bash(mise run --quiet gh-project -- roadmap*)",
      "Bash(gh api rate_limit)",
      "mcp__claude-code-remote__create_session",
      "mcp__claude-code-remote__send_message",
      "mcp__claude-code-remote__get_session",
      "mcp__claude-code-remote__archive_session",
      "mcp__claude-code-remote__interrupt_session",
      "mcp__claude-code-remote__send_later",
      "mcp__claude-code-remote__delete_trigger",
      "mcp__claude-code-remote__update_trigger",
      "mcp__claude-code-remote__list_triggers",
      "mcp__claude-code-remote__get_trigger"
    ],
    "deny": [
      "mcp__claude-code-remote__fire_trigger",
      "mcp__claude-code-remote__get_event",
      "mcp__claude-code-remote__list_repos",
      "mcp__claude-code-remote__register_repo_root",
      "mcp__claude-code-remote__set_session_tags",
      "mcp__claude-code-remote__subscribe_pr_activity",
      "mcp__claude-code-remote__unsubscribe_pr_activity",
      "mcp__claude-code-remote__unarchive_session",
      "mcp__claude-code-remote__watch_url",
      "mcp__claude-code-remote__unwatch_url"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.mise/tasks/context-size-hook\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.mise/tasks/rule-path-hook\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.mise/tasks/godot-kill-guard\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.mise/tasks/commit-mention-guard\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.mise/tasks/drone-budget-guard\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

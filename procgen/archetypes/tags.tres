[gd_resource type="Resource" script_class="TagRegistry" format=3]

[ext_resource type="Script" path="res://procgen/archetypes/tag_registry.gd" id="1"]

[resource]
script = ExtResource("1")
tags = Array[StringName]([&"str", &"dex", &"int", &"con", &"per", &"wis", &"flat", &"percent", &"multiply", &"tier_1", &"tier_2", &"tier_3", &"tier_4", &"tier_5", &"tier_6", &"tier_7", &"tier_8", &"tier_9", &"attack", &"defense", &"magic", &"sense", &"growth", &"structural", &"sp", &"xp_growth", &"vision", &"mobility", &"crit"])
descriptions = PackedStringArray("Strength attribute family", "Dexterity attribute family", "Intelligence attribute family", "Constitution attribute family", "Perception attribute family", "Wisdom attribute family", "ADD_BASE / ADD_BONUS operation (raw amount)", "INCREASE operation (additive %)", "MULTIPLY operation (multiplicative)", "Tier 1 entry (cheap, common, small values)", "Tier 2 entry", "Tier 3 entry", "Tier 4 entry", "Tier 5 entry", "Tier 6 entry", "Tier 7 entry", "Tier 8 entry", "Tier 9 entry (largest values; reserved for INT and xp_growth chains)", "Combat-attack flavour (weapon damage, accuracy, etc.)", "Defense flavour (HP, armour, resistances)", "Magic flavour (mana, spell scaling)", "Sense flavour (vision, sensors, scouting)", "Growth flavour (xp_per_turn, leveling)", "Structural / topological (self-loops, edge mods)", "Skill-point related (sp_max, sp regen, etc.)", "XP-growth related (xp_per_turn target)", "Vision-related (vision_range, sensor_range)", "Mobility flavour (movement_points, deallocation_points)", "Critical-strike flavour (crit_chance, crit_multiplier)")

[sub_resource type="GDScript" id="GDScript_0y6o7"]
script/source = "@tool
extends Node2D

var _host: SkillNode
@export var color: Color = Color.YELLOW_GREEN

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	_host = owner as SkillNode

func _draw() -> void:
	if _host == null:
		return
	var r := _host.radius + 6
	draw_circle(Vector2.ZERO, r, color, false, 3)
	
"


[sub_resource type="Resource" id="Resource_ashfall_aspect"]
resource_local_to_scene = true
resource_name = "+1 Wither Aspect"
script = ExtResource("2_mod")
stat_id = &"wither_aspect"
value = 1.0
metadata/_custom_type_script = "uid://che6xhl6srqh3"

[sub_resource type="Resource" id="Resource_ashfall_wither"]
script = ExtResource("5_status")
def = ExtResource("3_wither")
power = 0.0

[sub_resource type="Resource" id="Resource_ashfall_spread_wither"]
script = ExtResource("5_status")
def = ExtResource("3_wither")
power = 0.0

[sub_resource type="Resource" id="Resource_ashfall_reach"]
script = ExtResource("5_hop")
max_hops = 1

[sub_resource type="Resource" id="Resource_ashfall_spread"]
script = ExtResource("5_splash")
inners = Array[ExtResource("6_effect")]([SubResource("Resource_ashfall_spread_wither")])
hits_centre = false
ownership_filter = 0
stack_scale = 0.5
range_finder = SubResource("Resource_ashfall_reach")

[sub_resource type="Resource" id="Resource_ashfall_stacks"]
resource_local_to_scene = true
resource_name = "+1 Wither Stacks per Hit"
script = ExtResource("2_mod")
stat_id = &"wither_stacks_per_hit"
value = 1.0
metadata/_custom_type_script = "uid://che6xhl6srqh3"

[sub_resource type="Resource" id="Resource_ashfall_unlock"]
resource_local_to_scene = true
resource_name = "×2 Wither Stacks per Hit at 3/X"
script = ExtResource("7_gated")
unlock_level = 3
stat_id = &"wither_stacks_per_hit"
operation = 2
value = 2.0

[node name="AshfallAddon" type="Node2D"]
z_index = 1
script = ExtResource("1_addon")
identity = ExtResource("identity_ref")
on_hit_effects = Array[ExtResource("6_effect")]([SubResource("Resource_ashfall_wither"), SubResource("Resource_ashfall_spread")])
entity_modifiers = Array[ExtResource("2_mod")]([SubResource("Resource_ashfall_aspect")])
local_modifiers = Array[ExtResource("2_mod")]([SubResource("Resource_ashfall_stacks"), SubResource("Resource_ashfall_unlock")])
description = "A drift of ash — its owner gains Wither, and a blade swung through this node withers every contact it makes, the ash settling on the struck node's neighbours as well."
temp_placeable = true
temp_cost_blade_size = 2
temp_cost_aspects = Dictionary[StringName, int]({
&"wither_aspect": 1
})
role = 1

[node name="Visual" type="Node2D" parent="."]
script = ExtResource("9_visual")

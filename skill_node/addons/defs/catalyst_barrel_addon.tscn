value = 1.0
metadata/_custom_type_script = "uid://che6xhl6srqh3"

[node name="CatalystBarrelAddon" type="Node2D"]
z_index = 1
script = ExtResource("1_addon")
charge_status = ExtResource("3_charge")
identity = ExtResource("identity_ref")
entity_modifiers = Array[ExtResource("2_mod")]([SubResource("Resource_barrel_aspect")])
description = "A Catalyst barrel. Its owner gains +1 Catalyst Aspect (one more Catalyst arrow per reload); at each of the owner's turn starts, an allocated carrier tops its Catalyst up to one stack per barrel it carries. Removing a barrel takes one stack off. Catalyst never goes off: Heat, Cold or Charge landing on its node converts it into that element, and it decays every world turn."
temp_placeable = false
role = 0

[node name="Visual" type="Node2D" parent="."]
script = ExtResource("4_visual")

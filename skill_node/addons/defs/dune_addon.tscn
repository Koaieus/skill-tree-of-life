[sub_resource type="Resource" id="Resource_dune_aspect"]
resource_local_to_scene = true
resource_name = "+1 Blindness Aspect"
script = ExtResource("2_mod")
stat_id = &"blindness_aspect"
value = 1.0
metadata/_custom_type_script = "uid://che6xhl6srqh3"

[sub_resource type="Resource" id="Resource_dune_blindness"]
script = ExtResource("5_status")
def = ExtResource("3_blindness")
power = 0.0

[sub_resource type="Resource" id="Resource_dune_puff_blindness"]
script = ExtResource("5_status")
def = ExtResource("3_blindness")
power = 0.0

[sub_resource type="Resource" id="Resource_dune_reach"]
script = ExtResource("5_hop")
max_hops = 1

[sub_resource type="Resource" id="Resource_dune_puff"]
script = ExtResource("5_splash")
inners = Array[ExtResource("6_effect")]([SubResource("Resource_dune_puff_blindness")])
hits_centre = false
ownership_filter = 0
range_finder = SubResource("Resource_dune_reach")

[sub_resource type="Resource" id="Resource_dune_stacks"]
resource_local_to_scene = true
resource_name = "+1 Blindness Stacks per Hit"
script = ExtResource("2_mod")

script = ExtResource("7_gated")
unlock_level = 3
stat_id = &"blindness_stacks_per_hit"
operation = 0
value = 1.0

[node name="DuneAddon" type="Node2D"]
z_index = 1
script = ExtResource("1_addon")
identity = ExtResource("identity_ref")
on_hit_effects = Array[ExtResource("6_effect")]([SubResource("Resource_dune_blindness"), SubResource("Resource_dune_puff")])
entity_modifiers = Array[ExtResource("2_mod")]([SubResource("Resource_dune_aspect")])
local_modifiers = Array[ExtResource("2_mod")]([SubResource("Resource_dune_stacks"), SubResource("Resource_dune_unlock")])
description = "A drift of sand — its owner gains Blindness, and a blade swung through this node blinds every contact it makes, the sand puffing onto the struck node's hostile neighbours in full."
temp_placeable = true
temp_cost_blade_size = 2
temp_cost_aspects = Dictionary[StringName, int]({
&"blindness_aspect": 1
})

[node name="Visual" type="Node2D" parent="."]
script = ExtResource("9_visual")

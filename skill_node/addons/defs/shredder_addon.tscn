[ext_resource type="Script" uid="uid://dw3civ4fol21f" path="res://attack/spell/on_hit/on_hit_effect.gd" id="6_effect"]
[ext_resource type="Script" uid="uid://c804k0enhfad7" path="res://attack/outcome/stack_term.gd" id="7_term"]

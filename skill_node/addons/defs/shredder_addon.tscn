[sub_resource type="Resource" id="Resource_shredder_aspect"]
resource_local_to_scene = true
resource_name = "+1 Sunder Aspect"
script = ExtResource("2_mod")
stat_id = &"sunder_aspect"
value = 1.0
metadata/_custom_type_script = "uid://che6xhl6srqh3"

[sub_resource type="Resource" id="Resource_shredder_share"]
script = ExtResource("4_share")
stat_id = &"armor"
ratio = 0.25
unlock_level = 3

[sub_resource type="Resource" id="Resource_shredder_sunder"]
script = ExtResource("5_status")
def = ExtResource("3_sunder")
power = 0.0
stack_terms = Array[ExtResource("7_term")]([SubResource("Resource_shredder_share")])

[sub_resource type="Resource" id="Resource_shredder_stacks"]
resource_local_to_scene = true
resource_name = "+2 Sunder Stacks per Hit"
script = ExtResource("2_mod")
stat_id = &"sunder_stacks_per_hit"
value = 2.0
metadata/_custom_type_script = "uid://che6xhl6srqh3"

[node name="ShredderAddon" type="Node2D"]
z_index = 1
script = ExtResource("1_addon")
identity = ExtResource("identity_ref")
on_hit_effects = Array[ExtResource("6_effect")]([SubResource("Resource_shredder_sunder")])
entity_modifiers = Array[ExtResource("2_mod")]([SubResource("Resource_shredder_aspect")])
local_modifiers = Array[ExtResource("2_mod")]([SubResource("Resource_shredder_stacks")])
description = "A cracked iron plate shedding sparks — its owner's quiver gains sunder arrows, and a blade swung through this node breaks the armor of every contact it makes before the blow lands, biting deeper into heavy plate once fully invested."
temp_placeable = true
temp_cost_blade_size = 2
temp_cost_aspects = Dictionary[StringName, int]({
&"sunder_aspect": 1
})

[node name="Visual" type="Node2D" parent="."]
script = ExtResource("9_visual")

[ext_resource type="Script" path="res://addons/spell_playground/aspect_slots_row.gd" id="1_row"]

[node name="AspectSlotsRow" type="VBoxContainer"]
script = ExtResource("1_row")

[node name="Header" type="HBoxContainer" parent="."]

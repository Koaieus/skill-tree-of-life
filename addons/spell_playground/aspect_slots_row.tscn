text = "Aspects"

[node name="SlotCountBox" type="SpinBox" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "How many aspect slots to grant the caster (1-4). Each slot SETs one <concept>_aspect on the caster's board — the cap the infusion row spends against."
min_value = 1.0
max_value = 4.0
value = 1.0

[node name="Slot0" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Picker" type="OptionButton" parent="Slot0"]

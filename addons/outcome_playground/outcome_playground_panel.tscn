[node name="SaveBtn" type="Button" parent="VBox/Bar"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Write the held fixture to test/fixtures/outcome/ — editor-only."
text = "💾  Save fixture"

[node name="StatusLabel" type="RichTextLabel" parent="VBox"]
unique_name_in_owner = true

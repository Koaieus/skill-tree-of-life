[node name="DelitSpin" type="SpinBox" parent="VBox/Bar/Controls/DelitRow"]
unique_name_in_owner = true
layout_mode = 2
max_value = 20.0
tooltip_text = "Show the outermost N ghost vertices as popped (HDR → SDR). A real swing overrides this from the pop resolver."

[node name="PreviewToggle" type="CheckBox" parent="VBox/Bar/Controls"]
unique_name_in_owner = true
layout_mode = 2
button_pressed = true
text = "Preview loop"
tooltip_text = "The only auto-driving part of melee. Also forced off whenever this tab is not visible."

[node name="TopUpToggle" type="CheckBox" parent="VBox/Bar/Controls"]
unique_name_in_owner = true
layout_mode = 2
button_pressed = true
text = "Top up quarry"
tooltip_text = "Refill damaged enemy nodes so the same swing can be spammed at the same board. Refill is deferred, so a LETHAL hit still depletes and cascades — this tops up survivors, it does not prevent death. Reset rebuilds the board."

[node name="RearmToggle" type="CheckBox" parent="VBox/Bar/Controls"]
unique_name_in_owner = true
layout_mode = 2
button_pressed = true
text = "Auto re-arm"
tooltip_text = "Re-select the same pivot + members the instant a swing ends, so Launch is live again with no clicks in between."

[node name="ResetBtn" type="Button" parent="VBox/Bar/Controls"]
unique_name_in_owner = true
layout_mode = 2
text = "⟲ Reset world"

[node name="StatusLabel" type="Label" parent="VBox/Bar/Controls"]
unique_name_in_owner = true
layout_mode = 2

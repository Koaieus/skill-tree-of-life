#!/usr/bin/env python
# Build the blade solver GDExtension (#798).
#
#   cd native && scons target=template_debug     # what the editor + headless runs load
#   cd native && scons target=template_release   # what exported builds load
#
# or, from anywhere: `mise run native:build`.
#
# godot-cpp is a submodule at native/godot-cpp. `api_version=4.7` pins the
# extension API to the engine mise installs (see [tools] in mise.toml);
# `build_profile` trims the generated bindings down to the handful of classes
# this extension touches, which is the difference between a ~1 min build and a
# ~10 min one.

# `build_profile` is one of godot-cpp's SCons *Variables*, not one of the three
# names its SConstruct Import()s (api_version, binding_hooks, customs) — passing
# it in the exports dict below is silently ignored and you get all ~1000 engine
# classes generated and compiled. Seeding ARGUMENTS is the supported way to give
# it a default the caller can still override on the command line.
ARGUMENTS.setdefault("build_profile", "build_profile.json")

env = SConscript("godot-cpp/SConstruct", {
    "api_version": "4.7",
})

env.Append(CPPPATH=["src/"])

# BIT-IDENTICAL parity with the GDScript solver is this extension's contract
# (test_blade_native_parity.gd), and FMA contraction breaks it: `a * b + c`
# fused into one instruction keeps the product at full width instead of
# rounding it to float64/float32 the way GDScript's separate ops do. GCC and
# Clang default to `-ffp-contract=fast` and WILL fuse. It happens not to bite
# on baseline x86_64 (no FMA in the SSE2 baseline), which is exactly why this
# has to be pinned rather than left to luck: `blade_sim.gdextension` already
# lists linux.arm64 and macos targets, where FMA is baseline and the default
# would silently drift the solver.
#
# MSVC has no such flag — it does not contract across statements by default,
# and `/fp:precise` (its default) forbids the reassociation that would matter.
if env.get("CC") and "cl" not in str(env["CC"]):
    env.Append(CCFLAGS=["-ffp-contract=off"])

sources = Glob("src/*.cpp")

library = env.SharedLibrary(
    "bin/libbladesim{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)

Default(library)

[resource]
script = ExtResource("1_spell")
identity = ExtResource("identity_ref")
id = &"miasma"
name = "Miasma"
tagline = "A poison cloud: thin stacks on every enemy node it drifts through."
description = "Poison an enemy-occupied node within 3 hops with 3 stacks, then let the cloud fan up to 4 hops through enemy territory, twice over any node. Deals no damage itself — the poison does the work."
power = 0.4
propagation = SubResource("prop_miasma")
on_hit_effects = Array[ExtResource("2_effect")]([])
affinities = Array[ExtResource("3_affinity")]([SubResource("poison_miasma")])
default_rate = 1.0
vfx_coordinator_scene = ExtResource("10_vfx")
targeting = SubResource("targeting_hostile_3hop")

[sub_resource type="Resource" id="poison_pestilence"]
script = ExtResource("3_affinity")
status = ExtResource("3_poison")
innate = 1
rate = 0.1

[sub_resource type="Resource" id="filter_enemy"]
script = ExtResource("5_filter")

[sub_resource type="Resource" id="reducer_sum"]
script = ExtResource("6_reducer")
stack_fold = 1

[sub_resource type="Resource" id="spread_fan"]
script = ExtResource("6_fan")

[sub_resource type="Resource" id="prop_pestilence"]
script = ExtResource("4_config")
filter = SubResource("filter_enemy")
spread = SubResource("spread_fan")
reducer = SubResource("reducer_sum")
max_hops = 6.0
max_visits_per_node = 2

[sub_resource type="Resource" id="range_3hop"]
script = ExtResource("7_range")

[sub_resource type="Resource" id="targeting_hostile_3hop"]
script = ExtResource("6_targeting")
range_finder = SubResource("range_3hop")

[resource]
script = ExtResource("1_spell")
id = &"pestilence"
name = "Pestilence"
tagline = "A creeping plague: poison stacks add up wherever its branches meet."
description = "Poison an enemy-occupied node within 3 hops with 1 stack, then spread up to 6 hops through enemy territory, twice over any node. Where branches meet in one wave their stacks add — a well-connected hub takes one stack per converging branch. Deals no damage itself. Poison infusions are diluted 10:1."
identity = ExtResource("identity_ref")
power = 0.4
propagation = SubResource("prop_pestilence")
affinities = Array[ExtResource("3_affinity")]([SubResource("poison_pestilence")])
vfx_coordinator_scene = ExtResource("10_vfx")
targeting = SubResource("targeting_hostile_3hop")

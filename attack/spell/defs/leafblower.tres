[sub_resource type="Resource" id="targeting"]
script = ExtResource("11_targeting")
range_finder = SubResource("range")

[resource]
script = ExtResource("1_spell")
id = &"leafblower"
name = "Leafblower"
description = "Trickles downhill: at each hop only flows into neighbours whose degree within their owner's territory is no higher than the current node's. Damage compounds (×1.5 per hop) so the leaf at the end of the chain eats the payload while intermediate hubs barely register. CRIT on leaf nodes (territory degree 1). Self-loops count double, so a fortified node turns the flow away. Perfect for sniping dangling addon-leaves through fortified topology."
icon = ExtResource("1_y0ifm")
carve_shape = SubResource("carve_leafblower")
min_degree = 2
mana_cost = 3
power = 2.0
propagation = SubResource("prop")
on_hit_effects = Array[ExtResource("2_effect")]([SubResource("dmg")])
crit_conditions = Array[ExtResource("2_crit_base")]([SubResource("crit_leaf")])
vfx_coordinator_scene = ExtResource("17_vfx")
targeting = SubResource("targeting")

[resource]
script = ExtResource("9_en1rl")
id = &"trail_blazer"
name = "The Trailblazer"
description = "Walks a single path from the target: each degree-2 node it passes through adds +2 damage before the spell hops onward; when it reaches a junction (degree >2) it deals double the accumulated total and stops. Cast on a node at the end of a long string for maximum devastation."
icon = ExtResource("1_x1qvp")
carve_shape = SubResource("carve_trailblazer")
min_degree = 3
mana_cost = 3
power = 1.0
propagation = SubResource("prop")
on_hit_effects = Array[ExtResource("1_p8d3l")]([SubResource("dmg")])
vfx_coordinator_scene = ExtResource("14_1jkab")
targeting = SubResource("targeting")

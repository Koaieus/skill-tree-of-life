[resource]
script = ExtResource("1_spell")
id = &"cyclone"
name = "Cyclone"
description = "Turns one way and never straightens: at every node the storm ranks the turns it could make and splits its power across them, hardest into the sharpest turn. No single thread survives the split — but converging threads ADD, so anything that folds back onto itself feeds itself while offshoots bleed out. Closing a loop crits (x2) and boosts the storm feeding that loop. It does not care whether a ring is odd or even, or how long it is; it cares whether the ground is two-dimensional. A tree gets literally nothing. A lone triangle gets demolished. A field of joined triangles becomes an epicentre."
icon = ExtResource("1_icon")
carve_shape = SubResource("carve_cyclone")
min_degree = 4
mana_cost = 5
power = 2.0
propagation = SubResource("prop")
on_hit_effects = Array[ExtResource("2_effect")]([SubResource("dmg")])
crit_conditions = Array[ExtResource("2_crit_base")]([SubResource("crit_cycle")])
vfx_coordinator_scene = ExtResource("12_vfx")
targeting = SubResource("targeting")

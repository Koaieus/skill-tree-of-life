[resource]
script = ExtResource("1_spell")
id = &"cyclone"
name = "Cyclone"
description = "Fans to every enemy neighbour but never back the way it came — the storm only moves forward. Damage ramps +25% of seed per hop. When a front lands on a node its own lineage already struck, the cycle closes: CRIT (×2, stacks with crit_chance) and the storm re-seeds to lap the loop again. Counter-rotating fronts snuff each other head-on in even rings; odd rings let them spin. Self-loops don't count — going nowhere isn't a cycle. Feed it a tight ring and it grinds the whole loop down; cast it at a string and it's just wind."
icon = ExtResource("1_icon")
carve_shape = SubResource("carve_cyclone")
min_degree = 4
mana_cost = 5
power = 2.0
propagation = SubResource("prop")
on_hit_effects = Array[ExtResource("2_effect")]([SubResource("dmg")])
crit_conditions = Array[ExtResource("2_crit_base")]([SubResource("crit_cycle")])
vfx_coordinator_scene = ExtResource("12_vfx")
targeting = SubResource("targeting")

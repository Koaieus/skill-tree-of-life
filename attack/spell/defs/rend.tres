[sub_resource type="Resource" id="share_armor"]
script = ExtResource("19_share")
stat_id = &"armor"
ratio = 0.25

[sub_resource type="Resource" id="break_rend"]
script = ExtResource("3_affinity")
identity = ExtResource("identity_sunder")
innate = 5
affinity_gain = 2
stack_terms = Array[ExtResource("18_term")]([SubResource("share_armor")])

[sub_resource type="Resource" id="strip_rend"]
script = ExtResource("20_addterm")
stack_terms = Array[ExtResource("18_term")]([SubResource("share_armor")])

[sub_resource type="Resource" id="dmg_rend"]
script = ExtResource("3_dmg")

[sub_resource type="Resource" id="filter_enemy"]
script = ExtResource("5_filter")

[sub_resource type="Resource" id="ranker_armor"]
script = ExtResource("16_sr")
stat_id = &"armor"

[sub_resource type="Resource" id="filter_climb"]
script = ExtResource("13_rt")
ranker = SubResource("ranker_armor")
compare = 3

[sub_resource type="Resource" id="filter_peak"]
script = ExtResource("14_tt")
ranker = SubResource("ranker_armor")

[sub_resource type="Resource" id="filter_composite"]
script = ExtResource("15_cf")
children = Array[ExtResource("12_pf")]([SubResource("filter_enemy"), SubResource("filter_climb"), SubResource("filter_peak")])

[sub_resource type="Resource" id="spread_fan"]
script = ExtResource("17_fan")

[sub_resource type="Resource" id="prop_rend"]
script = ExtResource("4_config")
filter = SubResource("filter_composite")
spread = SubResource("spread_fan")
max_hops = 3.0

[sub_resource type="Resource" id="summit_rend"]
script = ExtResource("21_extremum")
ranker = SubResource("ranker_armor")

[sub_resource type="Resource" id="range_3hop"]
script = ExtResource("7_range")

[sub_resource type="Resource" id="targeting_hostile_3hop"]
script = ExtResource("6_targeting")
range_finder = SubResource("range_3hop")

[resource]
script = ExtResource("1_spell")
id = &"rend"
name = "Rend"
tagline = "Tears armor off, hits harder for it, and climbs to the thickest plate."
description = "Strike an enemy node within 3 hops, then climb up to 3 hops toward enemy nodes with as much armor or more, forking on ties and following only the best of them. Each landing applies 5 Sunder plus a quarter of the node's armor more, each stack −1 armor, and hits harder by that same quarter; the added damage carries up the climb. Crits on a summit: a node whose armor tops all its neighbours'."
identity = ExtResource("identity_ref")
power = 1.2
min_degree = 2
propagation = SubResource("prop_rend")
on_hit_effects = Array[ExtResource("2_effect")]([SubResource("strip_rend"), SubResource("dmg_rend")])
intakes = Array[ExtResource("3_affinity")]([SubResource("break_rend")])
crit_conditions = Array[ExtResource("1_jipuy")]([SubResource("summit_rend")])
vfx_coordinator_scene = ExtResource("10_vfx")
targeting = SubResource("targeting_hostile_3hop")

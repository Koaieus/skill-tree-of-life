[ext_resource type="Script" path="res://attack/targeting/line_shape.gd" id="6_line"]
[ext_resource type="Script" path="res://attack/range_finder/euclidean_range_finder.gd" id="7_range"]
[ext_resource type="Script" path="res://attack/spell/propagation/propagation_config.gd" id="8_config"]
[ext_resource type="PackedScene" path="res://ui/vfx/coordinator/spells/scout_line_coordinator.tscn" id="9_vfx"]
[ext_resource type="Resource" path="res://identity/defs/spell_scout_line.tres" id="identity_ref"]

[sub_resource type="Resource" id="prop_none"]
script = ExtResource("8_config")

[sub_resource type="Resource" id="shape_line"]
script = ExtResource("6_line")
width = 16.0

[sub_resource type="Resource" id="range_long"]
script = ExtResource("7_range")
max_distance = 400.0

[sub_resource type="Resource" id="targeting_line"]
script = ExtResource("5_targeting")
shape = SubResource("shape_line")
ownership_filter = 15
range_finder = SubResource("range_long")

[resource]
script = ExtResource("1_spell")
identity = ExtResource("identity_ref")
id = &"scout_line"
name = "Flare Line"
tagline = "Point, fire, and light up everything along the way."
description = "Aim a thin flare from the cast-from node. Every node the line crosses, whoever owns it and however deep in the fog, gains one scouted stack for your camp. The line reaches as far as your euclidean cast range. Deals no damage."
power = 0.0
propagation = SubResource("prop_none")
on_hit_effects = Array[ExtResource("2_effect")]([])
affinities = Array[ExtResource("3_affinity")]([])
vfx_coordinator_scene = ExtResource("9_vfx")
targeting = SubResource("targeting_line")

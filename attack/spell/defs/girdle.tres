[sub_resource type="Resource" id="dmg_girdle"]
script = ExtResource("3_dmg")

[sub_resource type="Resource" id="wither_girdle"]
script = ExtResource("3_affinity")
status = ExtResource("3_wither")
innate = 3

[sub_resource type="Resource" id="filter_enemy"]
script = ExtResource("5_filter")

[sub_resource type="Resource" id="filter_away"]
script = ExtResource("5_away")
direction = 1

[sub_resource type="Resource" id="filter_girdle"]
script = ExtResource("5_and")
children = Array[ExtResource("5_pf")]([SubResource("filter_enemy"), SubResource("filter_away")])

[sub_resource type="Resource" id="spread_fan"]
script = ExtResource("6_fan")

[sub_resource type="Resource" id="prop_girdle"]
script = ExtResource("4_config")
filter = SubResource("filter_girdle")
spread = SubResource("spread_fan")
max_hops = 2.0

[sub_resource type="Resource" id="crit_choke"]
script = ExtResource("2_choke")

[sub_resource type="Resource" id="range_3hop"]
script = ExtResource("7_range")

[sub_resource type="Resource" id="targeting_hostile_3hop"]
script = ExtResource("6_targeting")
range_finder = SubResource("range_3hop")

[resource]
script = ExtResource("1_spell")
identity = ExtResource("identity_ref")
id = &"girdle"
name = "Girdle"
tagline = "Ring the bark: the limb beyond it withers."
description = "Deal a little damage to an enemy-occupied node within 3 hops and wither it, then fan up to 2 hops outward, away from its owner's core. A chokepoint (a node its owner's territory hangs on) crits and withers harder."
power = 0.4
propagation = SubResource("prop_girdle")
on_hit_effects = Array[ExtResource("2_effect")]([SubResource("dmg_girdle")])
affinities = Array[ExtResource("3_affinity")]([SubResource("wither_girdle")])
crit_conditions = Array[ExtResource("1_cond")]([SubResource("crit_choke")])
vfx_coordinator_scene = ExtResource("10_vfx")
targeting = SubResource("targeting_hostile_3hop")

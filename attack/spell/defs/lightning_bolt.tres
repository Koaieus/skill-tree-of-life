[resource]
script = ExtResource("1_spell")
name = "Lightning Bolt"
description = "Deal full damage to the target, then chain to every enemy neighbour up to 3 hops away — damage halves each hop. Overlapping branches resolve to the strongest incident (no compounding). No friendly fire."
min_degree = 2
mana_cost = 2
base_damage = 10.0
propagation = SubResource("prop_lightning")
on_hit_effects = Array[ExtResource("2_effect")]([SubResource("dmg_lightning")])
targeting = SubResource("targeting_lightning")

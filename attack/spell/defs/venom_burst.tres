[resource]
script = ExtResource("1_spell")
id = &"venom_burst"
name = "Venom Burst"
tagline = "A big poison dose on one enemy node that bursts outward, thinning as it spreads."
description = "Deal a little damage to an enemy-occupied node within 3 hops and dose it with 15 poison stacks, then burst 2 hops outward through enemy territory: 10 stacks a node on the first hop, 5 on the second, never twice on one node. Poison infusions count double."
identity = ExtResource("identity_ref")
power = 0.4
propagation = SubResource("prop_burst")
on_hit_effects = Array[ExtResource("2_effect")]([SubResource("dmg_burst")])
affinities = Array[ExtResource("3_affinity")]([SubResource("poison_burst")])
vfx_coordinator_scene = ExtResource("10_vfx")
targeting = SubResource("targeting_hostile_3hop")

[resource]
script = ExtResource("1_spell")
identity = ExtResource("identity_ref")
id = &"defile"
name = "Defile"
tagline = "Rot what is rich: every modifier a node carries takes a stack of corruption."
description = "Deal a little damage to an enemy-occupied node within 3 hops, then fan up to 2 hops through enemy territory. Each node struck is corrupted once per modifier it carries — a spell grant or an addon counts twice. A blank node is immune."
power = 0.4
propagation = SubResource("prop_defile")
on_hit_effects = Array[ExtResource("2_effect")]([SubResource("scale_defile"), SubResource("dmg_defile")])
affinities = Array[ExtResource("3_affinity")]([SubResource("corruption_defile")])
vfx_coordinator_scene = ExtResource("10_vfx")
targeting = SubResource("targeting_hostile_3hop")

[sub_resource type="Resource" id="curse_malediction"]
script = ExtResource("3_affinity")
status = ExtResource("3_curse")
innate = 5

[sub_resource type="Resource" id="filter_enemy"]
script = ExtResource("5_filter")

[sub_resource type="Resource" id="ranker_floor"]
script = ExtResource("13_sr")
stat_id = &"min_damage_taken"

[sub_resource type="Resource" id="spread_rumour"]
script = ExtResource("12_rumour")
ranker = SubResource("ranker_floor")

[sub_resource type="Resource" id="reducer_sum"]
script = ExtResource("14_sum")
stack_fold = 1

[sub_resource type="Resource" id="prop_malediction"]
script = ExtResource("4_config")
filter = SubResource("filter_enemy")
spread = SubResource("spread_rumour")
reducer = SubResource("reducer_sum")
max_hops = 4.0
max_visits_per_node = 2

[sub_resource type="Resource" id="range_3hop"]
script = ExtResource("7_range")

[sub_resource type="Resource" id="targeting_hostile_3hop"]
script = ExtResource("6_targeting")
range_finder = SubResource("range_3hop")

[resource]
script = ExtResource("1_spell")
id = &"malediction"
name = "Malediction"
tagline = "A curse that runs downhill to the lowest floor; neighbours hear a little."
description = "Curse an enemy node within 3 hops with 5 stacks, then let the rumour run up to 4 hops into enemy nodes with an equal or lower damage floor, only the lowest of them, forking on ties and twice over any node. Every other enemy neighbour hears a quarter of the stacks, rounded down, and passes nothing on. Each stack raises the floor on damage the node takes by 1 (one stack fades each turn, never cap)."
identity = ExtResource("identity_ref")
power = 0.4
propagation = SubResource("prop_malediction")
affinities = Array[ExtResource("3_affinity")]([SubResource("curse_malediction")])
vfx_coordinator_scene = ExtResource("10_vfx")
targeting = SubResource("targeting_hostile_3hop")

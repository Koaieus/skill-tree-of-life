[resource]
script = ExtResource("1_spell")
identity = ExtResource("identity_ref")
id = &"dazzle"
name = "Dazzle"
tagline = "A flash that climbs toward the best seer and blinds it."
description = "Strike an enemy node within 3 hops, then climb up to 4 hops toward enemy nodes that see as far or farther, forking on ties and following only the best of them. Each node it lands on takes a little damage and is blinded: it sees and senses less, recovering over 3 turns. It finds watchtowers and dazzles them fully."
power = 0.4
propagation = SubResource("prop_dazzle")
on_hit_effects = Array[ExtResource("2_effect")]([SubResource("dmg_dazzle")])
affinities = Array[ExtResource("3_affinity")]([SubResource("blind_dazzle")])
vfx_coordinator_scene = ExtResource("10_vfx")
targeting = SubResource("targeting_hostile_3hop")

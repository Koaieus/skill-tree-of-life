[resource]
script = ExtResource("1_spell")
name = "Resonator"
description = "Constructive interference — branches fan to every enemy neighbour, adding +2 damage each hop. When two branches converge on the same node in the same wave, they ADD and the landing crits (×2). Diamonds, hexagons, and chained-diamond topologies detonate on the convergence node; straight lines and the first hit don't crit. The longer the diamond chain, the harder the last crit — build the run around a graph that feeds it."
icon = ExtResource("1_uku7o")
min_degree = 2
mana_cost = 3
power = 1.0
propagation = SubResource("prop")
on_hit_effects = Array[ExtResource("2_effect")]([SubResource("dmg")])
crit_conditions = Array[ExtResource("2_crit_base")]([SubResource("crit_conv")])
vfx_coordinator_scene = ExtResource("12_ww832")
targeting = SubResource("targeting")

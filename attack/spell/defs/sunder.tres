[resource]
script = ExtResource("1_spell")
id = &"sunder"
name = "Sunder"
tagline = "A little damage that chips 20% of one enemy node's armor away."
description = "Deal a little damage to a single enemy-occupied node within 3 hops and break its armor by 20% (stacks toward ×0, recovers over 4 turns)."
icon = ExtResource("1_icon")

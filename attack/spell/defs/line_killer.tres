[sub_resource type="Resource" id="dmg"]
script = ExtResource("3_dmg")

[sub_resource type="Resource" id="filter_enemy"]
script = ExtResource("6_owner")

[sub_resource type="Resource" id="filter_deg2"]
script = ExtResource("7_expr")
expression = "to_degree >= 2"

[sub_resource type="Resource" id="filter_composite"]
script = ExtResource("8_composite")
children = Array[ExtResource("5_filter_base")]([SubResource("filter_enemy"), SubResource("filter_deg2")])

[sub_resource type="Resource" id="step_killer"]
script = ExtResource("9_step")
per_hop_increment = 2.0
terminal_mode = 2
terminal_multiplier = 2.0

[sub_resource type="Resource" id="prop"]
script = ExtResource("4_config")
filter = SubResource("filter_composite")
step = SubResource("step_killer")
max_hops = 20

[sub_resource type="Resource" id="range"]
script = ExtResource("11_range")

[sub_resource type="Resource" id="targeting"]
script = ExtResource("10_targeting")
range_finder = SubResource("range")

[resource]
script = ExtResource("1_spell")
name = "The Line Killer"
description = "Walks a single path from the target: each degree-2 node it passes through adds +2 damage before the spell hops onward; when it reaches a junction (degree >2) it deals double the accumulated total and stops. Cast on a node at the end of a long string for maximum devastation."
min_degree = 3
mana_cost = 3
base_damage = 1.0
propagation = SubResource("prop")
on_hit_effects = Array[ExtResource("2_effect")]([SubResource("dmg")])
vfx_coordinator_scene = ExtResource("14_vfx")
targeting = SubResource("targeting")

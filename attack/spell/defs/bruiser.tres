[resource]
script = ExtResource("1_spell")
id = &"bruiser"
name = "Bruiser"
description = "Climbs the HP gradient: each hop greedily picks the neighbour with the highest current node_health and nicks it for low damage. Cannot kill on its own — softens the toughest nodes for a follow-up. Pairs with wound mechanics: damage that doesn't kill stays as wounds, slowly bracketing fat enemies."
icon = ExtResource("1_bm58y")
carve_shape = SubResource("Resource_u38nb")
min_degree = 2
mana_cost = 2
power = 4.0
propagation = SubResource("prop")
on_hit_effects = Array[ExtResource("2_effect")]([SubResource("dmg")])
vfx_coordinator_scene = ExtResource("13_ihn2u")
targeting = SubResource("targeting")

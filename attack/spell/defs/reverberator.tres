[resource]
script = ExtResource("1_spell")
name = "Reverberator"
description = "Fans to every enemy neighbour, ×1.5 damage per hop. Converging branches ADD — diamond shoulders and self-loops compound massively. CRIT on traversal of a self-loop edge (×2, stacks with crit_chance stat) — the spell feeds back into its own path."

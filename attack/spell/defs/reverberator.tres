[resource]
script = ExtResource("1_spell")
name = "Reverberator"
description = "Fans to every enemy neighbour, +{SEED} damage per hop. Converging branches ADD — diamond shoulders and self-loops compound massively. CRIT on traversal of a self-loop edge (×2, stacks with crit_chance stat) — the spell feeds back into its own path."
icon = ExtResource("1_uku7o")
carve_shape = SubResource("carve_reverberator")
min_degree = 2
mana_cost = 5
power = 3.0
propagation = SubResource("prop")
on_hit_effects = Array[ExtResource("2_effect")]([SubResource("dmg")])
crit_conditions = Array[ExtResource("2_crit_base")]([SubResource("crit_self_loop")])
vfx_coordinator_scene = ExtResource("12_ww832")
targeting = SubResource("targeting")

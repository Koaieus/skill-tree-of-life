min_degree = 2
mana_cost = 5
power = 1.0
propagation = SubResource("prop")
on_hit_effects = Array[ExtResource("2_effect")]([SubResource("dmg")])
crit_conditions = Array[ExtResource("2_crit_base")]([SubResource("crit_self_loop")])

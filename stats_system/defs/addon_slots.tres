[resource]
script = ExtResource("1_stat_def")
id = &"addon_slots"
display_name = "Addon Slots"
description = "How many addons a node may carry. Node-local: base(0) + allocation_level (plain 1:1, via the stake_level__current formula). base defaults to 0 so there is no baseline to double-count; the cap is advisory until player-managed placement exists (#348)."
value_type = 0
default_value = 0.0
tint_color = Color(0.4, 0.9, 0.7, 1)
modifier_name = "Addon Slots"

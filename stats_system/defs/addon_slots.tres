[gd_resource type="Resource" script_class="StatDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://stats_system/stat_def.gd" id="1_stat_def"]

[resource]
script = ExtResource("1_stat_def")
id = &"addon_slots"
display_name = "Addon Slots"
description = "How many addons a node may carry. Node-local: base(0) + stake_level (the stake pool's cap, via stake_scaling.tres), never the fill, so a plain unallocated node (stake 1) carries 1. The cap is real: procgen draws addons within it and extract over it is denied."
value_type = 0
default_value = 0.0
tint_color = Color(0.4, 0.9, 0.7, 1)
modifier_name = "Addon Slots"
local_grantable = true

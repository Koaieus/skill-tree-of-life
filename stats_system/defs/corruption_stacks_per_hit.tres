[gd_resource type="Resource" script_class="StatDef" load_steps=3 format=3]

[ext_resource type="Script" path="res://stats_system/stat_def.gd" id="1_stat_def"]
[ext_resource type="Resource" path="res://identity/defs/corruption.tres" id="identity_corruption"]

[resource]
script = ExtResource("1_stat_def")
identity = ExtResource("identity_corruption")
id = &"corruption_stacks_per_hit"
parent_ids = Array[StringName]([&"dot_stacks_per_hit"])
display_name = "Corruption Stacks per Hit"
description = "Flat corruption stacks added to every corruption application this entity lands, before Corruption Potency: landed = (per-hit + Corruption Stacks per Hit) x Corruption Potency x (1 - target's Corruption Resistance), resolved once at land (#1089). DoT Stacks per Hit is its family parent and folds into this read — one number, never a separate sum. Flat, so it doubles a 0.5-stack dart and barely touches an 8-stack cast. Only boosts a corruption application that already happens — never applies corruption on its own. Default 0; entity-scope only."
value_type = 1
default_value = 0.0
modifier_name = "Corruption Stacks per Hit"

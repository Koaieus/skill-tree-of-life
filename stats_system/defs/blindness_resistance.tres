[gd_resource type="Resource" script_class="StatDef" load_steps=3 format=3]

[ext_resource type="Script" path="res://stats_system/stat_def.gd" id="1_stat_def"]
[ext_resource type="Resource" path="res://identity/defs/blindness.tres" id="identity_blindness"]

[resource]
script = ExtResource("1_stat_def")
identity = ExtResource("identity_blindness")
id = &"blindness_resistance"
display_name = "Blindness Resistance"
description = "Fraction of incoming blindness this node shrugs off: power landed = per-hit x attacker's Blindness Potency x (1 - Blindness Resistance), resolved once at land (#1089). Read node-locally like Armor. Default 0."
value_type = 1
default_value = 0.0
modifier_name = "Blindness Resistance"
local_grantable = true

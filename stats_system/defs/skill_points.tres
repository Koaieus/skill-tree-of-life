[ext_resource type="Script" path="res://stats_system/standard_pool_stat_def.gd" id="1_std_pool_def"]

[resource]
script = ExtResource("1_std_pool_def")
id = &"skill_points"
display_name = "Skill Points"
description = "Allocation budget — the mana bar. Spent on allocation, refunded on normal deallocation, wounded by forced deallocation (see SkillPointStat). heal_on_max_increase=true so level-up's +1 max also gifts +1 current (auto-bookkeeping); revisit if non-level sources start raising max SP."
default_value = 1.0
display_order = 5
display_type = 1
tint_color = Color(0.35, 0.85, 0.95, 1)

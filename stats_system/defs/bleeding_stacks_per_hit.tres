[gd_resource type="Resource" script_class="StatDef" load_steps=3 format=3]

[ext_resource type="Script" path="res://stats_system/stat_def.gd" id="1_stat_def"]
[ext_resource type="Resource" path="res://identity/defs/bleeding.tres" id="identity_bleeding"]

[resource]
script = ExtResource("1_stat_def")
identity = ExtResource("identity_bleeding")
id = &"bleeding_stacks_per_hit"
display_name = "Bleeding Stacks per Hit"
description = "The bleeding this entity's hits land. The authored per-hit bleeding is a base_add overlay on this stat, so its flats add to it and its INCREASE / MORE scale it: landed = fold(per-hit), never floored (ADR 0029); the target's Bleeding Resistance filters the row later, at effect time, never here (ADR 0031). No parent. Default 1; entity-scope only."
value_type = 1
default_value = 1.0
modifier_name = "Bleeding Stacks per Hit"

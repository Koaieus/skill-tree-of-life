[ext_resource type="Script" path="res://stats_system/stat_def.gd" id="1_stat_def"]

[resource]
script = ExtResource("1_stat_def")
id = &"min_damage_taken"
display_name = "Min Damage Taken"
description = "Floor on post-armor damage. A successful hit always lands at least this much, unless overridden (e.g. Bulwark)."

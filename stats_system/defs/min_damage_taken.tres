[gd_resource type="Resource" script_class="StatDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://stats_system/stat_def.gd" id="1_stat_def"]

[resource]
script = ExtResource("1_stat_def")
id = &"min_damage_taken"
display_name = "Min Damage Taken"
description = "Floor on post-armor damage. A successful hit always lands at least this much, unless overridden (e.g. Bulwark). A fresh lv1 board starts at 5 against a 100 HP bar, so a pure-floor kill is about 20 hits and every floor step down is felt; curse stacks, procgen rolls and addons move it all run."
value_type = 0
default_value = 5.0
tint_color = Color(0.66, 0.72, 0.86, 1)
lower_is_better = true
local_grantable = true

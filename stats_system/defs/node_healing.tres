[gd_resource type="Resource" script_class="StatDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://stats_system/stat_def.gd" id="1_stat_def"]

[resource]
script = ExtResource("1_stat_def")
id = &"node_healing"
display_name = "Node Healing"
description = "Base HP a node regenerates at its owner's turn start, gated: none if the node took damage since the last turn start (D-9). Node-local — read via SkillNode.get_local_value, not applied directly from the board. # TBD (#268)"
value_type = 1
default_value = 1.0
tint_color = Color(0.5, 0.85, 0.55, 1)

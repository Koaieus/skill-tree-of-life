[gd_resource type="Resource" script_class="StatDef" load_steps=3 format=3]

[ext_resource type="Script" path="res://stats_system/stat_def.gd" id="1_stat_def"]
[ext_resource type="Resource" path="res://identity/defs/greed.tres" id="identity_greed"]

[resource]
script = ExtResource("1_stat_def")
identity = ExtResource("identity_greed")
id = &"greed_stacks_per_hit"
display_name = "Greed Stacks per Hit"
description = "The greed this entity's hits land. The authored per-hit greed is a base_add overlay on this stat, so its flats add to it and its INCREASE / MORE scale it: landed = fold(per-hit), never floored. No resistance filters it (owner: a percent cut makes no sense on a count that is spent whole). No parent: greed is not a DoT. Default 1; read at the attacking node — an entity grant reaches every hit, a node-local grant only the hits that node lands."
value_type = 1
default_value = 1.0
modifier_name = "Greed Stacks per Hit"
local_grantable = true

[ext_resource type="Script" uid="uid://0rq8abv83bkj" path="res://stats_system/stat_def.gd" id="1_stat_def"]

[resource]
script = ExtResource("1_stat_def")
id = &"cast_range_hops"
display_name = "Cast Range Hops"
description = "How many hops a hop-ranged spell reaches from its cast-from node. The spell's authored reach is the base, so +N adds hops, % increased scales the authored reach, and a SET replaces it outright; the total floors once. Base 0 on every board by contract. Scales with INT via a threshold ladder (+1 at 50 / 150 / 500 / 1000 / 5000 INT). Node-local, so an addon can grant it to a cast-from node. Feeds HopRangeFinder only, never a spell's propagation hops."
value_type = 0
default_value = 0.0
tint_color = Color(0.55, 0.65, 1.0, 1)

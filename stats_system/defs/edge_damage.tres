[ext_resource type="Script" uid="uid://0rq8abv83bkj" path="res://stats_system/stat_def.gd" id="1_stat_def"]

[resource]
script = ExtResource("1_stat_def")
id = &"edge_damage"
display_name = "Edge Damage"
description = "Damage per blade EDGE contact in a melee attack (#785) — the shear a sharpened edge deals along its length, distinct from blade_damage's concentrated vertex impact. Default 0: an unsharpened blade's edges collide (so a target can no longer slip between two vertices) but deal nothing. Granted per-node by the paired edge-sharpener addon; an edge's value is the MIN of its two endpoints', so a sharpener must sit on both ends of an edge to sharpen it. Deliberately NOT derived from blade_damage — that would count one investment twice on a wide blade."
value_type = 0
default_value = 0.0
tint_color = Color(0.85, 0.3, 0.3, 1)

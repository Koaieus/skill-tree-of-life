[gd_resource type="Resource" script_class="StatDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://stats_system/stat_def.gd" id="1_stat_def"]

[resource]
script = ExtResource("1_stat_def")
id = &"stake_ceiling"
display_name = "Stake Ceiling"
description = "The most stake_level a staking verb may raise this node to. Node-only (baked on default_node_board.tres, base 3), read via SkillNode.stake_ceiling; raised by +1 local modifiers. Procgen stake writes are not gated by it — each level a procgen write lands past it grants a +1 local modifier, so the ceiling never sits below the stake. Entity-scope never; stays out of procgen stat pools."
value_type = 0
default_value = 3.0
tint_color = Color(0.85, 0.75, 0.4, 1)
modifier_name = "Stake Ceiling"
local_grantable = true

[gd_resource type="Resource" script_class="StatDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://stats_system/stat_def.gd" id="1_stat_def"]

[resource]
script = ExtResource("1_stat_def")
id = &"deflection"
display_name = "Deflection"
description = "Whether a blade can pass through this node (#781) — Bunker's characteristic second effect. A DEFENDER-side, node-local BOOL, read off the node the blade runs into, never off the wielder. True: the node is a solid obstacle — every blade vertex and edge that penetrates its disc is pushed back out inside the solver, so a floppy blade flops around it and a rigid one jams against it. A blade too rigid to yield is driven a fixed distance into the plate and then BREAKS an edge — never a vertex (ADR 0005: a spike destroys matter, a bunker destroys structure). A driven grip vertex that touches the plate stalls the swing's clock outright. Base false — an ordinary node deflects nothing, so a board with no bunker allocates no obstacle field at all and is bit-identical to the plain solver. Presence only, by type — there is no stronger or weaker deflection; the shatter distance is BladeObstacleField.SHATTER_DISTANCE. The authored grant lives on bunker_addon.tscn, not here (#805)."
value_type = 2
default_value = 0.0
tint_color = Color(0.4, 0.44, 0.53, 1)

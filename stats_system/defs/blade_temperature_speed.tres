[gd_resource type="Resource" script_class="StatDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://stats_system/stat_def.gd" id="1_stat_def"]

[resource]
script = ExtResource("1_stat_def")
id = &"blade_temperature_speed"
display_name = "Blade Temperature Speed"
description = "c in the blade's sweep factor clamp(1 + c x t/T, 1-c, 1+c) (#1804): how much a node's signed terrain t (Heat over Cold, over its T) scales the contact speed the speed-damage curve reads. Heat speeds a contact up, Cold slows it. Read clamped to [0, 0.95] so 1-c stays positive. Entity-scope only: no procgen pool, not on a node board. Tentative default 0.5."
value_type = 1
default_value = 0.5
tint_color = Color(0.85, 0.3, 0.3, 1)

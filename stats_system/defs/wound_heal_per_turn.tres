[ext_resource type="Script" uid="uid://0rq8abv83bkj" path="res://stats_system/stat_def.gd" id="1_stat_def"]

[resource]
script = ExtResource("1_stat_def")
id = &"wound_heal_per_turn"
display_name = "Wound Heal / Turn"
description = "Wounds healed at the owning entity's turn start: that many SkillPointStat.wounded units flow back to current. Default 1 — combat balance is built around \"a few hits across a few turns\", not free healing."
default_value = 1.0
tint_color = Color(0.6, 0.85, 0.6, 1)

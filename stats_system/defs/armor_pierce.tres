[gd_resource type="Resource" script_class="StatDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://stats_system/stat_def.gd" id="1_stat_def"]

[resource]
script = ExtResource("1_stat_def")
id = &"armor_pierce"
display_name = "Armor pierce"
description = "A pipeline the defender's final armor enters, never a number: its bins (−3, ×0.5, set to 0) transform the armor a hit meets, clamped at 0 and leaving armor at or below 0 untouched. Its own value is inert by contract; nothing reads it. Node-local: read off the attacking node."
value_type = 0
default_value = 0.0
tint_color = Color(0.72, 0.8, 0.92, 1)
local_grantable = true
modifier_name = "Enemy armor"
lower_is_better = true

[ext_resource type="Script" path="res://stats_system/stat_def.gd" id="1_stat_def"]

[resource]
script = ExtResource("1_stat_def")
id = &"dot_resistance"
display_name = "DoT Resistance"
description = "Family parent of Poison, Corruption, Curse and Wither Resistance (ADR 0029): a modifier here folds into each child's node-local read. Blindness Resistance is not a member. Its own number is meaningless and never read; only its bins reach the children."
value_type = 1
default_value = 0.0
tint_color = Color(0.72, 0.8, 0.92, 1)
modifier_name = "DoT Resistance"
local_grantable = true

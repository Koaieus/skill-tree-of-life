[gd_resource type="Resource" script_class="StatDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://stats_system/stat_def.gd" id="1_stat_def"]

[resource]
script = ExtResource("1_stat_def")
id = &"level"
display_name = "Level"
description = "Entity level. Starts at 1, +1 per XP-pool fill (Entity._on_xp_replenished). A formula-accessible stat so level-scaling modifiers can bind to it; base_value is written on level-up, modifiers may layer on top like any other stat."
value_type = 0
default_value = 1.0
tint_color = Color(0.8909, 0.7204, 0.2596, 1)

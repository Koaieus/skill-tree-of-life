[gd_resource type="Resource" script_class="StatDef" load_steps=3 format=3]

[ext_resource type="Script" path="res://stats_system/stat_def.gd" id="1_stat_def"]
[ext_resource type="Resource" path="res://identity/defs/curse.tres" id="identity_curse"]

[resource]
script = ExtResource("1_stat_def")
identity = ExtResource("identity_curse")
id = &"curse_resistance"
parent_ids = Array[StringName]([&"dot_resistance"])
display_name = "Curse Resistance"
description = "Fraction of incoming curse stacks this node shrugs off: stacks landed = per-hit x attacker's Curse Potency x (1 - Curse Resistance), resolved once at land (#963). Read node-locally like Armor, so a node-scoped modifier reaches it. Reduces stacks incurred, never the decay rate. Default 0."
value_type = 1
default_value = 0.0
modifier_name = "Curse Resistance"
local_grantable = true

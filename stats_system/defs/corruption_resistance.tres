[gd_resource type="Resource" script_class="StatDef" load_steps=3 format=3]

[ext_resource type="Script" path="res://stats_system/stat_def.gd" id="1_stat_def"]
[ext_resource type="Resource" path="res://identity/defs/corruption.tres" id="identity_corruption"]

[resource]
script = ExtResource("1_stat_def")
identity = ExtResource("identity_corruption")
id = &"corruption_resistance"
parent_ids = Array[StringName]([&"dot_resistance"])
display_name = "Corruption Resistance"
description = "Fraction of incoming corruption stacks this node shrugs off: stacks landed = per-hit x attacker's Corruption Potency x (1 - Corruption Resistance), resolved once at land (#963). Read node-locally like Armor, so a node-scoped modifier reaches it. Reduces stacks incurred, never the decay rate. Default 0."
value_type = 1
default_value = 0.0
modifier_name = "Corruption Resistance"
local_grantable = true

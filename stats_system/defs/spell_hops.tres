[resource]
script = ExtResource("1_stat_def")
id = &"spell_hops"
display_name = "Spell Hops"
description = "Flat integer bonus to a hop-ranged spell's reach (added to HopRangeFinder.max_hops). Default 0. Scales with INT via a threshold ladder — node-local, so an addon can grant it directly to a cast-from node (#171). Feeds HopRangeFinder only, never PropagationConfig.max_hops (#727)."
value_type = 0
default_value = 0.0
tint_color = Color(0.55, 0.65, 1.0, 1)

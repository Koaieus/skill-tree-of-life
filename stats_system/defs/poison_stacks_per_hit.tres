[gd_resource type="Resource" script_class="StatDef" load_steps=3 format=3]

[ext_resource type="Script" path="res://stats_system/stat_def.gd" id="1_stat_def"]
[ext_resource type="Resource" path="res://identity/defs/poison.tres" id="identity_poison"]

[resource]
script = ExtResource("1_stat_def")
identity = ExtResource("identity_poison")
id = &"poison_stacks_per_hit"
parent_ids = Array[StringName]([&"dot_stacks_per_hit"])
display_name = "Poison Stacks per Hit"
description = "Flat poison stacks added to every poison application this entity lands, a base_add overlay on the authored per-hit power: landed = fold(per-hit + Poison Stacks per Hit), never floored (ADR 0029); the target's Poison Resistance filters the row later, at effect time, never here (ADR 0031). DoT Stacks per Hit is its family parent and folds into this read — one number, never a separate sum. Flat, so it doubles a 0.5-stack dart and barely touches an 8-stack cast. Only boosts a poison application that already happens — never applies poison on its own. Default 0; read at the attacking node — an entity grant reaches every hit, a node-local grant only the hits that node lands."
value_type = 1
default_value = 0.0
modifier_name = "Poison Stacks per Hit"
local_grantable = true

[gd_resource type="Resource" script_class="StatDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://stats_system/stat_def.gd" id="1_stat_def"]

[resource]
script = ExtResource("1_stat_def")
id = &"damage"
display_name = "Damage"
description = "Family parent of Blade, Spell and Ranged Damage (ADR 0029): a modifier here folds into each child's own read — +20% Damage is +20% on every damage type, summed with the child's own increases before one floor. Its own number is meaningless and never read; only its bins reach the children, on the entity board and node-locally."
value_type = 1
default_value = 0.0
tint_color = Color(0.8, 0.75, 0.7, 1)
modifier_name = "Damage"
local_grantable = true

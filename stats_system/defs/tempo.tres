[gd_resource type="Resource" script_class="StandardPoolStatDef" format=3]

[ext_resource type="Script" uid="uid://curhuhdpmrd23" path="res://stats_system/standard_pool_stat_def.gd" id="1_std_pool_def"]

[resource]
script = ExtResource("1_std_pool_def")
on_cap_rise = 1
per_turn_mode = 1
id = &"tempo"
display_name = "Tempo"
description = "Once-per-turn kill-AP budget (#888). A HOSTILE killing blow spends 1 tempo to refund 1 action point; the cap IS the once-per-turn latch — a chain kill past the cap earns nothing more this turn. Default 1; resets each turn via StatBoard.apply_per_turn_upkeep (REFILL, same as action_points/deallocation_points/movement_points). Source-agnostic on purpose: future tempo sources (#887) drain the same pool."
default_value = 1.0
tint_color = Color(0.85, 0.35, 0.55, 1)
modifier_name = "Max Tempo / turn"

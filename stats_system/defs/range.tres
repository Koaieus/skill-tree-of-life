[ext_resource type="Script" uid="uid://0rq8abv83bkj" path="res://stats_system/stat_def.gd" id="1_stat_def"]

[resource]
script = ExtResource("1_stat_def")
id = &"range"
display_name = "Range"
description = "Ranged firing distance in scene pixels — distance from a leaf node to an enemy node it can fire on. Read per-leaf as a LocalStat, so node-level modifiers (sniper posts, scopes) extend reach on specific firing positions. Scales with DEX via an intrinsic formula modifier (+1% per DEX)."
default_value = 400.0
tint_color = Color(0.95, 0.55, 0.35, 1)

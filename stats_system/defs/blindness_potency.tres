[gd_resource type="Resource" script_class="StatDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://stats_system/stat_def.gd" id="1_stat_def"]

[resource]
script = ExtResource("1_stat_def")
id = &"blindness_potency"
display_name = "Blindness Potency"
description = "Multiplier on the blindness this entity's hits land: power = per-hit x Blindness Potency x (1 - target's Blindness Resistance), resolved once at land (#1089). Default 1.0."
value_type = 1
default_value = 1.0
tint_color = Color(0.55, 0.85, 0.45, 1)
modifier_name = "Blindness Potency"

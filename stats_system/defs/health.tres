[ext_resource type="Script" uid="uid://curhuhdpmrd23" path="res://stats_system/standard_pool_stat_def.gd" id="1_std_pool_def"]

[resource]
script = ExtResource("1_std_pool_def")
on_cap_rise = 1
per_turn_mode = 2
per_turn_stat_id = &"core_healing"
id = &"health"
display_name = "Health"
description = "Entity HP pool. Persistent — does not reset; the death clock. Depleted by arm-loss and core-shield overflow. Max is 10 + core_health_scaling x CON (D-21/D-26); regains core_healing per turn (D-25). on_cap_rise = FOLLOW is left ON deliberately: that is the D-21 ratchet — see PoolStat._follow_cap_delta."
default_value = 10.0
tint_color = Color(0.8878, 0.203, 0.2233, 1)
modifier_name = "Max Health"

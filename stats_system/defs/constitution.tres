[gd_resource type="Resource" script_class="StatDef" format=3 uid="uid://cj6e6uijkdjrc"]

[ext_resource type="Script" uid="uid://0rq8abv83bkj" path="res://stats_system/stat_def.gd" id="1_stat_def"]
[ext_resource type="Resource" path="res://identity/defs/constitution.tres" id="identity_constitution"]

[resource]
script = ExtResource("1_stat_def")
identity = ExtResource("identity_constitution")
id = &"constitution"
parent_ids = Array[StringName]([&"attributes"])
display_name = "Constitution"
description = "Defensive attribute (White/reserved). Buys max HP on the core and on every owned node: health = 100 + core_health_scaling x CON and node_health = 100 + node_health_scaling x CON, scalings 3 on the default board. Does not touch armor or min_damage_taken — those stay battlefield-found (D-11). Innate CON is 0, so a fresh lv1 entity reads the bare 100 HP base; level grants +1 CON/level from lv2 via mod_level_to_con (board intrinsic, so every entity scales regardless of core class), and rolls and addons add more. BalancedCore contributes a +10 base grant, NOT a per-level one. Formula tests that arrange their own node_health use TestBoards.flat_entity_board(), which zeroes this — content is an input, never the fixture."
abbrev = "CON"

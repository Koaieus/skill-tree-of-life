[ext_resource type="Script" uid="uid://0rq8abv83bkj" path="res://stats_system/stat_def.gd" id="1_stat_def"]

[resource]
script = ExtResource("1_stat_def")
id = &"constitution"
display_name = "Constitution"
description = "Defensive attribute (White/reserved). Scales node_health only, at +1 HP per point of CON. Does not touch armor or min_damage_taken — those stay battlefield-found (D-11). TBD (#268): the rate is the `value` coefficient on the board's mod_con_to_node_health, over a LinearFormula passthrough — tune it there, not in a formula string. Level grants +1 CON/level via mod_level_to_con (board intrinsic, so every entity scales regardless of core class); BalancedCore contributes the +10 base grant, NOT a per-level one. Board default 20 (owner tuning call 2026-09-20 — Ranged 2.0 made arrows numerous: a lv1 volley of 2 AP spent reloading is 12 arrows at 3 min damage, 36 HP floor, so node HP moved 24→44; earlier it was 0 so a bare board kept node_health at flat 10). BalancedCore still adds its +10 on top. Formula tests that arrange their own node_health use TestBoards.flat_entity_board(), which zeroes this — content is an input, never the fixture."
tint_color = Color(0.85882354, 0.9019608, 0.9490196, 1)
abbrev = "CON"

[gd_resource type="Resource" script_class="StatDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://stats_system/stat_def.gd" id="1_stat_def"]

[resource]
script = ExtResource("1_stat_def")
id = &"blade_speed_half"
display_name = "Blade Speed Half"
description = "v_half in the speed-scaled blade damage curve f(v) = 1 + (M-1) x v/(v+v_half) (#779): the per-vertex contact speed (scene px/s, sampled at the contact step off blade_sim.gd) at which half of blade_speed_multiplier_max's bonus is collected. Calibrated near a SHORT blade's apex speed (radius ~1 edge, default 1.2s sine-in-out swing puts the apex speed on the order of a few hundred px/s) so early melee already collects roughly half the bonus, while a 100+ member blade's much faster tip approaches the cap rather than running away. Owner-tunable starting point, not a tuning pass."
value_type = 1
default_value = 800.0
tint_color = Color(0.85, 0.3, 0.3, 1)

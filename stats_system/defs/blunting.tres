[gd_resource type="Resource" script_class="StatDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://stats_system/stat_def.gd" id="1_stat_def"]

[resource]
script = ExtResource("1_stat_def")
id = &"blunting"
display_name = "Blunting"
description = "Pop power of the attacking blade vertex against a defender's spikes (#778). Contact drains the defender's remaining spikes by this amount and pops the vertex only if the full amount was removed ('pop only if full amount is removed'); a lesser remainder just drains through, dealing damage. Base 1; SpikeRingAddon raises a spiked vertex to 2. Node-local addons add on top per-node via node_board, mirroring blade_damage. Crit interaction is explicitly out of scope here (separate Crits-milestone issue). Owner-tunable starting point, not a tuning pass."
value_type = 0
default_value = 1.0
tint_color = Color(0.85, 0.3, 0.3, 1)
